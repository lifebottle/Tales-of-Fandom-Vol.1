<SceneText>
  <FriendlyName>Conversation_0003</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x51b70</PointerOffset>
      <JapaneseText>クレスとの距離</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51b80</PointerOffset>
      <JapaneseText>バークライト家</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51b8f</PointerOffset>
      <JapaneseText>現在</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51b94</PointerOffset>
      <JapaneseText>……アミィ、起きてたのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51baf</PointerOffset>
      <JapaneseText>あ、お兄ちゃん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51bc0</PointerOffset>
      <JapaneseText>うん……もう寝るよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51bd5</PointerOffset>
      <JapaneseText>まだ作ってたのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51be8</PointerOffset>
      <JapaneseText>クレスの誕生日は明日だぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51c03</PointerOffset>
      <JapaneseText>間に合うのかよ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51c14</PointerOffset>
      <JapaneseText>大丈夫だよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51c21</PointerOffset>
      <JapaneseText>……お兄ちゃん、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51c32</PointerOffset>
      <JapaneseText>明日、クレスさんと狩りに行くんでしょ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51c59</PointerOffset>
      <JapaneseText>帰って来るまでには完成させるもん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51c7d</PointerOffset>
      <JapaneseText>もう、５年も経ったんだね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51c98</PointerOffset>
      <JapaneseText>あ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51c9d</PointerOffset>
      <JapaneseText>あたしとお兄ちゃんがトーティスに来て、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51cc4</PointerOffset>
      <JapaneseText>もう５年も経ったんだなーって。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51ce3</PointerOffset>
      <JapaneseText>なんだよ、急に。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51cf4</PointerOffset>
      <JapaneseText>大変だったけど、楽しかったなー、って。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51d1b</PointerOffset>
      <JapaneseText>……お兄ちゃんには苦労させられました。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51d42</PointerOffset>
      <JapaneseText>おいおい、母さんみたいな口利くなよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51d67</PointerOffset>
      <JapaneseText>ふふ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51d72</PointerOffset>
      <JapaneseText>ねえ、お兄ちゃん、あたしたち、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51d91</PointerOffset>
      <JapaneseText>ここで大人になっていくんだよね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51db2</PointerOffset>
      <JapaneseText>あたし、ここが大好き。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51dc9</PointerOffset>
      <JapaneseText>ユークリッドにはパパとママの思い出が</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51dee</PointerOffset>
      <JapaneseText>あるけど、この村の方が好き。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51e0b</PointerOffset>
      <JapaneseText>あたし、きっとここで結婚して、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51e2a</PointerOffset>
      <JapaneseText>たくさんの子供に囲まれて、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51e45</PointerOffset>
      <JapaneseText>それで、幸せなおばあちゃんになるの。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51e6a</PointerOffset>
      <JapaneseText>クレスとか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51e77</PointerOffset>
      <JapaneseText>や、やだ……そんなの、わかんないよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51e9c</PointerOffset>
      <JapaneseText>あ、でもお兄ちゃんは、きっとずーっと</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51ec1</PointerOffset>
      <JapaneseText>独身ね。素直さんじゃないから。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51ee0</PointerOffset>
      <JapaneseText>バーカ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51ee9</PointerOffset>
      <JapaneseText>兄ちゃんはな、これでももてるんだぜ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51f0e</PointerOffset>
      <JapaneseText>えー、嘘ばっかり。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51f21</PointerOffset>
      <JapaneseText>タマネギが食べられなーいなんて、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51f42</PointerOffset>
      <JapaneseText>子供みたいなこと言ってる人のところにくる</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51f6b</PointerOffset>
      <JapaneseText>お嫁さんなんかいませんよー。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51f88</PointerOffset>
      <JapaneseText>うるせえ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51f93</PointerOffset>
      <JapaneseText>お前！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51f9a</PointerOffset>
      <JapaneseText>早く寝ろ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51fa5</PointerOffset>
      <JapaneseText>やん！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51fad</PointerOffset>
      <JapaneseText>はっ、はっ、はっ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51fc4</PointerOffset>
      <JapaneseText>まったく……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51fd3</PointerOffset>
      <JapaneseText>ふふ……ねえ、お兄ちゃん、覚えてる？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x51ff8</PointerOffset>
      <JapaneseText>あたした</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
