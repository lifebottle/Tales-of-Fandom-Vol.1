  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x58f90</PointerOffset>
      <JapaneseText>クレスとの距離</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x58fa1</PointerOffset>
      <JapaneseText>トーティスの村</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x58fb0</PointerOffset>
      <JapaneseText>広場</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x58fb5</PointerOffset>
      <JapaneseText>ゴーリ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x58fbe</PointerOffset>
      <JapaneseText>やあ、アルベイン。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x58fd1</PointerOffset>
      <JapaneseText>あの子たちか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x58fe0</PointerOffset>
      <JapaneseText>バークライト夫妻の遺児というのは。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59003</PointerOffset>
      <JapaneseText>ああ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5900a</PointerOffset>
      <JapaneseText>あの夫妻が死んでから、ユークリッドで</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5902f</PointerOffset>
      <JapaneseText>二人きりで暮らしていたらしい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5904e</PointerOffset>
      <JapaneseText>実家が火事で焼け落ちたんだが、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5906d</PointerOffset>
      <JapaneseText>施設に預けるのもどうかと思ってな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59090</PointerOffset>
      <JapaneseText>バークライト夫妻の別荘に住まわせるのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x590b9</PointerOffset>
      <JapaneseText>夫妻が死んだ以上、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x590cd</PointerOffset>
      <JapaneseText>あの家は子供たちのものだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x590e8</PointerOffset>
      <JapaneseText>問題はなかろう？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x590f9</PointerOffset>
      <JapaneseText>それはそうだが……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5910e</PointerOffset>
      <JapaneseText>あの子達は、夫妻が死んでからいままで、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59135</PointerOffset>
      <JapaneseText>どうやって暮らしていたんだ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59152</PointerOffset>
      <JapaneseText>まあ……いろいろだろう。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5916b</PointerOffset>
      <JapaneseText>いろいろって、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5917a</PointerOffset>
      <JapaneseText>おい、まさか悪い連中と……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59197</PointerOffset>
      <JapaneseText>縁は切ったといっている。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x591b0</PointerOffset>
      <JapaneseText>わしは信じようと思うがな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x591cb</PointerOffset>
      <JapaneseText>「信じることから全ては始まる」</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x591ea</PointerOffset>
      <JapaneseText>……司祭様の教えだろう？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59203</PointerOffset>
      <JapaneseText>それはそうだが……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59218</PointerOffset>
      <JapaneseText>決まりだな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59225</PointerOffset>
      <JapaneseText>――二人とも、こっちにおいで！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59245</PointerOffset>
      <JapaneseText>さ、挨拶をしなさい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5925b</PointerOffset>
      <JapaneseText>元気よく挨拶する</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5926d</PointerOffset>
      <JapaneseText>おとなしく挨拶する</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59281</PointerOffset>
      <JapaneseText>おしゃまに挨拶する</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59295</PointerOffset>
      <JapaneseText>黙っている</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x592a1</PointerOffset>
      <JapaneseText>アミィ・バークライトです！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x592bc</PointerOffset>
      <JapaneseText>今日からお世話になります！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x592d7</PointerOffset>
      <JapaneseText>お兄ちゃんともども、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x592ec</PointerOffset>
      <JapaneseText>どうかよろしくお願いいたします！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5930e</PointerOffset>
      <JapaneseText>よいしょ……　ちょっと、ちょっと。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59331</PointerOffset>
      <JapaneseText>通し、て……っ！　ふう。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5934a</PointerOffset>
      <JapaneseText>えへっ……ようこそ、トーティス村へ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5936f</PointerOffset>
      <JapaneseText>僕、クレス・アルベイン！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59388</PointerOffset>
      <JapaneseText>君がチェスターだよね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5939f</PointerOffset>
      <JapaneseText>同じくらいの年の子が来るって聞いて、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x593c4</PointerOffset>
      <JapaneseText>僕、楽しみにしてたんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x593dd</PointerOffset>
      <JapaneseText>……けっ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x593e8</PointerOffset>
      <JapaneseText>……お兄ちゃんっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x593fb</PointerOffset>
      <JapaneseText>――ごめんなさい、アルベインさん！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5941e</PointerOffset>
      <JapaneseText>お兄ちゃんたら、いつもこうで……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59441</PointerOffset>
      <JapaneseText>クレス、でいいよ、アミィちゃん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59462</PointerOffset>
      <JapaneseText>お兄さんは、きっと内気なんだね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>50</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59483</PointerOffset>
      <JapaneseText>ええ、まあ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>51</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59495</PointerOffset>
      <JapaneseText>よーし！　みんな！　今日から二人は</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>52</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x594b8</PointerOffset>
      <JapaneseText>新しくこの村の住民となった！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>53</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x594d5</PointerOffset>
      <JapaneseText>互いに助け合い、より良い村にしていこう！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>54</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x594fe</PointerOffset>
      <JapaneseText>では、解散！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>55</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5950c</PointerOffset>
      <JapaneseText>さあ、おまえたち、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>56</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5951f</PointerOffset>
      <JapaneseText>家に案内してやろう。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>57</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59534</PointerOffset>
      <JapaneseText>寝るぐらいは出来るように</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>58</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5954d</PointerOffset>
      <JapaneseText>掃除をしたほうがいい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>59</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59565</PointerOffset>
      <JapaneseText>アミィ・バークライトです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>60</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59580</PointerOffset>
      <JapaneseText>お兄ちゃんともども、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>61</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59595</PointerOffset>
      <JapaneseText>よろしくお願いします。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>62</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x595ad</PointerOffset>
      <JapaneseText>この村には、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>63</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x595ba</PointerOffset>
      <JapaneseText>おまえたちと同じ年頃の子供もいる。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>64</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x595dd</PointerOffset>
      <JapaneseText>すぐに仲良くなれるだろうて。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>65</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x595fa</PointerOffset>
      <JapaneseText>――クレス！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>66</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59607</PointerOffset>
      <JapaneseText>はい！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>67</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5960f</PointerOffset>
      <JapaneseText>この子はクレス・アルベイン。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>68</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5962c</PointerOffset>
      <JapaneseText>チェスター、おまえと同じ十二歳だよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>69</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59651</PointerOffset>
      <JapaneseText>挨拶をしなさい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>70</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59662</PointerOffset>
      <JapaneseText>……けっ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>71</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5966d</PointerOffset>
      <JapaneseText>これ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>72</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59674</PointerOffset>
      <JapaneseText>いいですよ、ゴーリさん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>73</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5968d</PointerOffset>
      <JapaneseText>きっと、内気なんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>74</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x596a2</PointerOffset>
      <JapaneseText>言ってろ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>75</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x596ae</PointerOffset>
      <JapaneseText>よーし！　みんな！　今日から二人は</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>76</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x596d1</PointerOffset>
      <JapaneseText>新しくこの村の住民となった！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>77</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x596ee</PointerOffset>
      <JapaneseText>互いに助け合い、より良い村にしていこう！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>78</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59717</PointerOffset>
      <JapaneseText>では、解散！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>79</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59725</PointerOffset>
      <JapaneseText>さあ、おまえたち、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>80</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59738</PointerOffset>
      <JapaneseText>家に案内してやろう。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>81</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5974d</PointerOffset>
      <JapaneseText>寝るぐらいは出来るように</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>82</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59766</PointerOffset>
      <JapaneseText>掃除をしたほうがいい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>83</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5977e</PointerOffset>
      <JapaneseText>アミィ・バークライトです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>84</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59799</PointerOffset>
      <JapaneseText>あたしもお兄ちゃんも、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>85</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x597b0</PointerOffset>
      <JapaneseText>都会暮らしが長かったから、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>86</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x597cb</PointerOffset>
      <JapaneseText>田舎に溶け込めるか心配です。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>87</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x597e9</PointerOffset>
      <JapaneseText>よーし！　みんな！　今日から二人は</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>88</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5980c</PointerOffset>
      <JapaneseText>新しくこの村の住民となった！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>89</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59829</PointerOffset>
      <JapaneseText>互いに助け合い、より良い村にしていこう！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>90</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
