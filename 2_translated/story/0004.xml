    <Entry>
      <PointerOffset>0x598b9</PointerOffset>
      <JapaneseText>あー……少し緊張しているようだな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>96</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x598dc</PointerOffset>
      <JapaneseText>まあ、おいおい分かり合えるだろうて。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>97</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59902</PointerOffset>
      <JapaneseText>よーし！　みんな！　今日から二人は</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>98</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59925</PointerOffset>
      <JapaneseText>新しくこの村の住民となった！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>99</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59942</PointerOffset>
      <JapaneseText>互いに助け合い、より良い村にしていこう！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>100</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5996b</PointerOffset>
      <JapaneseText>では、解散！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>101</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x59979</PointerOffset>
      <JapaneseText>さあ、おまえたち、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>102</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5998c</PointerOffset>
      <JapaneseText>家に案内してやろう。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>103</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x599a1</PointerOffset>
      <JapaneseText>寝るぐらいは出来るように</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>104</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x599ba</PointerOffset>
      <JapaneseText>掃除をしたほうがいい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>105</Id>
      <Status>To Do</Status>
