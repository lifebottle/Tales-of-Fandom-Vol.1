<SceneText>
  <FriendlyName>Conversation_0007</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x5fe30</PointerOffset>
      <JapaneseText>クレスとの距離</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5fe40</PointerOffset>
      <JapaneseText>バークライト家</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5fe4f</PointerOffset>
      <JapaneseText>現在</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5fe54</PointerOffset>
      <JapaneseText>お断りだね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5fe61</PointerOffset>
      <JapaneseText>おい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5fe68</PointerOffset>
      <JapaneseText>ふふっ……あの頃のお兄ちゃんって、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5fe8b</PointerOffset>
      <JapaneseText>本当、頑固だったよね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5fea2</PointerOffset>
      <JapaneseText>そうか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5feab</PointerOffset>
      <JapaneseText>そうよ。おかげで</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5febc</PointerOffset>
      <JapaneseText>あたしがいろいろ言われたんだから。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5fedf</PointerOffset>
      <JapaneseText>お兄ちゃん、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5feec</PointerOffset>
      <JapaneseText>いっつも村にいないんだもん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5ff09</PointerOffset>
      <JapaneseText>だから、あたしが一人で畑手伝って、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5ff2c</PointerOffset>
      <JapaneseText>教会の奉仕活動もやって、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5ff45</PointerOffset>
      <JapaneseText>お裁縫も習って……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5ff5a</PointerOffset>
      <JapaneseText>おいおい、しょうがないだろ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5ff77</PointerOffset>
      <JapaneseText>俺はゴーリ親爺の狩猟隊に</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5ff90</PointerOffset>
      <JapaneseText>参加してたんだからよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5ffa7</PointerOffset>
      <JapaneseText>ふふ……わかってる。冗談よ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5ffc5</PointerOffset>
      <JapaneseText>……でもな、悪かったとは思ってるんだぜ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5ffee</PointerOffset>
      <JapaneseText>お兄ちゃん？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x5fffb</PointerOffset>
      <JapaneseText>本当なら、村のガキどもと、もっと</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x6001c</PointerOffset>
      <JapaneseText>遊ばせてやりたかったんだけどな……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x60041</PointerOffset>
      <JapaneseText>や、やだな、冗談だっていったでしょ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x60066</PointerOffset>
      <JapaneseText>お兄ちゃんが、大人の人たちに混じって</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x6008b</PointerOffset>
      <JapaneseText>頑張ってくれてたの、あたし知ってるもん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x600b4</PointerOffset>
      <JapaneseText>……それに、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x600c1</PointerOffset>
      <JapaneseText>クレスさんがよく声をかけてくれたし。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x600e6</PointerOffset>
      <JapaneseText>クレス、か……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x600f7</PointerOffset>
      <JapaneseText>うん。あたし、今でも覚えてるよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x60118</PointerOffset>
      <JapaneseText>お兄ちゃんとクレスさんが、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x60133</PointerOffset>
      <JapaneseText>広場で鉢合わせした日のこと。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x60150</PointerOffset>
      <JapaneseText>ああ、俺も覚えてる。懐かしいぜ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
