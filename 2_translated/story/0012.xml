<SceneText>
  <FriendlyName>Conversation_0012</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x7b8d8</PointerOffset>
      <JapaneseText>クレスとの距離</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7b8e8</PointerOffset>
      <JapaneseText>教会</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7b8ed</PointerOffset>
      <JapaneseText>アミィちゃん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7b8fc</PointerOffset>
      <JapaneseText>キルト作り、だいぶ慣れてきたみたいね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7b923</PointerOffset>
      <JapaneseText>はい！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7b92a</PointerOffset>
      <JapaneseText>ありがとうございます！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7b941</PointerOffset>
      <JapaneseText>本当にいい子だよねえ、アミィちゃんは。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7b968</PointerOffset>
      <JapaneseText>うちの娘にも、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7b977</PointerOffset>
      <JapaneseText>参加するように言ってるんだけどねえ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7b9a0</PointerOffset>
      <JapaneseText>ちっとも聞きやしないよ。キルト作りは、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7b9c7</PointerOffset>
      <JapaneseText>村の女たちの重要な行事だってのに……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7b9ee</PointerOffset>
      <JapaneseText>あぁ、もぅ、わかってないんだよねえ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7ba13</PointerOffset>
      <JapaneseText>料理も裁縫も出来なくて、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7ba2c</PointerOffset>
      <JapaneseText>誰が嫁に貰ってくれるっていうんだか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7ba51</PointerOffset>
      <JapaneseText>あたしが二十歳の頃には、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7ba6a</PointerOffset>
      <JapaneseText>二人目の子供がお腹にいたもんさ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7ba8b</PointerOffset>
      <JapaneseText>うちの息子だって困ったもんさね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7baac</PointerOffset>
      <JapaneseText>ゴーリさんとこの狩猟隊に参加でもして、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bad3</PointerOffset>
      <JapaneseText>少しは腕を磨くとかすりゃあいいのにさ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bafa</PointerOffset>
      <JapaneseText>そういえば、また大猟だったらしいね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bb1f</PointerOffset>
      <JapaneseText>お兄さん、帰ってきてるんだろ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bb3e</PointerOffset>
      <JapaneseText>はい。今日は、家で体を休めてます。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bb61</PointerOffset>
      <JapaneseText>あんたの兄さんも、あれで、もう少し愛想が</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bb8a</PointerOffset>
      <JapaneseText>よければいいと思うんだけどねえ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bbaf</PointerOffset>
      <JapaneseText>すいません。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bbbc</PointerOffset>
      <JapaneseText>気にすることはないよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bbd3</PointerOffset>
      <JapaneseText>あんたのせいじゃないんだから。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bbf2</PointerOffset>
      <JapaneseText>……それより、どうだい？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bc0b</PointerOffset>
      <JapaneseText>将来、うちの息子の嫁にならないかね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bc30</PointerOffset>
      <JapaneseText>あんたなら、うちは大歓迎だよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bc4f</PointerOffset>
      <JapaneseText>え！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bc56</PointerOffset>
      <JapaneseText>だめだめ。アミィちゃんには、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bc73</PointerOffset>
      <JapaneseText>気になる人がいるんだから。ね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bc92</PointerOffset>
      <JapaneseText>そ、そんな、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bc9f</PointerOffset>
      <JapaneseText>あたし――</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bcab</PointerOffset>
      <JapaneseText>あらまあ、照れてるよ、この子。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bcca</PointerOffset>
      <JapaneseText>……小さくても、女だねえ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bce5</PointerOffset>
      <JapaneseText>それで、どこの誰だい？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bcfc</PointerOffset>
      <JapaneseText>この村の男かい？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bd0d</PointerOffset>
      <JapaneseText>それとも、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bd18</PointerOffset>
      <JapaneseText>ユークリッドの垢抜けした連中かい？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bd3b</PointerOffset>
      <JapaneseText>う、嘘ですっ！　そんな人、いません！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bd60</PointerOffset>
      <JapaneseText>バークライトさんのところの息子さんよね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bd89</PointerOffset>
      <JapaneseText>クレス君？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bd94</PointerOffset>
      <JapaneseText>そうなの、アミィちゃん？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bdae</PointerOffset>
      <JapaneseText>いい人だと思う、という</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bdc6</PointerOffset>
      <JapaneseText>さりげなく話題を変える</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bdde</PointerOffset>
      <JapaneseText>お兄ちゃんが一番、という</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bdf8</PointerOffset>
      <JapaneseText>い、いい人だとは思います！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7be13</PointerOffset>
      <JapaneseText>で、でも、好きとかそういうんじゃなくて、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7be3c</PointerOffset>
      <JapaneseText>その、あの――</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>50</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7be4c</PointerOffset>
      <JapaneseText>わかってるわかってる。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>51</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7be63</PointerOffset>
      <JapaneseText>ハア、それにしても、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>52</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7be78</PointerOffset>
      <JapaneseText>こんないい子に想われてるっていうのに、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>53</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7be9f</PointerOffset>
      <JapaneseText>何であの子はあんな娘がいいんだかねえ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>54</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bec6</PointerOffset>
      <JapaneseText>まったくだよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>55</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bed5</PointerOffset>
      <JapaneseText>ユークリッドの金持ちだかなんだか</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>56</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bef6</PointerOffset>
      <JapaneseText>知らないけど、あたしゃ、気に入らないね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>57</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bf1f</PointerOffset>
      <JapaneseText>あっ、ちょっと！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>58</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bf30</PointerOffset>
      <JapaneseText>……あ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>59</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bf3a</PointerOffset>
      <JapaneseText>あ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>60</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bf3f</PointerOffset>
      <JapaneseText>あたし、帰ってお兄ちゃんのお茶の</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>61</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bf60</PointerOffset>
      <JapaneseText>用意しなきゃ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>62</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bf6f</PointerOffset>
      <JapaneseText>そ、それじゃ、失礼しますっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>63</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bf8c</PointerOffset>
      <JapaneseText>あ、ちょっと――</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>64</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bf9f</PointerOffset>
      <JapaneseText>ちょっと、からかいがすぎたかねえ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>65</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bfc2</PointerOffset>
      <JapaneseText>や、やだなあ……そんなことないですよー。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>66</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7bfeb</PointerOffset>
      <JapaneseText>――あ！　大変です、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>67</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7c000</PointerOffset>
      <JapaneseText>ここ、縫い目がひとつずれてます！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>68</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7c021</PointerOffset>
      <JapaneseText>え！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>69</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7c028</PointerOffset>
      <JapaneseText>どこどこ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>70</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7c034</PointerOffset>
      <JapaneseText>あ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>71</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7c039</PointerOffset>
      <JapaneseText>あたし、帰ってお兄ちゃんのお茶の</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>72</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7c05a</PointerOffset>
      <JapaneseText>用意しなきゃ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>73</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7c069</PointerOffset>
      <JapaneseText>そ、それじゃ、失礼しますっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>74</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7c086</PointerOffset>
      <JapaneseText>あ、ちょっと――</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>75</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7c099</PointerOffset>
      <JapaneseText>ちょっと、からかいがすぎたかねえ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>76</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7c0bc</PointerOffset>
      <JapaneseText>ク、クレスさんですか？　違いますよぉ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>77</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7c0e3</PointerOffset>
      <JapaneseText>あたし、何の苦労も知らないで大きくなった</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>78</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7c10c</PointerOffset>
      <JapaneseText>人って嫌いですから。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>79</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7c121</PointerOffset>
      <JapaneseText>そういう人って、きっとあたしのこと判って</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>80</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7c14a</PointerOffset>
      <JapaneseText>くれないと思うんです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>81</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7c161</PointerOffset>
      <JapaneseText>今は……やっぱり、お兄ちゃんが一番です。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>82</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x7c18a</PointerOffset>
      <JapaneseText>あ、あら……そうなんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>83</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
