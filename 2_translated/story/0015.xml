<SceneText>
  <FriendlyName>Conversation_0015</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x8ae48</PointerOffset>
      <JapaneseText>クレスとの距離</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8ae58</PointerOffset>
      <JapaneseText>バークライト家</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8ae67</PointerOffset>
      <JapaneseText>どうしたんだよ、アミィ。元気ねえな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8ae8c</PointerOffset>
      <JapaneseText>ババア連中になんか言われたのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8aead</PointerOffset>
      <JapaneseText>……ううん、そうじゃないよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8aeca</PointerOffset>
      <JapaneseText>じゃあ、なんだよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8aede</PointerOffset>
      <JapaneseText>クレスたちのことを正直に話す</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8aefc</PointerOffset>
      <JapaneseText>クレスたちのことを例え話にする</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8af1c</PointerOffset>
      <JapaneseText>黙っている</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8af28</PointerOffset>
      <JapaneseText>お兄ちゃん、「アニマーゴ」ってお店、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8af4d</PointerOffset>
      <JapaneseText>知ってる？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8af58</PointerOffset>
      <JapaneseText>ちぇっ、そういうことかよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8af73</PointerOffset>
      <JapaneseText>なにが？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8af7c</PointerOffset>
      <JapaneseText>なんでもねえよ。「アニマーゴ」だろ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8afa1</PointerOffset>
      <JapaneseText>知ってるぜ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8afae</PointerOffset>
      <JapaneseText>イライザの奴、来てるだろ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8afc9</PointerOffset>
      <JapaneseText>昼間、会ったぜ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8afda</PointerOffset>
      <JapaneseText>お兄ちゃん、イライザさんのこと</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8aff9</PointerOffset>
      <JapaneseText>知ってるの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b006</PointerOffset>
      <JapaneseText>まあな。おまえも、二・三度会ったことが</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b02d</PointerOffset>
      <JapaneseText>あるはずだぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b03c</PointerOffset>
      <JapaneseText>前は、俺とつるんでたからな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b059</PointerOffset>
      <JapaneseText>それで……見覚えがあったんだ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b07d</PointerOffset>
      <JapaneseText>……はっ！　クレスも馬鹿な奴だよな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b0a2</PointerOffset>
      <JapaneseText>遊ばれてることに気付かねえんだからよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b0c9</PointerOffset>
      <JapaneseText>え？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b0ce</PointerOffset>
      <JapaneseText>……二人のこと、知ってるの、お兄ちゃん？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b0f7</PointerOffset>
      <JapaneseText>この村の連中でしらねえやつはいねえ、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b11c</PointerOffset>
      <JapaneseText>とさ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b123</PointerOffset>
      <JapaneseText>狩猟隊の奴がご親切に教えてくれたぜ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b148</PointerOffset>
      <JapaneseText>もっとも……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b157</PointerOffset>
      <JapaneseText>イライザがユークリッドの鍛冶屋の、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b17a</PointerOffset>
      <JapaneseText>何とかいう奴と婚約してることは、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b19b</PointerOffset>
      <JapaneseText>しらねえみたいだがな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b1b2</PointerOffset>
      <JapaneseText>で、でも、イライザさんからクレスさんに</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b1d9</PointerOffset>
      <JapaneseText>告白したって――</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b1eb</PointerOffset>
      <JapaneseText>本気じゃねえだろ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b1fe</PointerOffset>
      <JapaneseText>イライザにしてみりゃ、避暑地での</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b21f</PointerOffset>
      <JapaneseText>アバンチュール、ってとこじゃねえのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b246</PointerOffset>
      <JapaneseText>そんな……クレスさん、かわいそう……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b26d</PointerOffset>
      <JapaneseText>ばーか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b276</PointerOffset>
      <JapaneseText>本気になったクレスが馬鹿なんだよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b299</PointerOffset>
      <JapaneseText>しょせん田舎者――</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b2ad</PointerOffset>
      <JapaneseText>いてえっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b2b8</PointerOffset>
      <JapaneseText>お兄ちゃんのバカっ！　お兄ちゃんだって、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b2e1</PointerOffset>
      <JapaneseText>すっかり田舎者じゃない！　ばかばか！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b307</PointerOffset>
      <JapaneseText>ちぇっ……なんだよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b31c</PointerOffset>
      <JapaneseText>……ねえ、お兄ちゃん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b333</PointerOffset>
      <JapaneseText>恋人同士がいてさ、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b346</PointerOffset>
      <JapaneseText>男の人が、湖に行こう、って誘っても、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b36b</PointerOffset>
      <JapaneseText>森に行こう、って誘っても、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>50</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b386</PointerOffset>
      <JapaneseText>女の人が、イヤだっていって、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>51</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b3a4</PointerOffset>
      <JapaneseText>先に帰っちゃうっていうような仲って……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>52</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b3cd</PointerOffset>
      <JapaneseText>どう思う？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>53</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b3d8</PointerOffset>
      <JapaneseText>ずいぶん具体的だな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>54</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b3ed</PointerOffset>
      <JapaneseText>誰のことだよ、それ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>55</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b402</PointerOffset>
      <JapaneseText>ま、まさか、アミィ、おまえ――</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>56</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b422</PointerOffset>
      <JapaneseText>ちがうよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>57</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b42d</PointerOffset>
      <JapaneseText>いっぱんろんです！　いっぱんろん！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>58</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b450</PointerOffset>
      <JapaneseText>そ、そうか……ふう、驚かせるなよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>59</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b473</PointerOffset>
      <JapaneseText>もう……それで、どう思う？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>60</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b48e</PointerOffset>
      <JapaneseText>――ま、破局間近、ってとこだな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>61</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b4af</PointerOffset>
      <JapaneseText>その男、近いうちに振られるぜ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>62</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b4ce</PointerOffset>
      <JapaneseText>クレスさん、かわいそう……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>63</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b4eb</PointerOffset>
      <JapaneseText>あ？　クレス？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>64</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b4fa</PointerOffset>
      <JapaneseText>なんでもない！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>65</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b50a</PointerOffset>
      <JapaneseText>ちぇっ……なんだよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>66</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b51f</PointerOffset>
      <JapaneseText>……なんでもない。ごちそうさま。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>67</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b541</PointerOffset>
      <JapaneseText>おい、ぜんぜん減ってねえじゃんか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>68</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x8b564</PointerOffset>
      <JapaneseText>もういいの！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>69</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
