<SceneText>
  <FriendlyName>Conversation_0044</FriendlyName>
  <Title>兄妹の警戒心</Title>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <PointerOffset>0xf5578</PointerOffset>
      <JapaneseText>兄妹の警戒心</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5589</PointerOffset>
      <JapaneseText>今のところ、特に異常はありませんね。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf55ae</PointerOffset>
      <JapaneseText>人が入り込んだ形跡はありますが、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf55cf</PointerOffset>
      <JapaneseText>ゴーリのところの狩猟隊が２日前まで</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf55f2</PointerOffset>
      <JapaneseText>いましたから、なんとも……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf560f</PointerOffset>
      <JapaneseText>うん。もう少し、奥まで行ってみようよ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5636</PointerOffset>
      <JapaneseText>まだ時間あるよね？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5649</PointerOffset>
      <JapaneseText>日暮れまでに村に戻るには、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5664</PointerOffset>
      <JapaneseText>あと１５分くらいしか先に進めませんよ？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf568b</PointerOffset>
      <JapaneseText>それでもいいよ。とりあえずいけるところ</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf56b2</PointerOffset>
      <JapaneseText>までいこう。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf56bf</PointerOffset>
      <JapaneseText>わかりました。おい、みんな</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf56da</PointerOffset>
      <JapaneseText>はっ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf56e2</PointerOffset>
      <JapaneseText>チェスター？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf56ef</PointerOffset>
      <JapaneseText>クレス！？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf56fa</PointerOffset>
      <JapaneseText>こんなところで会うなんて、偶然だね！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf571f</PointerOffset>
      <JapaneseText>狩りかい？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf572a</PointerOffset>
      <JapaneseText>……別に。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5735</PointerOffset>
      <JapaneseText>そうだ！　僕たち、森に入り込んだらしい</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf575c</PointerOffset>
      <JapaneseText>怪しい連中を探してるんだけど、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf577b</PointerOffset>
      <JapaneseText>君、奥から来たんだよね？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5794</PointerOffset>
      <JapaneseText>おかしな人たちとか見なかった？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf57b3</PointerOffset>
      <JapaneseText>見たぜ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf57bc</PointerOffset>
      <JapaneseText>本当！？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf57c5</PointerOffset>
      <JapaneseText>ああ。いま、俺の目の前にいるぜ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf57e6</PointerOffset>
      <JapaneseText>ボアやアウルしかいねえのに、重装備で森を</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf580f</PointerOffset>
      <JapaneseText>うろうろ歩き回るおかしな連中がな！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5832</PointerOffset>
      <JapaneseText>なんだと貴様っ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5843</PointerOffset>
      <JapaneseText>ちょ、ちょっと待って！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf585a</PointerOffset>
      <JapaneseText>ねえ、チェスター。冗談は置いといて、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf587f</PointerOffset>
      <JapaneseText>本当に、誰か見なかった？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5898</PointerOffset>
      <JapaneseText>……見てねえよ。俺が会ったのは、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf58b9</PointerOffset>
      <JapaneseText>ボアの親子だけだ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf58cd</PointerOffset>
      <JapaneseText>チェスターを信じる</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf58e1</PointerOffset>
      <JapaneseText>信じない</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf58eb</PointerOffset>
      <JapaneseText>そっか、わかった！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf58fe</PointerOffset>
      <JapaneseText>――みんな、今日はここまでにして帰ろう。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5927</PointerOffset>
      <JapaneseText>坊ちゃん、こいつの言う事を信じるん</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf594a</PointerOffset>
      <JapaneseText>ですか？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5953</PointerOffset>
      <JapaneseText>言っちゃなんだが、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5966</PointerOffset>
      <JapaneseText>こいつは信用なりませんよ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5981</PointerOffset>
      <JapaneseText>ゴーリ親爺のとこの狩猟隊を辞めた奴が</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf59a6</PointerOffset>
      <JapaneseText>いってましたよ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf59b7</PointerOffset>
      <JapaneseText>何を考えてるのかわからねえガキだ、って！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf59e0</PointerOffset>
      <JapaneseText>ユークリッドで、どんな悪さをして生きて</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5a07</PointerOffset>
      <JapaneseText>きたんだか、知れたもんじゃない！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5a28</PointerOffset>
      <JapaneseText>でも、ゴーリさんは喜んでるよ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5a47</PointerOffset>
      <JapaneseText>チェスターが入って、獲物が増えたって。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5a6e</PointerOffset>
      <JapaneseText>それに、そのやめた人って、仲間の人の</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5a93</PointerOffset>
      <JapaneseText>指輪か何かを盗んだからでしょ？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5ab2</PointerOffset>
      <JapaneseText>それはそうですが……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>50</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5ac9</PointerOffset>
      <JapaneseText>僕は、チェスターを信じるよ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>51</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5ae6</PointerOffset>
      <JapaneseText>アミィちゃんを見ればわかるじゃないか。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>52</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5b0d</PointerOffset>
      <JapaneseText>あんないい子の兄さんだよ？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>53</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5b28</PointerOffset>
      <JapaneseText>しかし……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>54</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5b35</PointerOffset>
      <JapaneseText>父さんには、僕から報告するから。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>55</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5b56</PointerOffset>
      <JapaneseText>……おまえ、人がよすぎるぜ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>56</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5b73</PointerOffset>
      <JapaneseText>よく言われる。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>57</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5b82</PointerOffset>
      <JapaneseText>でも、信じてもらいたかったら、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>58</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5ba1</PointerOffset>
      <JapaneseText>まず、信じなきゃ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>59</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5bb4</PointerOffset>
      <JapaneseText>俺に説教かよ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>60</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5bc3</PointerOffset>
      <JapaneseText>そんなつもりないよ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>61</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5bd8</PointerOffset>
      <JapaneseText>僕は、そうしてる、ってだけさ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>62</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5bf7</PointerOffset>
      <JapaneseText>――さ、みんな、帰ろう。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>63</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5c10</PointerOffset>
      <JapaneseText>お腹空いちゃったよ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>64</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5c26</PointerOffset>
      <JapaneseText>じゃあね、チェスター。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>65</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5c3d</PointerOffset>
      <JapaneseText>……ちっ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>66</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5c49</PointerOffset>
      <JapaneseText>……みんな、先に進もう。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>67</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5c62</PointerOffset>
      <JapaneseText>待てよ！　誰もいなかったって</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>68</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5c7f</PointerOffset>
      <JapaneseText>言ってんだろ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>69</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5c8e</PointerOffset>
      <JapaneseText>俺の言うことが信用できねえってのかよ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>70</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5cb5</PointerOffset>
      <JapaneseText>これは村の重大事だから、悪いけど、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>71</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5cd8</PointerOffset>
      <JapaneseText>よく知らない君の言葉をそのまま信用する</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>72</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5cff</PointerOffset>
      <JapaneseText>わけには行かないんだ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>73</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5d16</PointerOffset>
      <JapaneseText>おい、おまえも来い。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>74</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5d2b</PointerOffset>
      <JapaneseText>……来れるはずだよな。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>75</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5d42</PointerOffset>
      <JapaneseText>お前も、村の一員なんだろ？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>76</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5d5d</PointerOffset>
      <JapaneseText>協力する義務があるよな。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>77</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5d77</PointerOffset>
      <JapaneseText>おい、離せ！　離せよ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>78</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5d8e</PointerOffset>
      <JapaneseText>さあ、行こうぜ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>79</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xf5d9f</PointerOffset>
      <JapaneseText>……出発！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>80</Id>
      <Status>To Do</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
