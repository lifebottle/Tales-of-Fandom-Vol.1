<SceneText>
  <FriendlyName>Conversation_0046</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0xfba08</PointerOffset>
      <JapaneseText>兄妹の警戒心</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfba16</PointerOffset>
      <JapaneseText>トーティスの村</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfba25</PointerOffset>
      <JapaneseText>外れ</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfba2a</PointerOffset>
      <JapaneseText>ん、んー……静かな夜だなあ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfba4b</PointerOffset>
      <JapaneseText>あれ、クレスちゃん、こんな遅くに</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfba6c</PointerOffset>
      <JapaneseText>なんだね、その物々しい格好は？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfba8b</PointerOffset>
      <JapaneseText>あ、こんばんは。夜の見回りです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfbaac</PointerOffset>
      <JapaneseText>あんたみたいに、小さい子が？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfbac9</PointerOffset>
      <JapaneseText>やだなあ、僕だってもう１２ですよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfbaec</PointerOffset>
      <JapaneseText>一人前……とは言えないけど、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfbb09</PointerOffset>
      <JapaneseText>半人前以上にはなってるんですから。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfbb2c</PointerOffset>
      <JapaneseText>それに、父さんの許可も取ってあります。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfbb53</PointerOffset>
      <JapaneseText>そうかい？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfbb5e</PointerOffset>
      <JapaneseText>ならいいけど……気をつけなよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfbb7d</PointerOffset>
      <JapaneseText>はい。おばさんも、気をつけて帰って</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfbba0</PointerOffset>
      <JapaneseText>くださいね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfbbad</PointerOffset>
      <JapaneseText>はいよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfbbb7</PointerOffset>
      <JapaneseText>やっぱり、まだまだ頼りなく</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfbbd2</PointerOffset>
      <JapaneseText>見えるのかな……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfbbe6</PointerOffset>
      <JapaneseText>あれ？　……チェスター？　こんな夜に、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfbc0d</PointerOffset>
      <JapaneseText>塀を乗り越えて、どこに行くんだ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0xfbc2f</PointerOffset>
      <JapaneseText>よし、つけてみよう。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
