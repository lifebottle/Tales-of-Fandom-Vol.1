<SceneText>
  <FriendlyName>Conversation_0060</FriendlyName>
  <Title>兄妹の警戒心</Title>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <PointerOffset>0x139f38</PointerOffset>
      <JapaneseText>兄妹の警戒心</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x139f46</PointerOffset>
      <JapaneseText>『これは……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x139f55</PointerOffset>
      <JapaneseText>やめろ……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x139f63</PointerOffset>
      <JapaneseText>こんなのは見たくない……』</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x139f7e</PointerOffset>
      <JapaneseText>『ぐっ、なんてことを！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x139f95</PointerOffset>
      <JapaneseText>こんな子供まで殺すことはないだろう！』</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x139fbc</PointerOffset>
      <JapaneseText>『皆殺しにしろ、とのマルス隊長の</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x139fdd</PointerOffset>
      <JapaneseText>ご命令だ！　逆らうのか！』</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x139ff9</PointerOffset>
      <JapaneseText>お人形……クレスさん、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x13a010</PointerOffset>
      <JapaneseText>喜んでくれるかなあ……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x13a029</PointerOffset>
      <JapaneseText>くそっ！……これのどこが盗賊の村なんだ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x13a052</PointerOffset>
      <JapaneseText>何もないじゃないか！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x13a067</PointerOffset>
      <JapaneseText>おい、撤退だ！　急げ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x13a07e</PointerOffset>
      <JapaneseText>いくぞ！　そんなガキは捨て置け！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x13a09f</PointerOffset>
      <JapaneseText>くっ……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x13a0ab</PointerOffset>
      <JapaneseText>喜んでくれるよね……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x13a0c2</PointerOffset>
      <JapaneseText>お兄ちゃんも、そう……思うでしょ……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x13a0ea</PointerOffset>
      <JapaneseText>なんか……寒いな……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x13a101</PointerOffset>
      <JapaneseText>お兄ちゃんも……クレスさんも……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x13a124</PointerOffset>
      <JapaneseText>風邪……ひかないと……いい……な……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x13a14b</PointerOffset>
      <JapaneseText>とっても……さむ……ぃ……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x13a169</PointerOffset>
      <JapaneseText>アミィーっ！！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
