<SceneText>
  <FriendlyName>Conversation_0076</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x15f9a8</PointerOffset>
      <JapaneseText>む、やるわね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15f9b7</PointerOffset>
      <JapaneseText>そんなわけないでしょうが</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15f9d0</PointerOffset>
      <JapaneseText>ぐっ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15f9db</PointerOffset>
      <JapaneseText>リリスのガッツ</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15f9ed</PointerOffset>
      <JapaneseText>ビストロシャンバール</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fa05</PointerOffset>
      <JapaneseText>はああ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fa12</PointerOffset>
      <JapaneseText>どうしました？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fa21</PointerOffset>
      <JapaneseText>味マスター１号。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fa32</PointerOffset>
      <JapaneseText>味マスター。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fa3f</PointerOffset>
      <JapaneseText>なんてうるわしいことばの響き。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fa5e</PointerOffset>
      <JapaneseText>でも、もうダメ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fa6f</PointerOffset>
      <JapaneseText>その称号は、もはやあたしの物ではない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fa96</PointerOffset>
      <JapaneseText>あの勝負のことなら、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15faab</PointerOffset>
      <JapaneseText>お気になさる必要はありません。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15faca</PointerOffset>
      <JapaneseText>自分はマスターが負けたなどと、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fae9</PointerOffset>
      <JapaneseText>これっぽっちも。あくまで……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fb08</PointerOffset>
      <JapaneseText>裏づけのないなぐさめはよして。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fb27</PointerOffset>
      <JapaneseText>ますます自分が情けなくなる。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fb44</PointerOffset>
      <JapaneseText>マスター……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fb53</PointerOffset>
      <JapaneseText>下がりなさい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fb62</PointerOffset>
      <JapaneseText>今はひとりにしてほしいの。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fb80</PointerOffset>
      <JapaneseText>わからない。わからないわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fb9b</PointerOffset>
      <JapaneseText>あの味の秘密が、どうしても。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fbb8</PointerOffset>
      <JapaneseText>くっ……味マスターとなって３年。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fbd9</PointerOffset>
      <JapaneseText>料理界にこの人ありといわれたあたしが！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fc00</PointerOffset>
      <JapaneseText>あんな田舎者まるだしの、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fc19</PointerOffset>
      <JapaneseText>野蛮な娘に負けるだなんて。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fc3a</PointerOffset>
      <JapaneseText>ひええっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fc45</PointerOffset>
      <JapaneseText>いたたた……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fc54</PointerOffset>
      <JapaneseText>こら、ディムロス。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fc67</PointerOffset>
      <JapaneseText>もう少しちゃんとやってよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fc82</PointerOffset>
      <JapaneseText>無茶いうな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fc8f</PointerOffset>
      <JapaneseText>わたしだって、どこに出るかわからん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fcb4</PointerOffset>
      <JapaneseText>とりあえず、空間移動には成功したのね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fcdb</PointerOffset>
      <JapaneseText>そのはずだが、ここは……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fcf6</PointerOffset>
      <JapaneseText>あっ、あなた！　どこから出てきたの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fd1b</PointerOffset>
      <JapaneseText>それに、ひとりでブツブツしゃべって……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fd44</PointerOffset>
      <JapaneseText>あ、あたしたち、怪しい者じゃないでーす。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fd6d</PointerOffset>
      <JapaneseText>思いっきり怪しいと思うが。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fd88</PointerOffset>
      <JapaneseText>あんたは黙ってなさいよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fda1</PointerOffset>
      <JapaneseText>あたし、たち？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fdb0</PointerOffset>
      <JapaneseText>リリス。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fdb9</PointerOffset>
      <JapaneseText>あの女に、わたしの声は聞こえない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fddc</PointerOffset>
      <JapaneseText>あたしあたし。あたしだけです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fdfb</PointerOffset>
      <JapaneseText>ほかにはだーれもいやしませーん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fe1c</PointerOffset>
      <JapaneseText>見りゃわかるわよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fe2f</PointerOffset>
      <JapaneseText>ちょっと！　その手に持ってる包丁はなに？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fe58</PointerOffset>
      <JapaneseText>あ。いやその、これは……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fe73</PointerOffset>
      <JapaneseText>強盗と間違われたぞ。いわんことじゃない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fe9c</PointerOffset>
      <JapaneseText>だからそんなもの、持ってくるなと。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15febf</PointerOffset>
      <JapaneseText>今さらしょうがないでしょ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>50</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15feda</PointerOffset>
      <JapaneseText>これ？　大したものじゃないですよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>51</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15fefd</PointerOffset>
      <JapaneseText>これ使って何かしようなんて、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>52</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15ff1a</PointerOffset>
      <JapaneseText>ぜーんぜん考えてませんたら。ほほほ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>53</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15ff3f</PointerOffset>
      <JapaneseText>振りまわしてどうするっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>54</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15ff58</PointerOffset>
      <JapaneseText>やば。ついうっかり……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>55</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15ff71</PointerOffset>
      <JapaneseText>その手つき、怪しいわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>56</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15ff88</PointerOffset>
      <JapaneseText>あなた、さては……！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>57</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15ff9d</PointerOffset>
      <JapaneseText>ご、誤解されちゃった……かな？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>58</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15ffbc</PointerOffset>
      <JapaneseText>当たり前だ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>59</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15ffc9</PointerOffset>
      <JapaneseText>仕方ない、この場は逃げるぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>60</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x15ffe6</PointerOffset>
      <JapaneseText>味マスターであるこのあたしに、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>61</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160005</PointerOffset>
      <JapaneseText>勝負をいどみにきたのねっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>62</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160020</PointerOffset>
      <JapaneseText>へ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>63</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160026</PointerOffset>
      <JapaneseText>わかるわ、あなたの気持ち。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>64</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160041</PointerOffset>
      <JapaneseText>どうしても味マスターになりたかったのね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>65</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16006a</PointerOffset>
      <JapaneseText>きっと今まで、あたしを目標に、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>66</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160089</PointerOffset>
      <JapaneseText>さぞ血のにじむ努力を重ねたのでしょう。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>67</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1600b0</PointerOffset>
      <JapaneseText>いや、別に。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>68</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1600bd</PointerOffset>
      <JapaneseText>……でも、ごめんなさい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>69</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1600d6</PointerOffset>
      <JapaneseText>あたしも本当は、勝負してあげたいけど。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>70</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1600fd</PointerOffset>
      <JapaneseText>でも、できないの。なぜならあたしは、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>71</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160122</PointerOffset>
      <JapaneseText>もう味マスターではないから！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>72</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16013f</PointerOffset>
      <JapaneseText>味マスター？　なにそれ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>73</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160158</PointerOffset>
      <JapaneseText>ああ、あのオムライスがわからない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>74</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16017b</PointerOffset>
      <JapaneseText>どうやって作ればいいのかしら。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>75</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16019a</PointerOffset>
      <JapaneseText>オムライスう？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>76</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1601a9</PointerOffset>
      <JapaneseText>あんなもの作るの、簡単じゃない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>77</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1601ca</PointerOffset>
      <JapaneseText>簡単ですって……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>78</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1601dd</PointerOffset>
      <JapaneseText>だって、オムライスでしょ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>79</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1601f8</PointerOffset>
      <JapaneseText>リリス、ちょっと待て。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>80</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16020f</PointerOffset>
      <JapaneseText>何だか相手を刺激しているようだぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>81</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160232</PointerOffset>
      <JapaneseText>あなたのその物言い、料理をナメてるわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>82</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160259</PointerOffset>
      <JapaneseText>あたしの前で！　許せない！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>83</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160274</PointerOffset>
      <JapaneseText>大口を叩くなら、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>84</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160285</PointerOffset>
      <JapaneseText>実力のほど、教えてもらおうじゃないの。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>85</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1602af</PointerOffset>
      <JapaneseText>しからば問う！　オムライスを作るとき、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>86</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1602d6</PointerOffset>
      <JapaneseText>最初にいためる材料は？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>87</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1602ed</PointerOffset>
      <JapaneseText>え？　そんなの……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>88</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160305</PointerOffset>
      <JapaneseText>ミルク</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>89</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16030d</PointerOffset>
      <JapaneseText>たまねぎ</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>90</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160317</PointerOffset>
      <JapaneseText>レタス</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>91</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16031f</PointerOffset>
      <JapaneseText>む、やるわね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>92</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16032e</PointerOffset>
      <JapaneseText>ねえ、ディムロス。あの人あたしに、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>93</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160351</PointerOffset>
      <JapaneseText>オムライスの作り方聞きたいのかしら？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>94</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160376</PointerOffset>
      <JapaneseText>うーむ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>95</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160383</PointerOffset>
      <JapaneseText>そのわりに態度がえらそうね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>96</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1603a0</PointerOffset>
      <JapaneseText>この世界ではあれが普通なのかな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>97</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1603c1</PointerOffset>
      <JapaneseText>何をごちゃごちやいっているの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>98</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1603e0</PointerOffset>
      <JapaneseText>次、いくわよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>99</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1603ef</PointerOffset>
      <JapaneseText>そんなわけないでしょうが。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>100</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16040a</PointerOffset>
      <JapaneseText>あなた、本気でいってるの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>101</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160425</PointerOffset>
      <JapaneseText>ぐっ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>102</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160430</PointerOffset>
      <JapaneseText>続けて問う！　最初に入れた材料に、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>103</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160453</PointerOffset>
      <JapaneseText>加えていためるのは？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>104</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16046b</PointerOffset>
      <JapaneseText>ブレッド</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>105</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160475</PointerOffset>
      <JapaneseText>まぐろ</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>106</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16047d</PointerOffset>
      <JapaneseText>ライス</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>107</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160485</PointerOffset>
      <JapaneseText>そんなわけないでしょうが。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>108</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1604a0</PointerOffset>
      <JapaneseText>オム・ライスよ。ラ・イ・ス！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>109</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1604bd</PointerOffset>
      <JapaneseText>最後に問う！　仕上げに用いる材料に、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>110</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1604e2</PointerOffset>
      <JapaneseText>一番ふさわしいのは？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>111</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1604fa</PointerOffset>
      <JapaneseText>チーズ</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>112</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160502</PointerOffset>
      <JapaneseText>たまご</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>113</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16050a</PointerOffset>
      <JapaneseText>だいこん</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>114</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160514</PointerOffset>
      <JapaneseText>そんなわけないでしょうが。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>115</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16052f</PointerOffset>
      <JapaneseText>オム・ライスよ。オ・ム！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>116</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160548</PointerOffset>
      <JapaneseText>ふう……。そうよね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>117</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16055d</PointerOffset>
      <JapaneseText>これが、普通のオムライスの作り方よね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>118</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160584</PointerOffset>
      <JapaneseText>何よ、知ってたの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>119</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160597</PointerOffset>
      <JapaneseText>だったらわざわざ聞かなくたって。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>120</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1605b8</PointerOffset>
      <JapaneseText>でも、だめなの！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>121</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1605c9</PointerOffset>
      <JapaneseText>これだけじゃ、あの味は出ないのよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>122</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1605ec</PointerOffset>
      <JapaneseText>あの田舎娘は、このレシピに、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>123</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160609</PointerOffset>
      <JapaneseText>さらに秘術を加えている！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>124</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160622</PointerOffset>
      <JapaneseText>それがわからないことには、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>125</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16063d</PointerOffset>
      <JapaneseText>くやしくて眠れないわ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>126</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160658</PointerOffset>
      <JapaneseText>へえ。誰かの作ったオムライスが、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>127</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160679</PointerOffset>
      <JapaneseText>そんなにおいしかったんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>128</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160694</PointerOffset>
      <JapaneseText>試しに食べてみる？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>129</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1606a7</PointerOffset>
      <JapaneseText>こちらでございます。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>130</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1606bc</PointerOffset>
      <JapaneseText>どれどれ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>131</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1606c7</PointerOffset>
      <JapaneseText>もごもご。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>132</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1606d2</PointerOffset>
      <JapaneseText>どう？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>133</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1606da</PointerOffset>
      <JapaneseText>うん、確かにおいしいわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>134</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1606f3</PointerOffset>
      <JapaneseText>レモンが効いてて、全体にさっぱりしてる。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>135</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16071c</PointerOffset>
      <JapaneseText>レモン？　レモンが入っているの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>136</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16073d</PointerOffset>
      <JapaneseText>うん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>137</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160745</PointerOffset>
      <JapaneseText>なるほど、それが秘密の正体だったのね！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>138</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16076c</PointerOffset>
      <JapaneseText>レモンだったなんて……気づかなかった。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>139</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160793</PointerOffset>
      <JapaneseText>あの田舎娘、大したものね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>140</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1607ae</PointerOffset>
      <JapaneseText>あたしの完敗だわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>141</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1607c1</PointerOffset>
      <JapaneseText>ああ、なんだか肩の荷が下りた気分よ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>142</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1607e6</PointerOffset>
      <JapaneseText>今はむしろ、すがすがしさすら感じる。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>143</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16080b</PointerOffset>
      <JapaneseText>はあ。そうですか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>144</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16081e</PointerOffset>
      <JapaneseText>決めたわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>145</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160829</PointerOffset>
      <JapaneseText>あたしは今から山にこもる。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>146</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160844</PointerOffset>
      <JapaneseText>料理の何たるかを、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>147</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160857</PointerOffset>
      <JapaneseText>根本から見直すことにするわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>148</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x160874</PointerOffset>
      <JapaneseText>だからあなた。今日からあたしの代わりに、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>149</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16089d</PointerOffset>
      <JapaneseText>新たな味マスターを名乗りなさい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>150</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1608be</PointerOffset>
      <JapaneseText>なんのこと？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>151</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1608cb</PointerOffset>
      <JapaneseText>あなたにはその資格がある。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>152</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1608e6</PointerOffset>
      <JapaneseText>ビストロシャンバールの未来は……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>153</Id>
      <Status>To Do</Status>
    </Entry>
