<SceneText>
  <FriendlyName>Conversation_0078</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x161a83</PointerOffset>
      <JapaneseText>たっ、大変だ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161a92</PointerOffset>
      <JapaneseText>味マスター２号が敗れた！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161aab</PointerOffset>
      <JapaneseText>なんですって？　相手は？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161ac7</PointerOffset>
      <JapaneseText>君のときと同じだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161ada</PointerOffset>
      <JapaneseText>ラシュアンからやってきた、あの……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161aff</PointerOffset>
      <JapaneseText>なんてこと！　またあの娘？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161b1a</PointerOffset>
      <JapaneseText>緑の悪魔が、またしても勝ったというの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161b55</PointerOffset>
      <JapaneseText>がりなさい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161b62</PointerOffset>
      <JapaneseText>今はひとりにしてほしいの。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161b80</PointerOffset>
      <JapaneseText>わからない。わからないわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161b9b</PointerOffset>
      <JapaneseText>あの味の秘密が、どうしても。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161bb8</PointerOffset>
      <JapaneseText>くっ……味マスターとなって３年。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161bd9</PointerOffset>
      <JapaneseText>料理界にこの人ありといわれたあたしが！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161c00</PointerOffset>
      <JapaneseText>あんな田舎者まるだしの、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161c19</PointerOffset>
      <JapaneseText>野蛮な娘に負けるだなんて。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161c3a</PointerOffset>
      <JapaneseText>ひええっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161c45</PointerOffset>
      <JapaneseText>いたたた……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161c54</PointerOffset>
      <JapaneseText>こら、ディムロス。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161c67</PointerOffset>
      <JapaneseText>もう少しちゃんとやってよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161c82</PointerOffset>
      <JapaneseText>無茶いうな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161c8f</PointerOffset>
      <JapaneseText>わたしだって、どこに出るかわからん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161cb4</PointerOffset>
      <JapaneseText>とりあえず、空間移動には成功したのね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161cdb</PointerOffset>
      <JapaneseText>そのはずだが、ここは……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161cf6</PointerOffset>
      <JapaneseText>あっ、あなた！　どこから出てきたの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161d1b</PointerOffset>
      <JapaneseText>それに、ひとりでブツブツしゃべって……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161d44</PointerOffset>
      <JapaneseText>あ、あたしたち、怪しい者じゃないでーす。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161d6d</PointerOffset>
      <JapaneseText>思いっきり怪しいと思うが。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161d88</PointerOffset>
      <JapaneseText>あんたは黙ってなさいよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161da1</PointerOffset>
      <JapaneseText>あたし、たち？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161db0</PointerOffset>
      <JapaneseText>リリス。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161db9</PointerOffset>
      <JapaneseText>あの女に、わたしの声は聞こえない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161ddc</PointerOffset>
      <JapaneseText>あたしあたし。あたしだけです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161dfb</PointerOffset>
      <JapaneseText>ほかにはだーれもいやしませーん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161e1c</PointerOffset>
      <JapaneseText>見りゃわかるわよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161e2f</PointerOffset>
      <JapaneseText>ちょっと！　その手に持ってる包丁はなに？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161e58</PointerOffset>
      <JapaneseText>あ。いやその、これは……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161e73</PointerOffset>
      <JapaneseText>強盗と間違われたぞ。いわんことじゃない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161e9c</PointerOffset>
      <JapaneseText>だからそんなもの、持ってくるなと。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161ebf</PointerOffset>
      <JapaneseText>今さらしょうがないでしょ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161eda</PointerOffset>
      <JapaneseText>これ？　大したものじゃないですよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161efd</PointerOffset>
      <JapaneseText>これ使って何かしようなんて、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161f1a</PointerOffset>
      <JapaneseText>ぜーんぜん考えてませんたら。ほほほ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161f3f</PointerOffset>
      <JapaneseText>振りまわしてどうするっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161f58</PointerOffset>
      <JapaneseText>やば。ついうっかり……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161f71</PointerOffset>
      <JapaneseText>その手つき、怪しいわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161f88</PointerOffset>
      <JapaneseText>あなた、さては……！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161f9d</PointerOffset>
      <JapaneseText>ご、誤解されちゃった……かな？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161fbc</PointerOffset>
      <JapaneseText>当たり前だ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161fc9</PointerOffset>
      <JapaneseText>仕方ない、この場は逃げるぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x161fe6</PointerOffset>
      <JapaneseText>味マスターであるこのあたし</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
