<SceneText>
  <FriendlyName>Conversation_0080</FriendlyName>
  <Title>リリスのガッツ</Title>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <PointerOffset>0x1679f0</PointerOffset>
      <JapaneseText>リリスのガッツ</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167a02</PointerOffset>
      <JapaneseText>ペスカトーレ、ペスカトーレと。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167a21</PointerOffset>
      <JapaneseText>勝算はあるのか？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167a32</PointerOffset>
      <JapaneseText>どうだろ。まあ、なんとかなるでしょ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167a57</PointerOffset>
      <JapaneseText>何度も作ったことあるし。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167a70</PointerOffset>
      <JapaneseText>たぶん特定の食材の選び方が、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167a8d</PointerOffset>
      <JapaneseText>勝敗を左右することになると思うの。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167ab0</PointerOffset>
      <JapaneseText>ほう。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167ab7</PointerOffset>
      <JapaneseText>特に大事なのは、そうね……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167ad7</PointerOffset>
      <JapaneseText>トマトかな</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167ae3</PointerOffset>
      <JapaneseText>エビかな</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167aed</PointerOffset>
      <JapaneseText>チーズかな</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167af9</PointerOffset>
      <JapaneseText>ふんだんに入れた海産物の調和を取り、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167b1e</PointerOffset>
      <JapaneseText>味をととのえる役割を果たすトマト。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167b41</PointerOffset>
      <JapaneseText>やっぱり、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167b4c</PointerOffset>
      <JapaneseText>一番大切なのはトマトだわ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167b67</PointerOffset>
      <JapaneseText>確かにエビやイカといった海産物こそ、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167b8c</PointerOffset>
      <JapaneseText>ペスカトーレのメインとなる食材だわ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167bb1</PointerOffset>
      <JapaneseText>でもそれが重要なのは、ある意味当たり前。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167bda</PointerOffset>
      <JapaneseText>注目すべきは、むしろトマトじゃないかな？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167c03</PointerOffset>
      <JapaneseText>チーズはオプションよ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167c1a</PointerOffset>
      <JapaneseText>絶対必要な食材、というわけではない。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167c3f</PointerOffset>
      <JapaneseText>ベースとなる部分に注目すべきね。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167c60</PointerOffset>
      <JapaneseText>たとえば、トマトとか。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167c77</PointerOffset>
      <JapaneseText>ここに並んだトマトではだめなのか。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167c9a</PointerOffset>
      <JapaneseText>そうねえ……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167ca9</PointerOffset>
      <JapaneseText>あら、あなたは……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167cbe</PointerOffset>
      <JapaneseText>あ、味マスター……さん？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167cd7</PointerOffset>
      <JapaneseText>あの、その……コ、コンニチハ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167cf6</PointerOffset>
      <JapaneseText>こんにちは。お買い物ですか？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167d13</PointerOffset>
      <JapaneseText>は、はい。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167d1e</PointerOffset>
      <JapaneseText>味マスターさんもお買い物ですか？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167d3f</PointerOffset>
      <JapaneseText>ええ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167d46</PointerOffset>
      <JapaneseText>そうですか。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167d53</PointerOffset>
      <JapaneseText>それじゃあわたし、この辺で。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167d70</PointerOffset>
      <JapaneseText>ごきげんよう。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167d85</PointerOffset>
      <JapaneseText>ふ〜、緊張したあ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167d98</PointerOffset>
      <JapaneseText>あの場でケンカしやしないかと、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167db7</PointerOffset>
      <JapaneseText>ひやひやしたぞ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167dc8</PointerOffset>
      <JapaneseText>そんなことしないよー。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167ddf</PointerOffset>
      <JapaneseText>勝負はキッチンでつけるわ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167dfa</PointerOffset>
      <JapaneseText>『今度の相手は、なんだか手強そうだ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167e1f</PointerOffset>
      <JapaneseText>なあファラ、勝算はあるのか？』</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167e3e</PointerOffset>
      <JapaneseText>『だいじょぶ。自信あるよ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167e59</PointerOffset>
      <JapaneseText>わたしには、切り札があるんだから』</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167e7c</PointerOffset>
      <JapaneseText>『セレスティアのあれを使えば、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167e9b</PointerOffset>
      <JapaneseText>きっとおいしいペスカトーレが作れるよ』</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167ec2</PointerOffset>
      <JapaneseText>『ああ……。あれね』</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167ed7</PointerOffset>
      <JapaneseText>『なるほど、あれか』</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167eec</PointerOffset>
      <JapaneseText>切り札……何かしら。気になるわね……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167f13</PointerOffset>
      <JapaneseText>それで？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>50</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167f1c</PointerOffset>
      <JapaneseText>トマトをどこで調達するつもりだ？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>51</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167f40</PointerOffset>
      <JapaneseText>この店で買う</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>52</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167f4e</PointerOffset>
      <JapaneseText>この世界を探しまわる</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>53</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167f64</PointerOffset>
      <JapaneseText>いったんリーネに帰る</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>54</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167f7a</PointerOffset>
      <JapaneseText>やっぱり、ここにあるのにするわ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>55</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167f9b</PointerOffset>
      <JapaneseText>品はいいし、鮮度も悪くないもの。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>56</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167fbc</PointerOffset>
      <JapaneseText>そうか。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>57</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167fc5</PointerOffset>
      <JapaneseText>もう少し、この世界を見てまわりたいな。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>58</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x167fec</PointerOffset>
      <JapaneseText>ほかの所に、もっといいのがあるかも。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>59</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x168011</PointerOffset>
      <JapaneseText>そこまでやるか？　当初の目的から、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>60</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x168034</PointerOffset>
      <JapaneseText>どんどん離れていっているぞ……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>61</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x168055</PointerOffset>
      <JapaneseText>文句いわない。乗りかかった船よ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>62</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x168076</PointerOffset>
      <JapaneseText>ねえディムロス。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>63</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x168087</PointerOffset>
      <JapaneseText>いったん、リーネの村に戻ってもいい？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>64</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1680ac</PointerOffset>
      <JapaneseText>なぜだ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>65</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1680b5</PointerOffset>
      <JapaneseText>あたしだけの味で、勝負したいの。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>66</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1680d6</PointerOffset>
      <JapaneseText>そのために、村でとれた材料が必要なのよ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>67</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1680ff</PointerOffset>
      <JapaneseText>そこまでして、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>68</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16810e</PointerOffset>
      <JapaneseText>勝負にこだわる理由があるのか？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>69</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16812d</PointerOffset>
      <JapaneseText>あるわ。これは名誉の問題よ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>70</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16814a</PointerOffset>
      <JapaneseText>リーネ一番の料理上手としての、ね。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>71</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16816d</PointerOffset>
      <JapaneseText>自分自身、そして村のためにも、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>72</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x16818c</PointerOffset>
      <JapaneseText>この勝負、負けられないわ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>73</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1681a7</PointerOffset>
      <JapaneseText>……やれやれ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>74</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1681b6</PointerOffset>
      <JapaneseText>すっかり、のぼせ上がっているな。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>75</Id>
      <Status>To Do</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
