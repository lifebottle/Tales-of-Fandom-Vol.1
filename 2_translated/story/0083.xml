<SceneText>
  <FriendlyName>Conversation_0083</FriendlyName>
  <Title>リリスのガッツ</Title>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <PointerOffset>0x1785f0</PointerOffset>
      <JapaneseText>リリスのガッツ</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178602</PointerOffset>
      <JapaneseText>両選手が戦いの場へと戻って参りました！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178629</PointerOffset>
      <JapaneseText>いよいよ、勝負は待ったなし。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178646</PointerOffset>
      <JapaneseText>おふたりとも、よろしいですね？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178665</PointerOffset>
      <JapaneseText>はい！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x17866c</PointerOffset>
      <JapaneseText>それでは！　ペスカトーレ対決、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x17868b</PointerOffset>
      <JapaneseText>始めさせていただきます！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1786a4</PointerOffset>
      <JapaneseText>ゲストの方に、お話をうかがいます。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1786c7</PointerOffset>
      <JapaneseText>なぜ、昔の味でなければならないのですか？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1786f0</PointerOffset>
      <JapaneseText>あの女、すげえな。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178703</PointerOffset>
      <JapaneseText>あんな速いみじん切り、見たことねえぞ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x17872a</PointerOffset>
      <JapaneseText>ファラも負けていないぞ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178743</PointerOffset>
      <JapaneseText>気合いの入りかたは、今までで一番だ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178768</PointerOffset>
      <JapaneseText>それでいて、動きにはまったくムダがない。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178791</PointerOffset>
      <JapaneseText>舞うがごとき、優雅な包丁さばきだ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1787b4</PointerOffset>
      <JapaneseText>のっけから、目まぐるしい攻防だぜ……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1787de</PointerOffset>
      <JapaneseText>まず「ミルク」をいためる</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1787f8</PointerOffset>
      <JapaneseText>まず「たまねぎ」をいためる</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178814</PointerOffset>
      <JapaneseText>まず「レタス」をいためる</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178831</PointerOffset>
      <JapaneseText>ペスカトーレには、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178844</PointerOffset>
      <JapaneseText>どのような思い出があるのですか？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178868</PointerOffset>
      <JapaneseText>デバッグ「セルシウス」</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178880</PointerOffset>
      <JapaneseText>デバッグ「ボブおじさん」</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x17889a</PointerOffset>
      <JapaneseText>デバッグ「食材店のトマト」</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1788b6</PointerOffset>
      <JapaneseText>次は「レモン」</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1788c6</PointerOffset>
      <JapaneseText>次は「ボブおじさんのトマト」</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1788e4</PointerOffset>
      <JapaneseText>次は「ベアのにく」</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1788f8</PointerOffset>
      <JapaneseText>次は「レモン」</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178908</PointerOffset>
      <JapaneseText>次は「ふゆトマト」</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x17891c</PointerOffset>
      <JapaneseText>次は「ベアのにく」</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178930</PointerOffset>
      <JapaneseText>次は「レモン」</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178940</PointerOffset>
      <JapaneseText>次は「トマト」</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178950</PointerOffset>
      <JapaneseText>次は「ベアのにく」</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178967</PointerOffset>
      <JapaneseText>ハイレベルな戦いが繰り広げられています！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178990</PointerOffset>
      <JapaneseText>両選手とも、まったく退く構えなし。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1789b3</PointerOffset>
      <JapaneseText>これは、すごい。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1789c4</PointerOffset>
      <JapaneseText>間違いなく、歴史に残る一戦だ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1789e3</PointerOffset>
      <JapaneseText>どっちが作る料理も、うめーんだろうな。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178a0a</PointerOffset>
      <JapaneseText>想像しただけで、腹が鳴りそうだ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178a2e</PointerOffset>
      <JapaneseText>さらに加えるのは「パスタ」</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178a4a</PointerOffset>
      <JapaneseText>さらに加えるのは「ライス」</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178a66</PointerOffset>
      <JapaneseText>さらに加えるのは「ブレッド」</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178a87</PointerOffset>
      <JapaneseText>キール、気づいたか？　いつのまにか、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178aac</PointerOffset>
      <JapaneseText>会場内がしんと静まり返っている。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178acd</PointerOffset>
      <JapaneseText>ああ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178ad4</PointerOffset>
      <JapaneseText>皆が固唾を飲んで見守っているんだ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178af7</PointerOffset>
      <JapaneseText>息詰まる、とはまさにこのことだな。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178b1a</PointerOffset>
      <JapaneseText>いよいよ、クライマックスか……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178b3e</PointerOffset>
      <JapaneseText>仕上げは「まぐろ」</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178b52</PointerOffset>
      <JapaneseText>仕上げは「ポテト」</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178b66</PointerOffset>
      <JapaneseText>仕上げは「いか」</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>50</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178b7b</PointerOffset>
      <JapaneseText>間もなく、終了となります。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>51</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178b9c</PointerOffset>
      <JapaneseText>鐘が鳴らされました。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>52</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178bb1</PointerOffset>
      <JapaneseText>これより、試食へ移ります。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>53</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178bcc</PointerOffset>
      <JapaneseText>どっちが勝ったと思う？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>54</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178be3</PointerOffset>
      <JapaneseText>わからない。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>55</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178bf0</PointerOffset>
      <JapaneseText>接戦であることは、確かだが。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>56</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178c0d</PointerOffset>
      <JapaneseText>果たして栄光をつかむのは、どちらか？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>57</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178c32</PointerOffset>
      <JapaneseText>味マスターか、それとも挑戦者か！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>58</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178c59</PointerOffset>
      <JapaneseText>お……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>59</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178c62</PointerOffset>
      <JapaneseText>おいしーーーーーーーーーっ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>60</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178c85</PointerOffset>
      <JapaneseText>味マスター！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>61</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178c92</PointerOffset>
      <JapaneseText>やったあ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>62</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178c9d</PointerOffset>
      <JapaneseText>激闘を制したのは味マスター！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>63</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178cba</PointerOffset>
      <JapaneseText>味マスターの勝ちです！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>64</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178cd1</PointerOffset>
      <JapaneseText>ビストロシャンバール最後の牙城が、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>65</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178cf4</PointerOffset>
      <JapaneseText>意地を見せました。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>66</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178d07</PointerOffset>
      <JapaneseText>よかったな、リリス。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>67</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178d1c</PointerOffset>
      <JapaneseText>うん。おじさんが丹精こめて作った、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>68</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178d3f</PointerOffset>
      <JapaneseText>あのトマトのおかげだよ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>69</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178d58</PointerOffset>
      <JapaneseText>味マスターさん。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>70</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178d69</PointerOffset>
      <JapaneseText>えーと、確か……ファラ、さん。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>71</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178d88</PointerOffset>
      <JapaneseText>おめでとう。わたしも自信あったんだけど、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>72</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178db1</PointerOffset>
      <JapaneseText>かなわなかったみたいです。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>73</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178dcc</PointerOffset>
      <JapaneseText>判定、ドロー！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>74</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178ddb</PointerOffset>
      <JapaneseText>ふう。引き分けかあ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>75</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178df0</PointerOffset>
      <JapaneseText>残念だったな。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>76</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178dff</PointerOffset>
      <JapaneseText>死闘の末に勝者なし！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>77</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178e14</PointerOffset>
      <JapaneseText>ある意味、順当な結末かもしれません。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>78</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178e39</PointerOffset>
      <JapaneseText>達人ふたりによるペスカトーレ勝負は、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>79</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178e5e</PointerOffset>
      <JapaneseText>まったく互角の結果に終わりました。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>80</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178e81</PointerOffset>
      <JapaneseText>味マスターさん。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>81</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178e92</PointerOffset>
      <JapaneseText>えーと、確か……ファラ、さん。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>82</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178eb1</PointerOffset>
      <JapaneseText>決着、つきませんでしたね。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>83</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178ecc</PointerOffset>
      <JapaneseText>ええ。でもふゆトマトがなかったら、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>84</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178eef</PointerOffset>
      <JapaneseText>きっとあなたが勝ったと思うわ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>85</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178f0e</PointerOffset>
      <JapaneseText>そんな。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>86</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178f17</PointerOffset>
      <JapaneseText>正々堂々、戦ってくれてありがとう。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>87</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178f3a</PointerOffset>
      <JapaneseText>わたしこそ……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>88</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178f4b</PointerOffset>
      <JapaneseText>勝者！　挑戦者ファラ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>89</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178f62</PointerOffset>
      <JapaneseText>やったあー！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>90</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178f6f</PointerOffset>
      <JapaneseText>ふう。負けちゃった。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>91</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178f84</PointerOffset>
      <JapaneseText>あんなに頑張ったのに、残念だったな。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>92</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178fa9</PointerOffset>
      <JapaneseText>仕方ないわ。あの人のほうが、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>93</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178fc6</PointerOffset>
      <JapaneseText>実力が上だったのよ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>94</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x178fdb</PointerOffset>
      <JapaneseText>さてと。ここの支配人にいわれたこと、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>95</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x179000</PointerOffset>
      <JapaneseText>やらなくっちゃ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>96</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x179011</PointerOffset>
      <JapaneseText>味マスター……さん？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>97</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x179026</PointerOffset>
      <JapaneseText>あたしの負けね。インフェリア料理界で、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>98</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x17904d</PointerOffset>
      <JapaneseText>もっとも権威のある称号をあげる。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>99</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x17906e</PointerOffset>
      <JapaneseText>「あじむしゃ」は、あなたのものよ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>100</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x179091</PointerOffset>
      <JapaneseText>えっ……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>101</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x17909c</PointerOffset>
      <JapaneseText>ぬあんと！　味マスターからファラさんに、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>102</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1790c5</PointerOffset>
      <JapaneseText>称号が与えられました！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>103</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1790dc</PointerOffset>
      <JapaneseText>やれやれ。それにしても……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>104</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1790f9</PointerOffset>
      <JapaneseText>いい勝負だったわ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>105</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x17910c</PointerOffset>
      <JapaneseText>こんなこというのは何だけど、楽しかった。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>106</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x179135</PointerOffset>
      <JapaneseText>味マスターさんもそう思いましたか？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>107</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x179158</PointerOffset>
      <JapaneseText>実はわたしもなんです。奇遇ですね。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>108</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x17917b</PointerOffset>
      <JapaneseText>ふーん……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>109</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x17918a</PointerOffset>
      <JapaneseText>……あたしたち、結構気が合うかもね。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>110</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1791af</PointerOffset>
      <JapaneseText>うん、そうね。わたしもそう思う！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>111</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1791d0</PointerOffset>
      <JapaneseText>あたしのことは、リリスって呼んで。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>112</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1791f3</PointerOffset>
      <JapaneseText>わかったわ、リリス。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>113</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x179208</PointerOffset>
      <JapaneseText>また、勝負しようね！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>114</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x17921d</PointerOffset>
      <JapaneseText>おおーっと。戦いを終えたふたりの間に、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>115</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x179244</PointerOffset>
      <JapaneseText>どうやら友情が芽生えた模様！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>116</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x179261</PointerOffset>
      <JapaneseText>なんと美しい光景でしょう！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>117</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x17927c</PointerOffset>
      <JapaneseText>皆様、どうかこのふたりに盛大な拍手を！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>118</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1792a9</PointerOffset>
      <JapaneseText>それではこれより、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>119</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1792bc</PointerOffset>
      <JapaneseText>勝者の栄誉を祝して……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>120</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1792d5</PointerOffset>
      <JapaneseText>あーっ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>121</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1792de</PointerOffset>
      <JapaneseText>どうした？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>122</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1792e9</PointerOffset>
      <JapaneseText>お昼ごはんのしたく、忘れてた！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>123</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x179308</PointerOffset>
      <JapaneseText>お兄ちゃんたち、おなかすかせてるわ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>124</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x17932d</PointerOffset>
      <JapaneseText>ディムロス、鉱石のあるところへ急ぐわよ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>125</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x179356</PointerOffset>
      <JapaneseText>じゃーね、ファラ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>126</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x179369</PointerOffset>
      <JapaneseText>マスター？　どこへ行くんですか？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>127</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x17938a</PointerOffset>
      <JapaneseText>マスター！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>128</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x179398</PointerOffset>
      <JapaneseText>なんだ？　あの女……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>129</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1793af</PointerOffset>
      <JapaneseText>まるで台風だな。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>130</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1793c0</PointerOffset>
      <JapaneseText>あはは、それいいね。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>131</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1793d5</PointerOffset>
      <JapaneseText>気持ちいい人だったな。また会いたい。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>132</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1793fa</PointerOffset>
      <JapaneseText>あの〜。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>133</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x179403</PointerOffset>
      <JapaneseText>あたし、リバヴィウス鉱っていうのを</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>134</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x179426</PointerOffset>
      <JapaneseText>探してるんだけど……心当たり、ある？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>135</Id>
      <Status>To Do</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
