<SceneText>
  <FriendlyName>Conversation_0093</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x19b4a3</PointerOffset>
      <JapaneseText>我が身の内に宿るすべてのともし火よ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b4c8</PointerOffset>
      <JapaneseText>今こそ我が呼びかけに応えよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b4eb</PointerOffset>
      <JapaneseText>……不思議な旋律が、響いてくる。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b50c</PointerOffset>
      <JapaneseText>どこから？　あたしの中から？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b529</PointerOffset>
      <JapaneseText>あの剣は、いったい何だ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b542</PointerOffset>
      <JapaneseText>中から、ものすごい密度の気が……！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b565</PointerOffset>
      <JapaneseText>これに合わせて、口ずさめばいいのね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b58a</PointerOffset>
      <JapaneseText>妙なる息吹を糧となし、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b5a1</PointerOffset>
      <JapaneseText>炎よ、翼持ちてはばたくがいい！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b5c0</PointerOffset>
      <JapaneseText>このままでは……まずい！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b5d9</PointerOffset>
      <JapaneseText>こちらから先に、仕掛けなければ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b600</PointerOffset>
      <JapaneseText>我らが内に宿りたる、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b615</PointerOffset>
      <JapaneseText>炎と風の雄こんなる調べ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b62e</PointerOffset>
      <JapaneseText>今こそこの場に！　体現せしめん！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b64f</PointerOffset>
      <JapaneseText>うなれ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b658</PointerOffset>
      <JapaneseText>マキシマム・レッド・ブラスター！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b67f</PointerOffset>
      <JapaneseText>こっ、これは？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b68e</PointerOffset>
      <JapaneseText>何が起こったんだ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b6a1</PointerOffset>
      <JapaneseText>ものすごい光があふれ出たと思ったら、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b6c6</PointerOffset>
      <JapaneseText>いつのまにか、立っているのは少女だけだ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b6ef</PointerOffset>
      <JapaneseText>勝ったよ、ディムロス……どう？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b70e</PointerOffset>
      <JapaneseText>あたし、ちゃんと当てたでしょ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b72d</PointerOffset>
      <JapaneseText>ディムロス？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b73a</PointerOffset>
      <JapaneseText>ちょっと。返事しなさいよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b755</PointerOffset>
      <JapaneseText>ディムロスったら！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b76b</PointerOffset>
      <JapaneseText>ううう……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b778</PointerOffset>
      <JapaneseText>あなた！　まだ立ち上がるつもり？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b799</PointerOffset>
      <JapaneseText>もう無理よ、やめなさい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b7b5</PointerOffset>
      <JapaneseText>素晴らしい攻撃だった。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b7cc</PointerOffset>
      <JapaneseText>あれほどの技を見たのは、初めてだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b7ef</PointerOffset>
      <JapaneseText>どうやら僕は、思い違いをしていたらしい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b818</PointerOffset>
      <JapaneseText>きみがダオスの手の者であるはずがない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b83f</PointerOffset>
      <JapaneseText>なぜなら、きみの攻撃には、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b85a</PointerOffset>
      <JapaneseText>よこしまなところがまるでないからだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b87f</PointerOffset>
      <JapaneseText>川のせせらぎのように澄み切っている……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b8a8</PointerOffset>
      <JapaneseText>それでもあなたは、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b8bb</PointerOffset>
      <JapaneseText>そうやって剣を構えなおすのね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b8da</PointerOffset>
      <JapaneseText>ああ。事実を知っても、剣士としての血が、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b903</PointerOffset>
      <JapaneseText>戦いをやめさせてくれない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b91e</PointerOffset>
      <JapaneseText>きみのような強敵とめぐり会えたことで、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b945</PointerOffset>
      <JapaneseText>身体が喜びに震えているんだ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b966</PointerOffset>
      <JapaneseText>あなた、うちのお兄ちゃんそっくり。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b989</PointerOffset>
      <JapaneseText>強くなることにひたむきで。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b9a4</PointerOffset>
      <JapaneseText>どんな苦労もいとわなくて。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b9bf</PointerOffset>
      <JapaneseText>夢中になって、何も目に入らなくなるの。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b9e6</PointerOffset>
      <JapaneseText>あなたみたいな人には、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19b9fd</PointerOffset>
      <JapaneseText>何をいってもダメなのよね。知ってるわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19ba24</PointerOffset>
      <JapaneseText>……あと一回よ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19ba35</PointerOffset>
      <JapaneseText>それで、決着をつけましょ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19ba50</PointerOffset>
      <JapaneseText>ありがたい。ならば、今こそ見せよう！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19ba7b</PointerOffset>
      <JapaneseText>最終奥義！　冥空！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>50</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19ba8e</PointerOffset>
      <JapaneseText>斬しょう剣！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>51</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19baa1</PointerOffset>
      <JapaneseText>攻撃を受け止めている余裕はない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>52</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19bac2</PointerOffset>
      <JapaneseText>こっちからも攻撃して、相殺するしか！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>53</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19baea</PointerOffset>
      <JapaneseText>魔神剣</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>54</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19baf2</PointerOffset>
      <JapaneseText>雷神拳</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>55</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19bafa</PointerOffset>
      <JapaneseText>雷神十連撃</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>56</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19bb06</PointerOffset>
      <JapaneseText>サンダーソード</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>57</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19bb16</PointerOffset>
      <JapaneseText>魔神剣</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>58</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19bb1e</PointerOffset>
      <JapaneseText>雷神拳</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>59</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19bb26</PointerOffset>
      <JapaneseText>雷神十連撃</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>60</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19bb35</PointerOffset>
      <JapaneseText>サンダーソード！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>61</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19bb4c</PointerOffset>
      <JapaneseText>あ、ありがとう……ございまし……た……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>62</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19bb75</PointerOffset>
      <JapaneseText>クレス・アルベイン、敗れる！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>63</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19bb92</PointerOffset>
      <JapaneseText>時空の剣士、とうとう力尽きました！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>64</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19bbb5</PointerOffset>
      <JapaneseText>８１連勝ならず！　勝者は謎の少女！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>65</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19bbdb</PointerOffset>
      <JapaneseText>魔神剣！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>66</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19bbea</PointerOffset>
      <JapaneseText>雷神拳！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>67</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19bbf9</PointerOffset>
      <JapaneseText>雷神十連撃！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>68</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19bc0c</PointerOffset>
      <JapaneseText>両者ノックアウト！　引き分けです！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>69</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19bc2f</PointerOffset>
      <JapaneseText>試合は引き分けに終わりました！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>70</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
