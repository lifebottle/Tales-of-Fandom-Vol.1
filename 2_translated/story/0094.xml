<SceneText>
  <FriendlyName>Conversation_0094</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x19c4bb</PointerOffset>
      <JapaneseText>オリジン！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c4d0</PointerOffset>
      <JapaneseText>が呼びかけに応えよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c4eb</PointerOffset>
      <JapaneseText>……不思議な旋律が、響いてくる。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c50c</PointerOffset>
      <JapaneseText>どこから？　あたしの中から？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c529</PointerOffset>
      <JapaneseText>あの剣は、いったい何だ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c542</PointerOffset>
      <JapaneseText>中から、ものすごい密度の気が……！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c565</PointerOffset>
      <JapaneseText>これに合わせて、口ずさめばいいのね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c58a</PointerOffset>
      <JapaneseText>妙なる息吹を糧となし、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c5a1</PointerOffset>
      <JapaneseText>炎よ、翼持ちてはばたくがいい！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c5c0</PointerOffset>
      <JapaneseText>このままでは……まずい！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c5d9</PointerOffset>
      <JapaneseText>こちらから先に、仕掛けなければ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c600</PointerOffset>
      <JapaneseText>我らが内に宿りたる、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c615</PointerOffset>
      <JapaneseText>炎と風の雄こんなる調べ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c62e</PointerOffset>
      <JapaneseText>今こそこの場に！　体現せしめん！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c64f</PointerOffset>
      <JapaneseText>うなれ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c658</PointerOffset>
      <JapaneseText>マキシマム・レッド・ブラスター！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c67f</PointerOffset>
      <JapaneseText>こっ、これは？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c68e</PointerOffset>
      <JapaneseText>何が起こったんだ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c6a1</PointerOffset>
      <JapaneseText>ものすごい光があふれ出たと思ったら、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c6c6</PointerOffset>
      <JapaneseText>いつのまにか、立っているのは少女だけだ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c6ef</PointerOffset>
      <JapaneseText>勝ったよ、ディムロス……どう？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c70e</PointerOffset>
      <JapaneseText>あたし、ちゃんと当てたでしょ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c72d</PointerOffset>
      <JapaneseText>ディムロス？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c73a</PointerOffset>
      <JapaneseText>ちょっと。返事しなさいよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c755</PointerOffset>
      <JapaneseText>ディムロスったら！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c76b</PointerOffset>
      <JapaneseText>ううう……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c778</PointerOffset>
      <JapaneseText>あなた！　まだ立ち上がるつもり？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c799</PointerOffset>
      <JapaneseText>もう無理よ、やめなさい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c7b5</PointerOffset>
      <JapaneseText>素晴らしい攻撃だった。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c7cc</PointerOffset>
      <JapaneseText>あれほどの技を見たのは、初めてだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x19c7ef</PointerOffset>
      <JapaneseText>どうやら僕は、思</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
