    </Entry>
    <Entry>
      <PointerOffset>506966</PointerOffset>
      <JapaneseText>だめだめ。アミィちゃんには、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>506995</PointerOffset>
