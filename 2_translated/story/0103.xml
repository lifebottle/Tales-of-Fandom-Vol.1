<SceneText>
  <FriendlyName>Conversation_0103</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x1acb23</PointerOffset>
      <JapaneseText>ええ〜？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acb2c</PointerOffset>
      <JapaneseText>なによ、ここで終わり〜？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acb4d</PointerOffset>
      <JapaneseText>いない』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acb56</PointerOffset>
      <JapaneseText>『なにそれ。お兄ちゃんかわいそうだから、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acb7f</PointerOffset>
      <JapaneseText>なるべく早いうちにしてよ』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acb9a</PointerOffset>
      <JapaneseText>『善処はしよう』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acbab</PointerOffset>
      <JapaneseText>なんだかディムロスの声が、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acbc6</PointerOffset>
      <JapaneseText>聞こえるような気がするなー。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acbe3</PointerOffset>
      <JapaneseText>だけどこれも、幻聴なんだろうなー。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acc06</PointerOffset>
      <JapaneseText>あいつがここにいるはず、ないもんなー。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acc2d</PointerOffset>
      <JapaneseText>お、お兄ちゃん……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acc42</PointerOffset>
      <JapaneseText>でもリリス、おれ、嬉しいよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acc5f</PointerOffset>
      <JapaneseText>うん、すっごく嬉しい。ありがとう！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acc82</PointerOffset>
      <JapaneseText>この剣さ、こうやって振ってみると、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acca5</PointerOffset>
      <JapaneseText>長さといい、重さといい、本物そっくりだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1accce</PointerOffset>
      <JapaneseText>で、でしょ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1accdb</PointerOffset>
      <JapaneseText>一生懸命、記憶を掘り起こしたんだから。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acd02</PointerOffset>
      <JapaneseText>いやー、苦労かけたなー。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acd1b</PointerOffset>
      <JapaneseText>大事にするからさ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acd2e</PointerOffset>
      <JapaneseText>そうしてくれると嬉しいわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acd49</PointerOffset>
      <JapaneseText>ディ……その剣も、喜ぶと思う。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acd68</PointerOffset>
      <JapaneseText>これさ、名前はなんていうんだ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acd87</PointerOffset>
      <JapaneseText>名前？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acd8e</PointerOffset>
      <JapaneseText>これだけディムロスにそっくりなんだから、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acdb7</PointerOffset>
      <JapaneseText>こいつにも名前があっていいと思うんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acdde</PointerOffset>
      <JapaneseText>リリスが決めてくれよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acdf5</PointerOffset>
      <JapaneseText>そ、そうね……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ace06</PointerOffset>
      <JapaneseText>だったら、Ｓ．Ｄ．なんてどうかな？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ace29</PointerOffset>
      <JapaneseText>えすでぃー？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ace36</PointerOffset>
      <JapaneseText>変すぎる、かな？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ace47</PointerOffset>
      <JapaneseText>『なんだそれは！　安易すぎるぞ！』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ace6a</PointerOffset>
      <JapaneseText>『しっ。お兄ちゃんに聞こえるわよ？』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ace8f</PointerOffset>
      <JapaneseText>ふーん。Ｓ．Ｄ．か。よくわかんないけど、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1aceb8</PointerOffset>
      <JapaneseText>リリスがそういうならそれでいいや。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acedc</PointerOffset>
      <JapaneseText>よーし、Ｓ．Ｄ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1aceed</PointerOffset>
      <JapaneseText>ディムロスの代わりに、見せてやるよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acf12</PointerOffset>
      <JapaneseText>おれがどれだけ、剣がうまくなったかをさ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acf3b</PointerOffset>
      <JapaneseText>どうだい、この速さ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acf50</PointerOffset>
      <JapaneseText>前とはぜんぜん違うんだぜ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acf6b</PointerOffset>
      <JapaneseText>きっとディムロスだったら、驚くはずだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acf92</PointerOffset>
      <JapaneseText>な、リリス。お前もそう思うだろう？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acfb5</PointerOffset>
      <JapaneseText>そ、そうかもね。あはは。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acfce</PointerOffset>
      <JapaneseText>技の研究だって、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acfdf</PointerOffset>
      <JapaneseText>毎日やってるんだぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1acff4</PointerOffset>
      <JapaneseText>魔神剣の切り</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
