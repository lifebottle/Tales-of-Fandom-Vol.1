<SceneText>
  <FriendlyName>Conversation_0111</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x1c2e88</PointerOffset>
      <JapaneseText>大変です！　事件です！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1c2e9f</PointerOffset>
      <JapaneseText>キールが捕まってしまいました！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1c2ec0</PointerOffset>
      <JapaneseText>容疑は、特級学士認定試験の問題を</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1c2ee1</PointerOffset>
      <JapaneseText>教授の部屋から盗み出したって事。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1c2f03</PointerOffset>
      <JapaneseText>問題が保管してある部屋に、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1c2f1e</PointerOffset>
      <JapaneseText>キールのペンが落ちていたというのです！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1c2f46</PointerOffset>
      <JapaneseText>過去何回か、金庫の中の試験問題に</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1c2f67</PointerOffset>
      <JapaneseText>誰かが触れた形跡があって気になっていたが</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1c2f90</PointerOffset>
      <JapaneseText>まさか問題が漏洩していたとはな……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1c2fb6</PointerOffset>
      <JapaneseText>バカな！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1c2fbf</PointerOffset>
      <JapaneseText>僕はそんなことはしていない！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1c2fde</PointerOffset>
      <JapaneseText>それを決めるのは君ではない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
