      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>568935</PointerOffset>
      <JapaneseText>どうしたんだよ、アミィ。元気ねえな。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>568972</PointerOffset>
      <JapaneseText>ババア連中になんか言われたのか？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>569005</PointerOffset>
      <JapaneseText>……ううん、そうじゃないよ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>569034</PointerOffset>
      <JapaneseText>じゃあ、なんだよ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>569054</PointerOffset>
      <JapaneseText>クレスたちのことを正直に話す</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>569084</PointerOffset>
      <JapaneseText>クレスたちのことを例え話にする</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>569116</PointerOffset>
      <JapaneseText>黙っている</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>569128</PointerOffset>
      <JapaneseText>お兄ちゃん、「アニマーゴ」ってお店、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>569165</PointerOffset>
      <JapaneseText>知ってる？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>569176</PointerOffset>
      <JapaneseText>ちぇっ、そういうことかよ。</JapaneseText>
