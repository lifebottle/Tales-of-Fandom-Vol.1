      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1e6d5f</PointerOffset>
      <JapaneseText>う〜ん。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1e6d6c</PointerOffset>
      <JapaneseText>誰がどこの部屋に住んでるのか、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1e6d8b</PointerOffset>
      <JapaneseText>リストみたいなものが無いとわからないな。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1e6db4</PointerOffset>
      <JapaneseText>サンクの部屋は……２０３号室ね。</JapaneseText>
      <EnglishText> </EnglishText>
