    </Entry>
    <Entry>
      <PointerOffset>0x1e6ced</PointerOffset>
      <JapaneseText>そうだ。キールの友達のサンクなら</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1e6d0e</PointerOffset>
