<SceneText>
  <FriendlyName>Conversation_0151</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x214cb8</PointerOffset>
      <JapaneseText>名探偵ポイント</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214cc7</PointerOffset>
      <JapaneseText>まいったな、留守かな……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214ce4</PointerOffset>
      <JapaneseText>ルナリアの部屋</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214cf3</PointerOffset>
      <JapaneseText>は、はい……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214d06</PointerOffset>
      <JapaneseText>新聞部のルナリアさんですよね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214d27</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214d36</PointerOffset>
      <JapaneseText>突然ごめんなさい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214d4c</PointerOffset>
      <JapaneseText>探偵部のプリムラですけど、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214d67</PointerOffset>
      <JapaneseText>ちょっとお話しをききたくって。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214d88</PointerOffset>
      <JapaneseText>あ、あの……</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214d95</PointerOffset>
      <JapaneseText>い、いまちょっと取り込み中だから。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214db9</PointerOffset>
      <JapaneseText>『？？？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214dc2</PointerOffset>
      <JapaneseText>この子……』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214dd3</PointerOffset>
      <JapaneseText>ルナリアさんじゃないのでは？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214df1</PointerOffset>
      <JapaneseText>どうして震えてるのかしら？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214e0d</PointerOffset>
      <JapaneseText>『ううん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214e1c</PointerOffset>
      <JapaneseText>「姿なき晶霊術士」事件が解決したとき</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214e41</PointerOffset>
      <JapaneseText>確かにこの子、自分でルナリアって言ってた</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214e6a</PointerOffset>
      <JapaneseText>……どうしてこんなに震えてるの？』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214e8e</PointerOffset>
      <JapaneseText>『すごく顔色が悪いわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214ea5</PointerOffset>
      <JapaneseText>どう考えてもヘン！』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214ebd</PointerOffset>
      <JapaneseText>こ、この前の爆弾事件は</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214ed4</PointerOffset>
      <JapaneseText>お手柄だったね！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214ee8</PointerOffset>
      <JapaneseText>犯人がまさか双子だったなんて驚き！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214f0c</PointerOffset>
      <JapaneseText>『……ん？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214f1b</PointerOffset>
      <JapaneseText>目で合図を送ってる……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214f35</PointerOffset>
      <JapaneseText>部屋の中に誰かいるの……？』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214f54</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214f63</PointerOffset>
      <JapaneseText>は、犯人が双子なら</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214f76</PointerOffset>
      <JapaneseText>アリバイ作るのは簡単だもんね！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214f97</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214fa2</PointerOffset>
      <JapaneseText>そうね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214faf</PointerOffset>
      <JapaneseText>でも、晶霊爆弾がしゃがんでいれば</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214fd0</PointerOffset>
      <JapaneseText>火傷しないっていうのは</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x214fea</PointerOffset>
      <JapaneseText>さすがに気がつかなかったわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215009</PointerOffset>
      <JapaneseText>しゃがんでいると……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215023</PointerOffset>
      <JapaneseText>そう。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x21502a</PointerOffset>
      <JapaneseText>……じゃあ、また明日にでも。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215049</PointerOffset>
      <JapaneseText>うん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215054</PointerOffset>
      <JapaneseText>すぅー……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215065</PointerOffset>
      <JapaneseText>偉大なる晶霊よ、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215076</PointerOffset>
      <JapaneseText>私に力を――</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215087</PointerOffset>
      <JapaneseText>ファイアーボールッ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x21509f</PointerOffset>
      <JapaneseText>ルナリア！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2150aa</PointerOffset>
      <JapaneseText>大丈夫！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2150b9</PointerOffset>
      <JapaneseText>けほっ、けほっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2150ca</PointerOffset>
      <JapaneseText>上のほう狙ってくれたからなんとか、ね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2150f2</PointerOffset>
      <JapaneseText>うっ、ううっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215101</PointerOffset>
      <JapaneseText>いきなりブッ放すとはなんてヤツだ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215125</PointerOffset>
      <JapaneseText>畜生、お前もぶっ殺してやる！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215142</PointerOffset>
      <JapaneseText>うおーーーっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>50</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215155</PointerOffset>
      <JapaneseText>プリムラ、危ないっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>51</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x21516c</PointerOffset>
      <JapaneseText>しぶといわね！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>52</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x21517e</PointerOffset>
      <JapaneseText>ファイアーボールを撃つ</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>53</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215196</PointerOffset>
      <JapaneseText>ウィンドカッターを撃つ</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>54</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2151ae</PointerOffset>
      <JapaneseText>身をかわす</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>55</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2151ba</PointerOffset>
      <JapaneseText>ま、間に合わないっ！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>56</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2151d4</PointerOffset>
      <JapaneseText>うりゃあーーーっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>57</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2151ea</PointerOffset>
      <JapaneseText>きゃーっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>58</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2151f8</PointerOffset>
      <JapaneseText>プ、プリムラーっ！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>59</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x21520f</PointerOffset>
      <JapaneseText>けっけっけ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>60</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x21521f</PointerOffset>
      <JapaneseText>騒ぎを聞きつけて人が集まる前に</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>61</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x21523e</PointerOffset>
      <JapaneseText>一気に終わらせてやるぜ〜〜〜。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>62</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x21525f</PointerOffset>
      <JapaneseText>う、ううう……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>63</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215273</PointerOffset>
      <JapaneseText>せやっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>64</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x21527f</PointerOffset>
      <JapaneseText>くそっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>65</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215289</PointerOffset>
      <JapaneseText>だがいつまでも逃げ回れると思うなよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>66</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2152af</PointerOffset>
      <JapaneseText>せやっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>67</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2152bb</PointerOffset>
      <JapaneseText>疲れてきたな？　次でおしまいだ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>68</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2152dd</PointerOffset>
      <JapaneseText>うおりゃあああ〜〜！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>69</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2152f5</PointerOffset>
      <JapaneseText>せやっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>70</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215302</PointerOffset>
      <JapaneseText>はあ、はあ、はあ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>71</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x21531c</PointerOffset>
      <JapaneseText>本ばっか読んでるモヤシっ子が</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>72</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215339</PointerOffset>
      <JapaneseText>いつまでも俺様の攻撃をかわせるかよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>73</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x21535f</PointerOffset>
      <JapaneseText>はあ、はあ。本をバカにすると、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>74</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x21537e</PointerOffset>
      <JapaneseText>本にしかえしされるわよ……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>75</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x21539d</PointerOffset>
      <JapaneseText>なにぃ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>76</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2153aa</PointerOffset>
      <JapaneseText>あなたがいま立っている場所。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>77</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2153c7</PointerOffset>
      <JapaneseText>横に本棚があるわよね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>78</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2153e1</PointerOffset>
      <JapaneseText>その隣にも本棚。また隣に本棚。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>79</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215402</PointerOffset>
      <JapaneseText>私のところまで連なった本棚。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>80</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x21541f</PointerOffset>
      <JapaneseText>で、私の隣のをこうやって……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>81</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215440</PointerOffset>
      <JapaneseText>倒すと……！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>82</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215454</PointerOffset>
      <JapaneseText>う、うわ〜〜〜！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>83</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215468</PointerOffset>
      <JapaneseText>うぎゃ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>84</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215475</PointerOffset>
      <JapaneseText>やったぁ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>85</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215484</PointerOffset>
      <JapaneseText>見たか！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>86</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x21548d</PointerOffset>
      <JapaneseText>これぞプリムラ式連鎖的本棚崩壊術！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>87</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2154b1</PointerOffset>
      <JapaneseText>ありがとう！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>88</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2154be</PointerOffset>
      <JapaneseText>いきなり部屋に踏み込まれちゃって……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>89</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2154e6</PointerOffset>
      <JapaneseText>危ないところにあなたが来てくれて</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>90</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215507</PointerOffset>
      <JapaneseText>本当に助かったわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>91</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x21551d</PointerOffset>
      <JapaneseText>一体何の騒ぎだ！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>92</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215533</PointerOffset>
      <JapaneseText>誰かの悲鳴が聞こえたわよ！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>93</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215552</PointerOffset>
      <JapaneseText>……ゴメン、時間が無いの。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>94</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x21556f</PointerOffset>
      <JapaneseText>あなたが調べていた不正入学の事、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>95</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215590</PointerOffset>
      <JapaneseText>パパパッと聞かせてくれない？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>96</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2155af</PointerOffset>
      <JapaneseText>う、うん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>97</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2155be</PointerOffset>
      <JapaneseText>私も調べ始めたばっかりなんだけど、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>98</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2155e2</PointerOffset>
      <JapaneseText>貴族やお金持ちの子供を中心に、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>99</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215601</PointerOffset>
      <JapaneseText>結構な数の不正入学があるらしいの。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>100</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215625</PointerOffset>
      <JapaneseText>その情報の出所は！？　証拠は！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>101</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215648</PointerOffset>
      <JapaneseText>カフェで知り合った男の子が酔って、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>102</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x21566c</PointerOffset>
      <JapaneseText>「自分は不正入学した。罪深い男だ。」</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>103</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215691</PointerOffset>
      <JapaneseText>って言ってたのよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>104</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2156a7</PointerOffset>
      <JapaneseText>名前を教えて！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>105</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2156ba</PointerOffset>
      <JapaneseText>それが……私も酔っ払ってたから。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>106</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2156dc</PointerOffset>
      <JapaneseText>あれから毎日カフェに行って</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>107</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2156f7</PointerOffset>
      <JapaneseText>もう一回会えないかな〜、なんて。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>108</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x215719</PointerOffset>
      <JapaneseText>結構カッコイイ子だったし……ウフフ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>109</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
