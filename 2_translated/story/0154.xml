<SceneText>
  <FriendlyName>Conversation_0154</FriendlyName>
  <Title>名探偵ポイント</Title>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <PointerOffset>0x217ef8</PointerOffset>
      <JapaneseText>名探偵ポイント</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x217f07</PointerOffset>
      <JapaneseText>はあ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x217f0e</PointerOffset>
      <JapaneseText>シルフの君……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x217f22</PointerOffset>
      <JapaneseText>も〜〜〜〜！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x217f33</PointerOffset>
      <JapaneseText>人ひとりの運命がかかってるんだから</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x217f56</PointerOffset>
      <JapaneseText>なんとか思い出してよぉ〜〜！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x217f75</PointerOffset>
      <JapaneseText>彼の口癖は、こう。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x217f88</PointerOffset>
      <JapaneseText>『恋は失われるが、愛はその逆』。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x217faa</PointerOffset>
      <JapaneseText>ああ、シルフの君……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x217fc4</PointerOffset>
      <JapaneseText>もうっ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x217fcd</PointerOffset>
      <JapaneseText>じゃ、後始末はよろしくねっ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x217fec</PointerOffset>
      <JapaneseText>……それにしても。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x217fff</PointerOffset>
      <JapaneseText>風の宮殿って、いったいどこの事？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x218021</PointerOffset>
      <JapaneseText>風……シルフ……？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x218037</PointerOffset>
      <JapaneseText>うわーん！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x218042</PointerOffset>
      <JapaneseText>キールに聴いてみたほうがいいのかな！？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
