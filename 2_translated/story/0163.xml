<SceneText>
  <FriendlyName>Conversation_0163</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x2257e8</PointerOffset>
      <JapaneseText>近き者はその目に見よ、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2257ff</PointerOffset>
      <JapaneseText>遠き者は耳に聞け！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x225815</PointerOffset>
      <JapaneseText>我が名はロエン・ラーモア！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x225830</PointerOffset>
      <JapaneseText>栄光あるインフェリアの衛兵隊長だ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x225854</PointerOffset>
      <JapaneseText>もう安心だ、ミンツの民よ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x225871</PointerOffset>
      <JapaneseText>俺が来たからには、犯罪者どもに</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x225890</PointerOffset>
      <JapaneseText>でかい面はさせんぞ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2258a8</PointerOffset>
      <JapaneseText>なぜなら俺は正義の使者、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2258c1</PointerOffset>
      <JapaneseText>ロエン・ラーモアだからだッ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2258e0</PointerOffset>
      <JapaneseText>……ウム、我ながら決まったな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2258ff</PointerOffset>
      <JapaneseText>また伝説を作ってしまった……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x225920</PointerOffset>
      <JapaneseText>いつかアレンデ姫のお耳に届けば</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x22593f</PointerOffset>
      <JapaneseText>好感度アップ間違いなし！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x22595a</PointerOffset>
      <JapaneseText>オラ、とっとと歩かんか犯罪者ども！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x22597d</PointerOffset>
      <JapaneseText>ふっふっふ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x22598e</PointerOffset>
      <JapaneseText>うわーっはっはっは！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2259a6</PointerOffset>
      <JapaneseText>その後、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2259af</PointerOffset>
      <JapaneseText>キールの姿を見た者はいない……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2259d9</PointerOffset>
      <JapaneseText>っと！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2259e4</PointerOffset>
      <JapaneseText>きゃっ！　離してよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2259fc</PointerOffset>
      <JapaneseText>女の子に乱暴なまねはしたくないが、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x225a1f</PointerOffset>
      <JapaneseText>晶霊術の直撃はもっとゴメンだね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x225a41</PointerOffset>
      <JapaneseText>失望したよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x225a4e</PointerOffset>
      <JapaneseText>君がこんなにつまらない子だったなんて。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x225a76</PointerOffset>
      <JapaneseText>たった一回のキスなんて、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x225a8f</PointerOffset>
      <JapaneseText>遊びみたいなものじゃないか！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x225aae</PointerOffset>
      <JapaneseText>「証拠」の件は忘れてくれ。さよなら！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
