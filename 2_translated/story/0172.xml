<SceneText>
  <FriendlyName>Conversation_0172</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x23979b</PointerOffset>
      <JapaneseText>フンフフンフン〜♪</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2397ae</PointerOffset>
      <JapaneseText>エッグベア香草焼きは火加減が命！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2397d0</PointerOffset>
      <JapaneseText>うりゃ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2397d9</PointerOffset>
      <JapaneseText>うりゃうりゃうりゃ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2397f1</PointerOffset>
      <JapaneseText>ふう。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2397fd</PointerOffset>
      <JapaneseText>材料費結構高くついたけど、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239818</PointerOffset>
      <JapaneseText>ま、おめでたい出所祝いだもんね！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x23983a</PointerOffset>
      <JapaneseText>あ……出所っていうのは変かな？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239859</PointerOffset>
      <JapaneseText>えへへ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239866</PointerOffset>
      <JapaneseText>ん？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239870</PointerOffset>
      <JapaneseText>すみませーん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x23987f</PointerOffset>
      <JapaneseText>キールさんからのお届けものですけど〜。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2398a7</PointerOffset>
      <JapaneseText>アレレ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2398b0</PointerOffset>
      <JapaneseText>クレーメルトークが……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2398cb</PointerOffset>
      <JapaneseText>ドアを先に開ける</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2398dd</PointerOffset>
      <JapaneseText>クレーメルトークに出る</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2398f5</PointerOffset>
      <JapaneseText>はいはいはいはい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239908</PointerOffset>
      <JapaneseText>ちょっとお待ちくださいね〜。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239927</PointerOffset>
      <JapaneseText>お待たせしました……</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x23993c</PointerOffset>
      <JapaneseText>きゃあっ！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x23994d</PointerOffset>
      <JapaneseText>はい。プリムラです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239965</PointerOffset>
      <JapaneseText>――聞こえるか！　僕だ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239980</PointerOffset>
      <JapaneseText>ふわー。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239989</PointerOffset>
      <JapaneseText>サンクの部屋を離れると音が――</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2399aa</PointerOffset>
      <JapaneseText>捜査はどうなってるんだ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2399c3</PointerOffset>
      <JapaneseText>もう教授会は終わってしまったぞ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2399e5</PointerOffset>
      <JapaneseText>どうなってるもなにも、もう解決よ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239a09</PointerOffset>
      <JapaneseText>それよりあなた、いまどこにいるの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239a2c</PointerOffset>
      <JapaneseText>早くしないと料理が冷めちゃうよー。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239a50</PointerOffset>
      <JapaneseText>なにを言っているんだ！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239a69</PointerOffset>
      <JapaneseText>僕はまだ実験室に監禁されたままだ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239a8d</PointerOffset>
      <JapaneseText>えーっ！？　なんで！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239aa4</PointerOffset>
      <JapaneseText>証拠の試験用紙、渡しておいたのに！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239ac8</PointerOffset>
      <JapaneseText>渡した？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239ad3</PointerOffset>
      <JapaneseText>誰に渡したんだ！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239ae9</PointerOffset>
      <JapaneseText>ア、アルジェント教授に……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239b08</PointerOffset>
      <JapaneseText>やられた！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239b17</PointerOffset>
      <JapaneseText>証拠が教授会に渡っていないとなると</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239b3a</PointerOffset>
      <JapaneseText>考えられるのはただひとつ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239b57</PointerOffset>
      <JapaneseText>教授もきっとグルなんだ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239b72</PointerOffset>
      <JapaneseText>えーーーーっ！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239b87</PointerOffset>
      <JapaneseText>きゃーっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239b96</PointerOffset>
      <JapaneseText>プリムラ！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x239ba3</PointerOffset>
      <JapaneseText>プリムラーーッ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
