    <Entry>
      <PointerOffset>0x2483fa</PointerOffset>
      <JapaneseText>犯罪者を引き取りに</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>192</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x24840d</PointerOffset>
      <JapaneseText>今晩中にでもやってくるらしい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>193</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x24842e</PointerOffset>
      <JapaneseText>……覚悟決めるしかないわね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>194</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x24844d</PointerOffset>
      <JapaneseText>覚悟……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>195</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x248458</PointerOffset>
      <JapaneseText>お、おい！　まさか……！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>196</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x248473</PointerOffset>
      <JapaneseText>それしか手がないなら</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>197</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x248488</PointerOffset>
      <JapaneseText>しかたないでしょう？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>198</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2484a0</PointerOffset>
      <JapaneseText>無茶だ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>199</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2484a9</PointerOffset>
      <JapaneseText>貴族の館に侵入なんかできっこない！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>200</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2484cd</PointerOffset>
      <JapaneseText>高い塀に見張りの番犬に……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>201</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2484ec</PointerOffset>
      <JapaneseText>「評議会」の黒幕だとしたら</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>202</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x248507</PointerOffset>
      <JapaneseText>それどころじゃすまないかもしれない！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>203</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x24852d</PointerOffset>
      <JapaneseText>危険過ぎる。命を落とすぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>204</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x24854a</PointerOffset>
      <JapaneseText>私の相棒のセリフなんだけどね――</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>205</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x24856c</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>206</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x24857a</PointerOffset>
      <JapaneseText>真実を得るためならば、私は戦う。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>207</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x24859c</PointerOffset>
      <JapaneseText>子猫ちゃん……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>208</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2485b0</PointerOffset>
      <JapaneseText>それにさ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>209</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2485bb</PointerOffset>
      <JapaneseText>秘密兵器もあることだしねっ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>210</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2485da</PointerOffset>
      <JapaneseText>秘密兵器……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>211</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x24861f</PointerOffset>
      <JapaneseText>よ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>212</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x248625</PointerOffset>
      <JapaneseText>昔から言うじゃないか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>213</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x24863c</PointerOffset>
      <JapaneseText>色男、金と力はナントヤラ、ってさ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>214</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x248660</PointerOffset>
      <JapaneseText>くすん……もうだめだわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>215</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x24867b</PointerOffset>
      <JapaneseText>せっかく頑張ってきたのに、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>216</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x248698</PointerOffset>
      <JapaneseText>こんなところで誰にも知られず</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>217</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2486b5</PointerOffset>
      <JapaneseText>殺されちゃうなんて……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>218</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2486d0</PointerOffset>
      <JapaneseText>しくしく……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>219</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2486e3</PointerOffset>
      <JapaneseText>ひっひっひ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>220</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2486f4</PointerOffset>
      <JapaneseText>女のクセに探偵なんか気取ってるから</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>221</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x248717</PointerOffset>
      <JapaneseText>こういう目にあうんだよ、バカが！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>222</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x248739</PointerOffset>
      <JapaneseText>女は家に引っ込んで、皿でも洗ってりゃ</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>223</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x24875e</PointerOffset>
      <JapaneseText>いいんだよー！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>224</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x248771</PointerOffset>
      <JapaneseText>ん〜〜〜？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>225</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x24877c</PointerOffset>
      <JapaneseText>怖いかぁ〜〜？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>226</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x24878f</PointerOffset>
      <JapaneseText>『しめた！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>227</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x24879a</PointerOffset>
      <JapaneseText>顔を近づけてきた……！』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>228</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2487b5</PointerOffset>
      <JapaneseText>頭突きを食らわせる</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>229</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2487c9</PointerOffset>
      <JapaneseText>顔に唾をはきかける</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>230</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2487dd</PointerOffset>
      <JapaneseText>どりゃーっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>231</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2487ee</PointerOffset>
      <JapaneseText>ぐわっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>232</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2487fb</PointerOffset>
      <JapaneseText>こ、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>233</Id>
      <Status>To Do</Status>
    </Entry>
