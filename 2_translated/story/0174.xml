      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2473d7</PointerOffset>
      <JapaneseText>泣きまねをする</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2473ea</PointerOffset>
      <JapaneseText>ちょっとそこのバカ面！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x247401</PointerOffset>
      <JapaneseText>あんたあんた！　アンタのことよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x247423</PointerOffset>
      <JapaneseText>「お荷物デース」なんて古典的な</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x247442</PointerOffset>
      <JapaneseText>不意打ちかましてくれちゃってさ、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x247464</PointerOffset>
      <JapaneseText>正面からじゃ女の子とも戦えないわけ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x24748a</PointerOffset>
      <JapaneseText>ふっふっふ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x247497</PointerOffset>
      <JapaneseText>威勢のいいお姉ちゃんだな。</JapaneseText>
