<SceneText>
  <FriendlyName>Conversation_0184</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x253fbb</PointerOffset>
      <JapaneseText>うわ―……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x253fc8</PointerOffset>
      <JapaneseText>捕まっちゃった……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x253fe0</PointerOffset>
      <JapaneseText>貴様バカか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x253fed</PointerOffset>
      <JapaneseText>貴族の館に殴り込むとはな！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x25400a</PointerOffset>
      <JapaneseText>失礼ね！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x254013</PointerOffset>
      <JapaneseText>殴り込んだんじゃなくて忍びこんだのよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x25403b</PointerOffset>
      <JapaneseText>うるせえ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x25404a</PointerOffset>
      <JapaneseText>とにかくこれだけ派手にやったんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x25406d</PointerOffset>
      <JapaneseText>覚悟はできてるんだろうな？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x25408a</PointerOffset>
      <JapaneseText>もう小細工はさせねえ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2540a1</PointerOffset>
      <JapaneseText>一気にぶった切ってやる！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2540bc</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2540c7</PointerOffset>
      <JapaneseText>ば、万事休すか……</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2540dd</PointerOffset>
      <JapaneseText>キール……！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2540ee</PointerOffset>
      <JapaneseText>待てっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x254109</PointerOffset>
      <JapaneseText>だ、だれっ！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x25411c</PointerOffset>
      <JapaneseText>正義の味方、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x254129</PointerOffset>
      <JapaneseText>とでもいっておこうか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x254143</PointerOffset>
      <JapaneseText>たぁーっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x254152</PointerOffset>
      <JapaneseText>ぎゃー！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x25415f</PointerOffset>
      <JapaneseText>うわー！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x25416c</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x254177</PointerOffset>
      <JapaneseText>さあ、早く逃げたまえ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x254191</PointerOffset>
      <JapaneseText>あ、ありがとうございます。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2541ac</PointerOffset>
      <JapaneseText>あなたは一体？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2541bf</PointerOffset>
      <JapaneseText>「評議会」の事は任せておけ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2541dc</PointerOffset>
      <JapaneseText>君の友人も悪いようにはしない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2541fd</PointerOffset>
      <JapaneseText>私の事は……忘れたほうがいい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x25421c</PointerOffset>
      <JapaneseText>……さらばだ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x25422f</PointerOffset>
      <JapaneseText>いったい誰だったのかしら……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
