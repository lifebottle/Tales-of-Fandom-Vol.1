<SceneText>
  <FriendlyName>Conversation_0190</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x266b00</PointerOffset>
      <JapaneseText>…………！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266b0f</PointerOffset>
      <JapaneseText>なんだ！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266b1a</PointerOffset>
      <JapaneseText>い、いまの輝きは一体……！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266b35</PointerOffset>
      <JapaneseText>……あれ？　あれれれ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266b4c</PointerOffset>
      <JapaneseText>なんか傷、治っちゃってるんですけど！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266b74</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266b7f</PointerOffset>
      <JapaneseText>わ、笑うなよ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266b92</PointerOffset>
      <JapaneseText>ま、ま、まさかとは思うが、いま一瞬、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266bb7</PointerOffset>
      <JapaneseText>大晶霊の姿が見えたような気が……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266bdb</PointerOffset>
      <JapaneseText>大晶霊？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266be4</PointerOffset>
      <JapaneseText>あははははは！　まっさかぁ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266c03</PointerOffset>
      <JapaneseText>い、いや。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266c0e</PointerOffset>
      <JapaneseText>でも、この大規模な現象はどう考えても……</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266c37</PointerOffset>
      <JapaneseText>そういうのって自意識過剰っていうのよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266c5f</PointerOffset>
      <JapaneseText>大晶霊が、人間なんかを助けるために</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266c82</PointerOffset>
      <JapaneseText>いちいち現れるわけないじゃない！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266ca4</PointerOffset>
      <JapaneseText>それともなに？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266cb3</PointerOffset>
      <JapaneseText>あなたは世界を救う英雄かなにかなの！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266cdb</PointerOffset>
      <JapaneseText>い、いや、そういうわけじゃ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266cfd</PointerOffset>
      <JapaneseText>ま、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266d02</PointerOffset>
      <JapaneseText>さっきはちょっと英雄っぽかったけどさ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266d29</PointerOffset>
      <JapaneseText>ん？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266d2e</PointerOffset>
      <JapaneseText>ドラゴンから逃げなかったとき。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266d4d</PointerOffset>
      <JapaneseText>ちょっとだけかっこよかった。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266d6c</PointerOffset>
      <JapaneseText>プリムラ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266d7f</PointerOffset>
      <JapaneseText>パンツの件、忘れてあげる。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266d9f</PointerOffset>
      <JapaneseText>ま、まだ覚えてたのかっ！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266dbc</PointerOffset>
      <JapaneseText>あははは！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266dcb</PointerOffset>
      <JapaneseText>あーあ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266dd4</PointerOffset>
      <JapaneseText>あんなヤツらに手を貸しちゃって。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266df6</PointerOffset>
      <JapaneseText>ほんとウンディーネって</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266e0d</PointerOffset>
      <JapaneseText>お人よしだなあ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266e21</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266e30</PointerOffset>
      <JapaneseText>キール・ツァイベル。いずれは</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266e4d</PointerOffset>
      <JapaneseText>いま起こりつつあるこの大異変から</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266e6f</PointerOffset>
      <JapaneseText>エターニア世界を守る人間……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266e90</PointerOffset>
      <JapaneseText>今回は、特別ですよ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266eab</PointerOffset>
      <JapaneseText>静まれ静まれーーーい！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266ec4</PointerOffset>
      <JapaneseText>あー？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266ecb</PointerOffset>
      <JapaneseText>なに、アンタ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266ede</PointerOffset>
      <JapaneseText>フッ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266eed</PointerOffset>
      <JapaneseText>近き者はその目に見よ、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266f04</PointerOffset>
      <JapaneseText>遠き者は耳に聞け！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266f1a</PointerOffset>
      <JapaneseText>我が名はロエン・ラーモア！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266f35</PointerOffset>
      <JapaneseText>栄光あるインフェリアの衛兵隊長だ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266f59</PointerOffset>
      <JapaneseText>ロエン殿！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266f68</PointerOffset>
      <JapaneseText>あやつが警備兵の目をくらませて</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266f87</PointerOffset>
      <JapaneseText>逃げ出した窃盗犯、キールです！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266fa8</PointerOffset>
      <JapaneseText>さっさと捕まえて王都に！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266fc3</PointerOffset>
      <JapaneseText>言われるまでもない！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266fd8</PointerOffset>
      <JapaneseText>犯罪者め、覚悟しろよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>50</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266ff2</PointerOffset>
      <JapaneseText>くっ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>51</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x266ffd</PointerOffset>
      <JapaneseText>この世に正義はないのか！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>52</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267018</PointerOffset>
      <JapaneseText>ロエン様、ロエン様―！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>53</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267032</PointerOffset>
      <JapaneseText>なんだ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>54</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26703f</PointerOffset>
      <JapaneseText>旅の商人と名乗る男が、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>55</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267056</PointerOffset>
      <JapaneseText>ロエン様にこの書状を至急とのことで。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>56</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26707c</PointerOffset>
      <JapaneseText>なにっ？　旅の商人だと？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>57</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267095</PointerOffset>
      <JapaneseText>貸せ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>58</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2670a1</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>59</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2670b0</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>60</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2670bf</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>61</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2670ce</PointerOffset>
      <JapaneseText>なるほどな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>62</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2670db</PointerOffset>
      <JapaneseText>おい、アルジェントとやら。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>63</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2670f8</PointerOffset>
      <JapaneseText>え？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>64</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267102</PointerOffset>
      <JapaneseText>どうやら王都行きは貴様のほうらしいな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>65</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26712a</PointerOffset>
      <JapaneseText>「評議会」とやらの秘密、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>66</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267143</PointerOffset>
      <JapaneseText>洗いざらい話してもらうぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>67</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267160</PointerOffset>
      <JapaneseText>ば、ばかな！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>68</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26716d</PointerOffset>
      <JapaneseText>一体何の証拠があって――</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>69</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267188</PointerOffset>
      <JapaneseText>黙れ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>70</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26718f</PointerOffset>
      <JapaneseText>我が友の調査に間違いはない！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>71</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2671ae</PointerOffset>
      <JapaneseText>よし、しょっぴけ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>72</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2671c1</PointerOffset>
      <JapaneseText>館の周りも固めておけよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>73</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2671dc</PointerOffset>
      <JapaneseText>ひいっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>74</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2671e5</PointerOffset>
      <JapaneseText>た、助けて！　助けてくれー！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>75</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267204</PointerOffset>
      <JapaneseText>大学の地位が……</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>76</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267215</PointerOffset>
      <JapaneseText>大学の地位がーーーーっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>77</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267230</PointerOffset>
      <JapaneseText>待ってください、ロエンさん！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>78</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26724f</PointerOffset>
      <JapaneseText>んー？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>79</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26725b</PointerOffset>
      <JapaneseText>キールは無罪です。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>80</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267271</PointerOffset>
      <JapaneseText>「評議会」という犯罪結社の陰謀に</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>81</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267292</PointerOffset>
      <JapaneseText>巻き込まれただけなんです！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>82</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2672af</PointerOffset>
      <JapaneseText>アルジェント教授もグルなんです！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>83</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2672d1</PointerOffset>
      <JapaneseText>証拠はここにあります！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>84</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2672eb</PointerOffset>
      <JapaneseText>この書類に不正入学や試験漏洩の事が</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>85</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26730e</PointerOffset>
      <JapaneseText>ぜんぶ書かれています！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>86</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267328</PointerOffset>
      <JapaneseText>でたらめだ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>87</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267339</PointerOffset>
      <JapaneseText>ロエン殿、よもやそのような学生の</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>88</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26735a</PointerOffset>
      <JapaneseText>世迷い事を――</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>89</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26736c</PointerOffset>
      <JapaneseText>安心しろ。こんなガキの言うことを</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>90</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26738d</PointerOffset>
      <JapaneseText>いちいち聞くほど俺は暇ではない！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>91</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2673bf</PointerOffset>
      <JapaneseText>そうでしょう、そうでしょう！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>92</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2673dc</PointerOffset>
      <JapaneseText>うわっはっはっは！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>93</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2673f2</PointerOffset>
      <JapaneseText>だいたいこんな書類など</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>94</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267409</PointerOffset>
      <JapaneseText>いくらでもねつ造できるではないか……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>95</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267431</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>96</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267440</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>97</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26744f</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>98</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26745e</PointerOffset>
      <JapaneseText>おい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>99</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267465</PointerOffset>
      <JapaneseText>この書類、どこで手に入れた？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>100</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267484</PointerOffset>
      <JapaneseText>レイゼン卿の館の隠し部屋でです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>101</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2674a7</PointerOffset>
      <JapaneseText>レイゼン・デストリューク卿か……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>102</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2674cb</PointerOffset>
      <JapaneseText>そういえばレイシスが調べていた。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>103</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2674ec</PointerOffset>
      <JapaneseText>ミンツの犯罪結社の話……。なるほどな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>104</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267514</PointerOffset>
      <JapaneseText>――おい、アルジェントとやら。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>105</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267535</PointerOffset>
      <JapaneseText>は、はい？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>106</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267544</PointerOffset>
      <JapaneseText>どうやら王都行きは貴様のほうらしいな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>107</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26756c</PointerOffset>
      <JapaneseText>「評議会」とやらの秘密、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>108</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267585</PointerOffset>
      <JapaneseText>洗いざらい話してもらうぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>109</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2675a2</PointerOffset>
      <JapaneseText>ば、ばかな！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>110</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2675af</PointerOffset>
      <JapaneseText>一体何の証拠があって――</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>111</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2675ca</PointerOffset>
      <JapaneseText>黙れ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>112</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2675d6</PointerOffset>
      <JapaneseText>よし、しょっぴけ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>113</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2675e9</PointerOffset>
      <JapaneseText>館の周りも固めておけよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>114</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267604</PointerOffset>
      <JapaneseText>ひいっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>115</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26760d</PointerOffset>
      <JapaneseText>た、助けて！　助けてくれー！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>116</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26762c</PointerOffset>
      <JapaneseText>大学の地位が……</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>117</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26763d</PointerOffset>
      <JapaneseText>大学の地位がーーーーっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>118</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267658</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>119</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267667</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>120</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267676</PointerOffset>
      <JapaneseText>終わった、のかな？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>121</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26768c</PointerOffset>
      <JapaneseText>のようだな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>122</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26769d</PointerOffset>
      <JapaneseText>ふふ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>123</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2676a8</PointerOffset>
      <JapaneseText>キール、煤だらけで変な顔！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>124</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2676c5</PointerOffset>
      <JapaneseText>お、お前だって！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>125</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2676d9</PointerOffset>
      <JapaneseText>あははは。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>126</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2676e6</PointerOffset>
      <JapaneseText>でも本当に良かった。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>127</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2676fb</PointerOffset>
      <JapaneseText>一年前の恩返しもできたっぽいし！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>128</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26771c</PointerOffset>
      <JapaneseText>これであなたと私は対等ってことよね！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>129</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267742</PointerOffset>
      <JapaneseText>もうダ・メー探偵だなんて</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>130</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26775b</PointerOffset>
      <JapaneseText>バカにさせないから！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>131</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267773</PointerOffset>
      <JapaneseText>はいはい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>132</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26777e</PointerOffset>
      <JapaneseText>わかりましたよ、名探偵さま。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>133</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26779d</PointerOffset>
      <JapaneseText>よーし！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>134</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2677a6</PointerOffset>
      <JapaneseText>それじゃあ町に戻ってパーッと食事でも――</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>135</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2677d1</PointerOffset>
      <JapaneseText>そうはいかんよ、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>136</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2677e2</PointerOffset>
      <JapaneseText>名探偵殿？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>137</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267801</PointerOffset>
      <JapaneseText>貴様！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>138</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267808</PointerOffset>
      <JapaneseText>どうやって抜け出した！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>139</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267824</PointerOffset>
      <JapaneseText>君だって抜け出したじゃないか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>140</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267845</PointerOffset>
      <JapaneseText>間抜けな見張りをあざむくくらい</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>141</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267864</PointerOffset>
      <JapaneseText>なんということはないさ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>142</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267883</PointerOffset>
      <JapaneseText>護送車に移される際のごたごたを利用して</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>143</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2678aa</PointerOffset>
      <JapaneseText>気持ちよくスルリと抜けさせてもらったよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>144</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2678d3</PointerOffset>
      <JapaneseText>……なんの用かしら！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>145</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2678ed</PointerOffset>
      <JapaneseText>オイオイ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>146</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2678fc</PointerOffset>
      <JapaneseText>君に協力したのは、リベンジの舞台を</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>147</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26791f</PointerOffset>
      <JapaneseText>整えてもらうためだったはずだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>148</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267940</PointerOffset>
      <JapaneseText>そしてリベンジのときは、今だ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>149</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267977</PointerOffset>
      <JapaneseText>あと３０秒で爆発する。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>150</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267991</PointerOffset>
      <JapaneseText>切るべきラインは一本。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>151</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2679a8</PointerOffset>
      <JapaneseText>赤か、白か、黒か。紫か。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>152</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2679c3</PointerOffset>
      <JapaneseText>正解はひとつ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>153</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2679d2</PointerOffset>
      <JapaneseText>単純なルールにしておいたよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>154</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2679f1</PointerOffset>
      <JapaneseText>この前の事件の最後、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>155</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267a06</PointerOffset>
      <JapaneseText>君が切ったラインが今回も正解だ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>156</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267a29</PointerOffset>
      <JapaneseText>単純だろう？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>157</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267a36</PointerOffset>
      <JapaneseText>記憶力の問題さ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>158</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267a4e</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>159</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267a5d</PointerOffset>
      <JapaneseText>……キール？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>160</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267a6e</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>161</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267a79</PointerOffset>
      <JapaneseText>すまない。覚えていない……！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>162</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267aa0</PointerOffset>
      <JapaneseText>赤いラインを切る</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>163</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267ab2</PointerOffset>
      <JapaneseText>白いラインを切る</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>164</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267ac4</PointerOffset>
      <JapaneseText>黒いラインを切る</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>165</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267ad6</PointerOffset>
      <JapaneseText>紫のラインを切る</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>166</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x267aeb</PointerOffset>
      <JapaneseText>うわああーーーーっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>167</Id>
      <Status>To Do</Status>
    </Entry>
