    </Entry>
    <Entry>
      <PointerOffset>0x26d132</PointerOffset>
      <JapaneseText>部長も楽じゃありません。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d14d</PointerOffset>
      <JapaneseText>やぁ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d154</PointerOffset>
      <JapaneseText>名探偵も楽じゃないみたいだな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>50</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d175</PointerOffset>
      <JapaneseText>む〜。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>51</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d181</PointerOffset>
      <JapaneseText>なんかあなたと２人でやってたときのほうが</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>52</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d1aa</PointerOffset>
      <JapaneseText>気楽で良かった気がするよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>53</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d1c7</PointerOffset>
      <JapaneseText>名探偵に泣き言は似合わないぞ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>54</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d1e8</PointerOffset>
      <JapaneseText>ところで……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>55</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d1fb</PointerOffset>
      <JapaneseText>ん？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>56</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d205</PointerOffset>
      <JapaneseText>あのときの解決料金、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>57</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d21a</PointerOffset>
      <JapaneseText>まだもらってなかったわよね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>58</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d239</PointerOffset>
      <JapaneseText>オイオイ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>59</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d244</PointerOffset>
      <JapaneseText>僕からもふんだくる気か！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>60</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d261</PointerOffset>
      <JapaneseText>あたりまえでしょ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>61</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d277</PointerOffset>
      <JapaneseText>ま、身内ってことで特別に</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>62</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d290</PointerOffset>
      <JapaneseText>オマケしてあげてもいいケド。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>63</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d2af</PointerOffset>
      <JapaneseText>助かるよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>64</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d2ba</PointerOffset>
      <JapaneseText>いくらだい？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>65</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d2cb</PointerOffset>
      <JapaneseText>チュー１回。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>66</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d2dc</PointerOffset>
      <JapaneseText>え？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>67</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d2e6</PointerOffset>
      <JapaneseText>なーんでもないっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>68</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d2ff</PointerOffset>
      <JapaneseText>部長！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>69</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d306</PointerOffset>
      <JapaneseText>事件報告書の「経費」のところに</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>70</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d327</PointerOffset>
