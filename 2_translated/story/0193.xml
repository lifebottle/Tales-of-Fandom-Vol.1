    </Entry>
    <Entry>
      <PointerOffset>0x26d3fb</PointerOffset>
      <JapaneseText>ふう。これで僕もようやく、強制助手から</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>79</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d422</PointerOffset>
      <JapaneseText>解放されるってわけだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>80</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d43c</PointerOffset>
      <JapaneseText>――といってキールがいなくなっちゃった</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>81</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d463</PointerOffset>
      <JapaneseText>のは残念だけど……</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>82</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26d479</PointerOffset>
      <JapaneseText>ガッカリしてる暇なんかありません。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>83</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
