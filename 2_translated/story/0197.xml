<SceneText>
  <FriendlyName>Conversation_0197</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x270623</PointerOffset>
      <JapaneseText>うぅぅぅぅぅー。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x270634</PointerOffset>
      <JapaneseText>おいおい……泣いてんのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27064f</PointerOffset>
      <JapaneseText>明日は嵐だな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27065e</PointerOffset>
      <JapaneseText>だぁ！　うっさい、うっさい〜！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27067d</PointerOffset>
      <JapaneseText>チェスターだってこの本読んだら</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27069c</PointerOffset>
      <JapaneseText>ぜーったい泣くもんね！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2706b3</PointerOffset>
      <JapaneseText>あ！　「ユークリッドで泣き濡れて」！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2706d8</PointerOffset>
      <JapaneseText>ミント、知ってんの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2706ed</PointerOffset>
      <JapaneseText>はい、もちろん！　恋愛小説の大家、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x270710</PointerOffset>
      <JapaneseText>ボロボワ・シャムダールの最新刊でしょう？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x270739</PointerOffset>
      <JapaneseText>彼女の「泣き濡れてシリーズ」は</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x270758</PointerOffset>
      <JapaneseText>全巻持っています。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27076b</PointerOffset>
      <JapaneseText>今回はキャベツを選ぶ時のクセがきっかけで</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x270794</PointerOffset>
      <JapaneseText>食材屋と恋に落ちるんですよね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2707b3</PointerOffset>
      <JapaneseText>それと、このヒロインは歴代の中で１番</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2707d8</PointerOffset>
      <JapaneseText>運動神経がよく、背も高いんですよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2707fb</PointerOffset>
      <JapaneseText>そ、そうなんだ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x270810</PointerOffset>
      <JapaneseText>なかなかのマニアだな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x270827</PointerOffset>
      <JapaneseText>いえ、私は山で暮らしていたので、楽しみ</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27084e</PointerOffset>
      <JapaneseText>といえば行商人から買う恋愛小説くらいで。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x270877</PointerOffset>
      <JapaneseText>だからつまり、マニアだな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x270892</PointerOffset>
      <JapaneseText>ってことはミントってば意外と耳年増？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2708b7</PointerOffset>
      <JapaneseText>実践もがんばんないとね〜。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2708d2</PointerOffset>
      <JapaneseText>アーチェさん！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2708e1</PointerOffset>
      <JapaneseText>うしゃしゃしゃしゃ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
