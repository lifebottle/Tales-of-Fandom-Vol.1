<SceneText>
  <FriendlyName>Conversation_0198</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x272a23</PointerOffset>
      <JapaneseText>クラース！　これなーにー？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272a3e</PointerOffset>
      <JapaneseText>さっき、森の中で拾ったんだけどよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272a61</PointerOffset>
      <JapaneseText>ふむ、これは雷の精霊の力を利用した</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272a84</PointerOffset>
      <JapaneseText>エレキギターという楽器だ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272a9f</PointerOffset>
      <JapaneseText>私に貸してみなさい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272ab4</PointerOffset>
      <JapaneseText>すごいじゃん……なんかうっとり。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272ad5</PointerOffset>
      <JapaneseText>アンタにそんな特技があったとはな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272af8</PointerOffset>
      <JapaneseText>あら、なつかしい！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272b0b</PointerOffset>
      <JapaneseText>ミ、ミラルド！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272b1c</PointerOffset>
      <JapaneseText>クラース、またバンドでもやるの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272b3d</PointerOffset>
      <JapaneseText>髪立てて、ばっちりお化粧もして。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272b5e</PointerOffset>
      <JapaneseText>クラースが！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272b6d</PointerOffset>
      <JapaneseText>そうよ。ライブでは空中ダイブなんかも</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272b92</PointerOffset>
      <JapaneseText>やったっけ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272b9f</PointerOffset>
      <JapaneseText>クラースが！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272bae</PointerOffset>
      <JapaneseText>忘れた！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272bb7</PointerOffset>
      <JapaneseText>またまた。クラースの縦ノリギタープレイ</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272bde</PointerOffset>
      <JapaneseText>って当時ちょっとした話題だったじゃない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272c07</PointerOffset>
      <JapaneseText>記憶にない！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272c14</PointerOffset>
      <JapaneseText>なによ！　青春の思い出になるぞ！　なんて</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272c3d</PointerOffset>
      <JapaneseText>人を勝手にマネージャーにしたくせに……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272c66</PointerOffset>
      <JapaneseText>ぜんぶ忘れたっていうの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272c7f</PointerOffset>
      <JapaneseText>だぁ〜もぅ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272c8e</PointerOffset>
      <JapaneseText>それ以上バラすなと言っとるんだ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272caf</PointerOffset>
      <JapaneseText>青春の……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272cbc</PointerOffset>
      <JapaneseText>思い出だって！　くっさ〜。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x272cd7</PointerOffset>
      <JapaneseText>うしゃしゃしゃしゃっ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
