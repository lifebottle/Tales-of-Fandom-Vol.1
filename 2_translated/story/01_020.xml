      <JapaneseText>これ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4400</SpeakerId>
      <Id>58</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>19444</PointerOffset>
