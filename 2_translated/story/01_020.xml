    <Entry>
      <PointerOffset>716</PointerOffset>
      <JapaneseText>トーティスの村
広場</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1108</PointerOffset>
      <JapaneseText>ゴーリ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4300</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1404</PointerOffset>
      <JapaneseText>やあ、アルベイン。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4400</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1652</PointerOffset>
      <JapaneseText>あの子たちか？
バークライト夫妻の遺児というのは。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4300</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1972</PointerOffset>
      <JapaneseText>ああ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4400</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2380</PointerOffset>
      <JapaneseText>あの夫妻が死んでから、ユークリッドで
二人きりで暮らしていたらしい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4400</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2452</PointerOffset>
      <JapaneseText>実家が火事で焼け落ちたんだが、
施設に預けるのもどうかと思ってな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4400</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2748</PointerOffset>
      <JapaneseText>バークライト夫妻の別荘に住まわせるのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4300</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3044</PointerOffset>
      <JapaneseText>夫妻が死んだ以上、
	あの家は子供たちのものだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4400</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3116</PointerOffset>
      <JapaneseText>問題はなかろう？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4400</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3460</PointerOffset>
      <JapaneseText>それはそうだが……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4300</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3932</PointerOffset>
      <JapaneseText>あの子達は、夫妻が死んでからいままで、
どうやって暮らしていたんだ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4300</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4292</PointerOffset>
      <JapaneseText>まあ……いろいろだろう。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4400</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4620</PointerOffset>
      <JapaneseText>いろいろって、
おい、まさか悪い連中と……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4300</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5292</PointerOffset>
      <JapaneseText>縁は切ったといっている。
わしは信じようと思うがな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4400</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5364</PointerOffset>
      <JapaneseText>「信じることから全ては始まる」
……司祭様の教えだろう？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4400</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5788</PointerOffset>
      <JapaneseText>それはそうだが……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4300</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6164</PointerOffset>
      <JapaneseText>決まりだな。
――二人とも、こっちにおいで！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4400</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6548</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>20</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>7676</PointerOffset>
      <JapaneseText>さ、挨拶をしなさい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4400</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7820</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>22</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>7876</PointerOffset>
      <JapaneseText>元気よく挨拶する&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7884</PointerOffset>
      <JapaneseText>おとなしく挨拶する&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7892</PointerOffset>
      <JapaneseText>おしゃまに挨拶する&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7900</PointerOffset>
      <JapaneseText>黙っている&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8348</PointerOffset>
      <JapaneseText>アミィ・バークライトです！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8660</PointerOffset>
      <JapaneseText>今日からお世話になります！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8876</PointerOffset>
      <JapaneseText>お兄ちゃんともども、
どうかよろしくお願いいたします！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9276</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>30</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>9660</PointerOffset>
      <JapaneseText>よいしょ……　ちょっと、ちょっと。
通し、て……っ！　ふう。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10332</PointerOffset>
      <JapaneseText>えへっ……ようこそ、トーティス村へ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10732</PointerOffset>
      <JapaneseText>僕、クレス・アルベイン！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10932</PointerOffset>
      <JapaneseText>君がチェスターだよね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11244</PointerOffset>
      <JapaneseText>同じくらいの年の子が来るって聞いて、
僕、楽しみにしてたんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11852</PointerOffset>
      <JapaneseText>……けっ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12292</PointerOffset>
      <JapaneseText>……お兄ちゃんっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12580</PointerOffset>
      <JapaneseText>――ごめんなさい、アルベインさん！
お兄ちゃんたら、いつもこうで……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13036</PointerOffset>
      <JapaneseText>クレス、でいいよ、アミィちゃん。
お兄さんは、きっと内気なんだね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13380</PointerOffset>
      <JapaneseText>ええ、まあ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13572</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>41</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>13868</PointerOffset>
      <JapaneseText>よーし！　みんな！　今日から二人は
新しくこの村の住民となった！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4300</SpeakerId>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14132</PointerOffset>
      <JapaneseText>互いに助け合い、より良い村にしていこう！
では、解散！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4300</SpeakerId>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14276</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>44</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>14628</PointerOffset>
      <JapaneseText>さあ、おまえたち、
家に案内してやろう。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4400</SpeakerId>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14780</PointerOffset>
      <JapaneseText>寝るぐらいは出来るように
