      <JapaneseText>アミィ・バークライト（幼少）</JapaneseText>
      <EnglishText>Ami Burklight (Young-er)</EnglishText>
      <Notes>Reference only</Notes>
      <Id>3800</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset/>
      <JapaneseText>チェスター・バークライト（幼少）</JapaneseText>
      <EnglishText>Chester Burklight (Young)</EnglishText>
      <Notes>Reference only</Notes>
      <Id>4000</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>204</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>692</PointerOffset>
      <JapaneseText>トーティス
村外れ</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1148</PointerOffset>
      <JapaneseText>あー、楽しかった！
みんな、いい人だよね、お兄ちゃん？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1644</PointerOffset>
      <JapaneseText>どうだかな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1980</PointerOffset>
      <JapaneseText>もう。
お兄ちゃんたら、どうしてそうかなあ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2124</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>5</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>2180</PointerOffset>
      <JapaneseText>クレスへの態度を批判する&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2188</PointerOffset>
      <JapaneseText>クレスを弁護する&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2196</PointerOffset>
      <JapaneseText>皆と仲良くしてと言う&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2748</PointerOffset>
      <JapaneseText>昼間の事だって、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2820</PointerOffset>
      <JapaneseText>クレスさんに、あんな言いかたするのって、
よくないと思うよ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3196</PointerOffset>
      <JapaneseText>何の苦労も知らねえで育ったような
ボンボンに、同情されて喜べってのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3668</PointerOffset>
      <JapaneseText>いいか、アミィ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4076</PointerOffset>
      <JapaneseText>ああいう奴は、他人に同情することで、
いい事をした、って満足してるだけだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4372</PointerOffset>
      <JapaneseText>俺たちは、可哀相なやつだ、って
馬鹿にされてんだ。わかったな？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4924</PointerOffset>
      <JapaneseText>わかったら、
あんな奴となれなれしくすんじゃねえぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5068</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>16</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>5516</PointerOffset>
      <JapaneseText>……なによ、お兄ちゃんのばか。
クレスさんは、そんなんじゃないんだから。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5900</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>18</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>6436</PointerOffset>
      <JapaneseText>クレスさんのことだって、
何であんな態度取るの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6892</PointerOffset>
      <JapaneseText>クレスさん、いい人だよ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7316</PointerOffset>
      <JapaneseText>ハッ！　どうだかな。いい人面して、
俺たちに近づいてきた連中を忘れたのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7916</PointerOffset>
      <JapaneseText>どいつもこいつも、
ハイエナ以下の奴らだったろうが。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8292</PointerOffset>
      <JapaneseText>そうだけど……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8436</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>24</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>8844</PointerOffset>
      <JapaneseText>……でも、クレスさんは違うと思う。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9068</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>26</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>9444</PointerOffset>
      <JapaneseText>クレスさんのこともそうだけど、
もっとみんなと仲良くした方がいいよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9932</PointerOffset>
      <JapaneseText>あたしたち、ここで暮らしていくんだから。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10228</PointerOffset>
      <JapaneseText>こびろってのか？　ごめんだね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10764</PointerOffset>
      <JapaneseText>お兄ちゃん……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10908</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>31</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>11268</PointerOffset>
      <JapaneseText>このままじゃ、いけないよ……やっぱり。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11700</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>33</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>12068</PointerOffset>
      <JapaneseText>何してんだ、早く来いよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12460</PointerOffset>
      <JapaneseText>はーい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12700</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>36</Id>
      <Status>Done</Status>
    </Entry>
  </Strings>
</SceneText>
