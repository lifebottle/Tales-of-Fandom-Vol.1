    <Entry>
      <PointerOffset>780</PointerOffset>
      <JapaneseText>トーティス
村外れ</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1092</PointerOffset>
      <JapaneseText>はあ、はあ、はあ……。おばさんたちって、
何でああいう話が好きかなあ。――ふうっ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2348</PointerOffset>
      <JapaneseText>あ、クレスさんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2692</PointerOffset>
      <JapaneseText>クレ――ス、さ……ん……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3140</PointerOffset>
      <JapaneseText>ほらクレス、こっち来て。
早く、二人っきりになりましょうよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3532</PointerOffset>
      <JapaneseText>あっ、あっ。　で、でも……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4084</PointerOffset>
      <JapaneseText>なあに、男の子でしょ？　ほらあ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4628</PointerOffset>
      <JapaneseText>クレスさん……と、誰……。
見覚えがあるけど……思い出せない……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4852</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>9</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>4940</PointerOffset>
      <JapaneseText>後をつける&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4948</PointerOffset>
      <JapaneseText>家に帰る&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5268</PointerOffset>
      <JapaneseText>どうしよう……でも、
悪い人かもしれないし……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6108</PointerOffset>
      <JapaneseText>――神様ごめんなさい、
アミィは悪い子です！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6292</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>14</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>7436</PointerOffset>
      <JapaneseText>あたしには、関係ないもん……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
