    <Entry>
      <PointerOffset>572</PointerOffset>
      <JapaneseText>トーティス
村外れ</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>996</PointerOffset>
      <JapaneseText>ふう。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1300</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>3</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>1796</PointerOffset>
      <JapaneseText>こんにちは。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2124</PointerOffset>
      <JapaneseText>あ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2508</PointerOffset>
      <JapaneseText>思い出したわ。
あなたは、チェスターの妹でしょ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2964</PointerOffset>
      <JapaneseText>……はい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3404</PointerOffset>
      <JapaneseText>あいつに言っといて、余計なことを
言わないでいてくれてありがとう、って。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3860</PointerOffset>
      <JapaneseText>……もう、いいけど。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4252</PointerOffset>
      <JapaneseText>どういうことですか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4572</PointerOffset>
      <JapaneseText>あんなつまらない男に、
もう用はないってこと。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4868</PointerOffset>
      <JapaneseText>チェスターのことじゃないわよ。
あのクレスってやつ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5436</PointerOffset>
      <JapaneseText>クレスさんは、つまらなくなんか
ありません！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5972</PointerOffset>
      <JapaneseText>へえ……そういうこと。
ま、わたしにはもう、関係ないわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6436</PointerOffset>
      <JapaneseText>――ジム、行ってちょうだい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6644</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>16</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>7092</PointerOffset>
      <JapaneseText>……あんな人、大っ嫌い。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7484</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
