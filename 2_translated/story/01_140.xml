    <Entry>
      <PointerOffset>628</PointerOffset>
      <JapaneseText>バークライト家
現在</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>940</PointerOffset>
      <JapaneseText>……ねえ、お兄ちゃん？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3700</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1300</PointerOffset>
      <JapaneseText>ん？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1692</PointerOffset>
      <JapaneseText>あたしたちって、クレスさんとそんなに
仲良かったっけ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3700</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2148</PointerOffset>
      <JapaneseText>そういえば……。変だな、
アミィ、おまえなんで、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2452</PointerOffset>
      <JapaneseText>あんな奴の人形なんか作ってるんだ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3100</PointerOffset>
      <JapaneseText>なんでだろう……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3700</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3468</PointerOffset>
      <JapaneseText>……ま、いいさ。とにかく早く寝ろよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3988</PointerOffset>
      <JapaneseText>俺も明日からまた、ゴーリのとこの連中を
率いて、狩りに出かけるんだからな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4316</PointerOffset>
      <JapaneseText>そうだっけ？　他の人じゃなかった？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3700</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4636</PointerOffset>
      <JapaneseText>ああ？　んなことねえよ。
……ほら、もう火、消すぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5108</PointerOffset>
      <JapaneseText>うん……お休み、お兄ちゃん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3700</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5580</PointerOffset>
      <JapaneseText>ああ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5900</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>14</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>6204</PointerOffset>
      <JapaneseText>……ふっ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
