    <Entry>
      <PointerOffset/>
      <JapaneseText>チェスター・バークライト（幼少）</JapaneseText>
      <EnglishText>Chester Burklight (Young)</EnglishText>
      <Notes>Reference only</Notes>
      <Id>4000</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset/>
      <JapaneseText>クレス・アルベイン（幼少）</JapaneseText>
      <EnglishText>Cless Albane (Young)</EnglishText>
      <Notes>Reference only</Notes>
      <Id>3900</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>204</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>1100</PointerOffset>
      <JapaneseText>あ、ありがとう、クレスさん！
……お兄ちゃん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1540</PointerOffset>
      <JapaneseText>これで、許してくれよ、アミィ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1836</PointerOffset>
      <JapaneseText>ぐすっ。うん！　許してあげる。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2388</PointerOffset>
      <JapaneseText>仲良しになったのは本当みたいだから！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2684</PointerOffset>
      <JapaneseText>お、おう！ 固いきずなで
ばっちりだぜ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3236</PointerOffset>
      <JapaneseText>なあ、クレス？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3628</PointerOffset>
      <JapaneseText>そうだよ、チェスター！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4020</PointerOffset>
      <JapaneseText>は、ははは！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4796</PointerOffset>
      <JapaneseText>良かった……さ、帰ろ！
帰って朝ごはんにしよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5292</PointerOffset>
      <JapaneseText>あ、あのっ！
クレスさんもぜひ寄っていってくださいね！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5868</PointerOffset>
      <JapaneseText>ほんとに？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6172</PointerOffset>
      <JapaneseText>おう、寄ってけ寄ってけ、
アミィの飯はうまいぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6724</PointerOffset>
      <JapaneseText>うん！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7196</PointerOffset>
      <JapaneseText>……お、お兄ちゃん、ちょっと。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7780</PointerOffset>
      <JapaneseText>なんだよ、アミィ。
……お、おい、そんなに腕ひっぱんなよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8244</PointerOffset>
      <JapaneseText>ク、クレスさん、ごめんなさい、
ちょっと待ってて！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8644</PointerOffset>
      <JapaneseText>あ、うん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8996</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>18</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>10148</PointerOffset>
      <JapaneseText>なんだよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10412</PointerOffset>
      <JapaneseText>お、……おい、顔、赤いぞ？
大丈夫か？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10908</PointerOffset>
      <JapaneseText>……ど、どうしよう、お兄ちゃん！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11364</PointerOffset>
      <JapaneseText>なにが？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11732</PointerOffset>
      <JapaneseText>あ、あのね……。
あたし、クレスさんのこと……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12028</PointerOffset>
      <JapaneseText>すっごく好きみたい！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12420</PointerOffset>
      <JapaneseText>んなっ……！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12908</PointerOffset>
      <JapaneseText>ほ、ほらっ、
手なんかこんなに震えちゃってるんだよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13252</PointerOffset>
      <JapaneseText>……ど、どうしよう！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13572</PointerOffset>
      <JapaneseText>……俺が知るかよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13900</PointerOffset>
      <JapaneseText>お兄ちゃん！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14356</PointerOffset>
      <JapaneseText>あー、わかったわかった！
いいよ、おまえがあいつを好きでも！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15092</PointerOffset>
      <JapaneseText>兄ちゃんは応援してやる！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15532</PointerOffset>
      <JapaneseText>……本当？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15924</PointerOffset>
      <JapaneseText>ああ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>16396</PointerOffset>
      <JapaneseText>――でもな、子供らしい、
節度ある交際をするんだぞ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>16756</PointerOffset>
      <JapaneseText>や、やだ！	交際だなんて……。
告白もしてないのに……やん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17588</PointerOffset>
      <JapaneseText>……こんなアミィ、見たことねえ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17972</PointerOffset>
      <JapaneseText>あのー……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18316</PointerOffset>
      <JapaneseText>ひ、ひゃいっ！　いま、いきますっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18572</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>39</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>19836</PointerOffset>
      <JapaneseText>どうしたの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>20132</PointerOffset>
      <JapaneseText>ううん、なんでもないです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>20476</PointerOffset>
      <JapaneseText>ただ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>20804</PointerOffset>
      <JapaneseText>ただ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>21156</PointerOffset>
      <JapaneseText>いいお天気だなーって思って。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>21540</PointerOffset>
      <JapaneseText>ふっ、……そうだね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>21980</PointerOffset>
      <JapaneseText>いいお天気だ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>22276</PointerOffset>
      <JapaneseText>ああ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>22596</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>48</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>22828</PointerOffset>
      <JapaneseText>さ。みんなで、ごはんにしましょ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>22924</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>50</Id>
      <Status>Done</Status>
    </Entry>
  </Strings>
</SceneText>
