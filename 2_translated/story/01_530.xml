    <Entry>
      <PointerOffset>772</PointerOffset>
      <JapaneseText>トーティスの橋
現在</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1316</PointerOffset>
      <JapaneseText>アミィさんて、すずちゃんに
似ていたのですか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1804</PointerOffset>
      <JapaneseText>どうして？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2124</PointerOffset>
      <JapaneseText>すずちゃんに聞いたんです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2420</PointerOffset>
      <JapaneseText>チェスターさんに、妹の事を思い出して
放っておけないんだ、って言われたって。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2788</PointerOffset>
      <JapaneseText>そうだなあ……なんでも自分で抱え込もうと
するところは、似てるかな？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3124</PointerOffset>
      <JapaneseText>他は、ぜんぜん似てないけど。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3500</PointerOffset>
      <JapaneseText>……いい子だったよ、とっても。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3924</PointerOffset>
      <JapaneseText>アミィちゃんがいなかったら、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3996</PointerOffset>
      <JapaneseText>僕とチェスターは友達になってなかった
ろうな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4436</PointerOffset>
      <JapaneseText>……クレスさん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4812</PointerOffset>
      <JapaneseText>ん？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5284</PointerOffset>
      <JapaneseText>よかったら、昔のこと、
聞かせてくださいませんか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5644</PointerOffset>
      <JapaneseText>わたし、もっと知りたいんです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5940</PointerOffset>
      <JapaneseText>この村のこと、チェスターさんのこと、
……クレスさんのこと。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6524</PointerOffset>
      <JapaneseText>思い出すの……つらい、ですか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6932</PointerOffset>
      <JapaneseText>大丈夫だよ。
……僕も、ミントに知ってほしい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7420</PointerOffset>
      <JapaneseText>この村がどんなに素晴らしかったか。
僕たちがどんなにこの村が好きだったか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7828</PointerOffset>
      <JapaneseText>……だって、ミントも今日からこの村の
住民なんだから。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8124</PointerOffset>
      <JapaneseText>……はい！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8620</PointerOffset>
      <JapaneseText>チェスターが、この村に来たのは、
今から５年前……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8948</PointerOffset>
      <JapaneseText>僕はまだ、世の中のことなんか何にも
知らない、１２歳のときだった―― </JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
