    </Entry>
  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>204</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>780</PointerOffset>
      <JapaneseText>トーティスの村
外れ</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1340</PointerOffset>
      <JapaneseText>はあはあはあ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2164</PointerOffset>
      <JapaneseText>よお、クレス。お姫様のお出迎えかい？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5900</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3484</PointerOffset>
      <JapaneseText>あ、うん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3980</PointerOffset>
      <JapaneseText>そりゃあちょうどよかったな、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5900</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4276</PointerOffset>
      <JapaneseText>ほら、ゴーリのとこの連中と入れ違いに
やってくるところだぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5900</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4564</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>7</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>5596</PointerOffset>
      <JapaneseText>イライザ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5892</PointerOffset>
      <JapaneseText>久しぶり、クレス。
わたしのこと、迎えに来てくれたの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6348</PointerOffset>
      <JapaneseText>うん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6852</PointerOffset>
      <JapaneseText>お父様、このままクレスと
遊びに行ってもいい？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6972</PointerOffset>
      <JapaneseText>ああ、いっといで。「やすらぎ」亭に
部屋を取っておくから。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7188</PointerOffset>
      <JapaneseText>わかってます。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7628</PointerOffset>
      <JapaneseText>……どーせ、他に宿なんてないんだから。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7948</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>15</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>8308</PointerOffset>
      <JapaneseText>いきましょ、クレス。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8604</PointerOffset>
      <JapaneseText>うん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8924</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>18</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>9532</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>19</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>9964</PointerOffset>
      <JapaneseText>イライザ、今日はどこ行く？
森にしようか！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10580</PointerOffset>
      <JapaneseText>前に話した事あるかな？
もうすぐ、珍しい花が咲くんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10844</PointerOffset>
      <JapaneseText>それを―― </JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11108</PointerOffset>
      <JapaneseText>森……？　虫に刺されるからやだな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11684</PointerOffset>
      <JapaneseText>じゃあさ、草原にしようか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12172</PointerOffset>
      <JapaneseText>ゴーリさんのとこで、お弁当を買って
ピクニックしようよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12596</PointerOffset>
      <JapaneseText>いまからだったら、すっごくきれいな
夕陽が見られるよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12932</PointerOffset>
      <JapaneseText>イライザ、好きだったよね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13356</PointerOffset>
      <JapaneseText>……もう飽きちゃった。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13732</PointerOffset>
      <JapaneseText>えっ……じ、じゃあ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14300</PointerOffset>
      <JapaneseText>それよりさ、もっと近くでいいところが
あるじゃない？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14868</PointerOffset>
      <JapaneseText>ど、どこ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15444</PointerOffset>
      <JapaneseText>教会の裏の、は・や・し。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>16092</PointerOffset>
      <JapaneseText>あそこって、昼でもちょっと暗くて、
ムードあるのよね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>16548</PointerOffset>
      <JapaneseText>でも、あそこ、何にもないよ？
あんなところで何するの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17140</PointerOffset>
      <JapaneseText>やあねえ、わかってるくせに。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18004</PointerOffset>
      <JapaneseText>ほらクレス、こっち来て。
早く、二人っきりになりましょうよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18268</PointerOffset>
      <JapaneseText>あっ、あっ。　で、でも……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18820</PointerOffset>
      <JapaneseText>なあに、男の子でしょ？　ほらあ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4700</SpeakerId>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
