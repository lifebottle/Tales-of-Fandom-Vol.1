      <Id>3</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>1620</PointerOffset>
      <JapaneseText>声をかける&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1628</PointerOffset>
      <JapaneseText>放っておく&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1964</PointerOffset>
      <JapaneseText>あ！　坊ちゃん、どこへ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2692</PointerOffset>
      <JapaneseText>ごめん、先行ってて！
すぐに追いつくから！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3012</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>8</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>3812</PointerOffset>
      <JapaneseText>……はあ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4028</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>10</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>4132</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>11</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>4468</PointerOffset>
      <JapaneseText>アミィちゃん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4804</PointerOffset>
      <JapaneseText>あ、クレスさん……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5132</PointerOffset>
      <JapaneseText>どうしたの、こんなところで。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5428</PointerOffset>
      <JapaneseText>ちょっと……。それより、
クレスさんこそどうしたんですか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6076</PointerOffset>
      <JapaneseText>鎧なんか着て、その格好、
まるで戦争に行くみたいですよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6468</PointerOffset>
      <JapaneseText>ああ、ちがうよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6844</PointerOffset>
      <JapaneseText>裏の森に余所者が
入り込んだらしいんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7140</PointerOffset>
      <JapaneseText>だから、アルベイン流の門下生たちで
これから見回りに行くんだよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7436</PointerOffset>
      <JapaneseText>野盗とかだったら大変だからね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7924</PointerOffset>
      <JapaneseText>そうだ！
チェスターにも参加してもらえないかな？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8380</PointerOffset>
      <JapaneseText>アルベイン流は剣士ばかりだから、
弓使いが敵にいたときのために、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8452</PointerOffset>
      <JapaneseText>手伝ってもらえるとありがたいんだけどな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8748</PointerOffset>
      <JapaneseText>……お兄ちゃん、いません。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9156</PointerOffset>
      <JapaneseText>ゴーリさんとこの狩猟隊に参加してるの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9508</PointerOffset>
      <JapaneseText>狩猟隊は、来週までおやすみです……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9724</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>27</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>10156</PointerOffset>
      <JapaneseText>どうしたの、アミィちゃん？
なにかあったの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10460</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>29</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>10852</PointerOffset>
      <JapaneseText>何でもありません。平気です。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11324</PointerOffset>
      <JapaneseText>……クレスさん、頑張ってくださいね！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11652</PointerOffset>
      <JapaneseText>あ、うん……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12036</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>33</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>12460</PointerOffset>
      <JapaneseText>……お兄ちゃん、様子が変なんです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12812</PointerOffset>
      <JapaneseText>チェスターが？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13108</PointerOffset>
      <JapaneseText>パパとママの命日が近いのに、
なんだか上の空で、それなのに、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13180</PointerOffset>
      <JapaneseText>何を聞いても「心配するな」って
いうばっかりで……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13556</PointerOffset>
      <JapaneseText>ふうん……わかった。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14028</PointerOffset>
      <JapaneseText>チェスターにあったら、
僕がそれとなく聞いてみるよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14324</PointerOffset>
      <JapaneseText>……いいんですか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14716</PointerOffset>
      <JapaneseText>大丈夫、任せておいて。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14956</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>42</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>15380</PointerOffset>
      <JapaneseText>……お兄ちゃん、様子が変なんです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15732</PointerOffset>
      <JapaneseText>チェスターが？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>16028</PointerOffset>
      <JapaneseText>パパとママの命日が近いのに、なんだか上の空で、それなのに、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>16100</PointerOffset>
      <JapaneseText>何を聞いても「心配するな」って
いうばっかりで……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>16380</PointerOffset>
      <JapaneseText>ぐすっ。
あ、あんなお兄ちゃん、は、初めてで……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17076</PointerOffset>
      <JapaneseText>だ、誰にも、そ、相談できなくて……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17420</PointerOffset>
      <JapaneseText>大丈夫、大丈夫だよ、アミィちゃん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18084</PointerOffset>
      <JapaneseText>あ、あたし、お兄ちゃんと、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>50</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18428</PointerOffset>
      <JapaneseText>森に「夜光花」を摘みに、い、行こうね、
って言いたいの。ぐすっ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>51</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>19060</PointerOffset>
      <JapaneseText>でも、い、いえなくて……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>52</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>19436</PointerOffset>
      <JapaneseText>うん、わかった……。
わかったよ、アミィちゃん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>53</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>19908</PointerOffset>
      <JapaneseText>僕がそれとなくチェスターに聞いてみるよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>54</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>20204</PointerOffset>
      <JapaneseText>ぐすっ……あ、ありがとうございます……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>55</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>20740</PointerOffset>
      <JapaneseText>大丈夫、任せておいて。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>56</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>20996</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>57</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>21836</PointerOffset>
      <JapaneseText>坊ちゃん、そろそろ行きましょう。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>6100</SpeakerId>
      <Id>58</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>22140</PointerOffset>
      <JapaneseText>あ、うん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>59</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>22644</PointerOffset>
      <JapaneseText>……それじゃ、アミィちゃん。
元気出して！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>60</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>23036</PointerOffset>
      <JapaneseText>はい……いってらっしゃい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3800</SpeakerId>
      <Id>61</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>23420</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>62</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>24804</PointerOffset>
      <JapaneseText>どうしたんですか、坊ちゃん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>63</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>25460</PointerOffset>
      <JapaneseText>うん、なんでもないよ。行こう。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>64</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>25908</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>65</Id>
