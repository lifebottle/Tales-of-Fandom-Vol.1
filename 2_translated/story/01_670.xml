    <Entry>
      <PointerOffset>732</PointerOffset>
      <JapaneseText>トーティスの橋
現在</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1044</PointerOffset>
      <JapaneseText>それで……どうなったのですか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1500</PointerOffset>
      <JapaneseText>うん。結局、チェスターの言ったことは
嘘だったんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2020</PointerOffset>
      <JapaneseText>森の奥には盗賊団がいた。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2404</PointerOffset>
      <JapaneseText>あいつはその、ユークリッド時代の悪い
仲間と結託して、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2476</PointerOffset>
      <JapaneseText>村が王都に納める税金を積んだ輸送馬車を
襲う計画を立ててたんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2772</PointerOffset>
      <JapaneseText>その人たちは、その後は？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3132</PointerOffset>
      <JapaneseText>盗賊団のほとんどは、ユークリッドに
送られて、裁判の末に縛り首になったよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3516</PointerOffset>
      <JapaneseText>チェスターさんも……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3876</PointerOffset>
      <JapaneseText>いや。あいつはならなかった。
護送中に、まんまと逃げたんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4380</PointerOffset>
      <JapaneseText>それきり、行方が知れない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4724</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>12</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>4980</PointerOffset>
      <JapaneseText>……あの、クレスさん？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5708</PointerOffset>
      <JapaneseText>ん？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6052</PointerOffset>
      <JapaneseText>チェスターさん、て、わたしたちと一緒に、
ダオスと戦いませんでした……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6572</PointerOffset>
      <JapaneseText>やだなあ、そんなことあるわけないだろ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6948</PointerOffset>
      <JapaneseText>じ、じゃあ、どうして、クレスさんは
わたしに、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7372</PointerOffset>
      <JapaneseText>チェスターさんのお話をしてくださった
のですか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7884</PointerOffset>
      <JapaneseText>そういえば……どうしてだろう？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8212</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>20</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>8796</PointerOffset>
      <JapaneseText>ま、まあ、いいじゃないか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9676</PointerOffset>
      <JapaneseText>そ、そうですね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10380</PointerOffset>
      <JapaneseText>あ、あははははは……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10756</PointerOffset>
      <JapaneseText>うふふふ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
