    <Entry>
      <PointerOffset>660</PointerOffset>
      <JapaneseText>森
夜</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1188</PointerOffset>
      <JapaneseText>しまったなあ……見失うなんて……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1500</PointerOffset>
      <JapaneseText>どこに行ったんだろう……。
こんな夜に森に入るなんて……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1956</PointerOffset>
      <JapaneseText>弓を持ってたけど、狩りってわけじゃ
なさそうだし。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2396</PointerOffset>
      <JapaneseText>……あれ？　奥で光ってるのは、焚き火の
光……？　もしかして、あそこかな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2892</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>6</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>3476</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>7</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>5204</PointerOffset>
      <JapaneseText>チェスター……と、誰だ？
１、２、３……２０人はいるぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6220</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>9</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>6996</PointerOffset>
      <JapaneseText>よーし、野郎共、よーく聞け！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7364</PointerOffset>
      <JapaneseText>夜にまぎれてじきに村を馬車が出発する。
今年の税金を納めるための馬車だ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7660</PointerOffset>
      <JapaneseText>たーっぷりとお宝を積んでるぜ。
俺たちはこいつをいただく！　夜襲だ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8428</PointerOffset>
      <JapaneseText>おおっー！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>6300</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8796</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>14</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>9380</PointerOffset>
      <JapaneseText>なんだって……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9620</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>16</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>10396</PointerOffset>
      <JapaneseText>護衛は、アルベイン流とかいう田舎道場の
剣士が４人！　こっちは２２人だ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10820</PointerOffset>
      <JapaneseText>大したこたあねえ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11164</PointerOffset>
      <JapaneseText>手順はこうだ。まず、グレイの野郎が
御者をお得意の矢で射殺す。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11708</PointerOffset>
      <JapaneseText>そしたら、全員で襲い掛かる。
護衛も、御者も、村役人も、皆殺しだ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12436</PointerOffset>
      <JapaneseText>おおっー！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>6300</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12956</PointerOffset>
      <JapaneseText>ま、待ってくれ！
話が違うぜ、クレイトンさん！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13732</PointerOffset>
      <JapaneseText>誰も殺さねえっていったじゃんか！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14076</PointerOffset>
      <JapaneseText>ああ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14500</PointerOffset>
      <JapaneseText>ぐっ、ぐあっ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14900</PointerOffset>
      <JapaneseText>なめたこといってんじゃねえ、グレイ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15276</PointerOffset>
      <JapaneseText>嫌だってんなら、この場で、
てめえを殺してもいいんだぜ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15572</PointerOffset>
      <JapaneseText>その後で、てめえの可愛い妹を、
ガスパルに売り飛ばしてやる。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>16084</PointerOffset>
      <JapaneseText>ガスパル、だと……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>16348</PointerOffset>
      <JapaneseText>そうだ。あの、変態野郎だよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17044</PointerOffset>
      <JapaneseText>あいつがお前の妹に目をつけてたのは、
知ってるよなあ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17500</PointerOffset>
      <JapaneseText>さあ、どうする？　ここで死んで、
妹を地獄に落とすか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18212</PointerOffset>
      <JapaneseText>それとも、俺たちに協力するか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18660</PointerOffset>
      <JapaneseText>ん……、ぐっ……、……くそっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>19036</PointerOffset>
      <JapaneseText>わかったよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>19412</PointerOffset>
      <JapaneseText>それでいい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>19884</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>37</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>20220</PointerOffset>
      <JapaneseText>そんな……チェスター……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>20340</PointerOffset>
      <JapaneseText>ようし、野郎共！　出発だ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>20460</PointerOffset>
      <JapaneseText>おおっー！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>6300</SpeakerId>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>20556</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>41</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>21468</PointerOffset>
      <JapaneseText>……村に戻って知らせたんじゃ、
きっと間に合わない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>21972</PointerOffset>
      <JapaneseText>あの人数を相手にするのはきついけど、
でも、チェスターが味方をしてくれれば……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>22364</PointerOffset>
      <JapaneseText>くそっ！　どうする！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>22836</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>45</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>22884</PointerOffset>
      <JapaneseText>それでもチェスターを信じる&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>22892</PointerOffset>
      <JapaneseText>村を守ることを第一に考える&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
