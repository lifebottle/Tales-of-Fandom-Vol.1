    <Entry>
      <PointerOffset>204</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>1500</PointerOffset>
      <JapaneseText>なんだ、てめえは！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2028</PointerOffset>
      <JapaneseText>クレス！？ ――クレイトンさん、
ちょっとまってくれ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2628</PointerOffset>
      <JapaneseText>――馬鹿やろう、何しに来た。早く帰れ！
そして今見たことは忘れろ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3308</PointerOffset>
      <JapaneseText>チェスター、君は、村のみんなの役に
立ちたくて、一人で森に見回りに来て、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3812</PointerOffset>
      <JapaneseText>それで、こいつらを見つけたんだよね。
そうだろ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4588</PointerOffset>
      <JapaneseText>なん、だと……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4852</PointerOffset>
      <JapaneseText>そうなんだろ、チェスター？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5268</PointerOffset>
      <JapaneseText>ちっ……ふざけんな！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5932</PointerOffset>
      <JapaneseText>俺は、てめえみたいな、いい子ちゃんが
一番むかつくんだよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6436</PointerOffset>
      <JapaneseText>クレイトンさん！　こいつ、
アルベイン道場の奴だ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6844</PointerOffset>
      <JapaneseText>チェスター！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7164</PointerOffset>
      <JapaneseText>なんだと？ なら……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7460</PointerOffset>
      <JapaneseText>生かしちゃおけねえなっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8300</PointerOffset>
      <JapaneseText>くそ……ガキがっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8444</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>15</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>8868</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>16</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>9468</PointerOffset>
      <JapaneseText>悪人どもめ！　アルベイン流は田舎剣術
なんかじゃないことを、教えてやるっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9844</PointerOffset>
      <JapaneseText>くらえっ！　魔神剣っ！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10300</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>19</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>10476</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>20</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>11420</PointerOffset>
      <JapaneseText>ぎゃあああっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11780</PointerOffset>
      <JapaneseText>な、なんだこのガキはっ！
つ、強えぞ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>6300</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12420</PointerOffset>
      <JapaneseText>に、逃げろ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4300</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13020</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>24</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>13196</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>25</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>13572</PointerOffset>
      <JapaneseText>逃がすかっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13884</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>27</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>14012</PointerOffset>
      <JapaneseText>ぎゃーーーーー！
ひーーーーー！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14108</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>29</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>14220</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>30</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>14652</PointerOffset>
      <JapaneseText>つきあってらんねえぜ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14892</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>32</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>15356</PointerOffset>
      <JapaneseText>逃がすかっ、チェスター！　裏切り者っ！
――魔神剣っ！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15892</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>34</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>16108</PointerOffset>
      <JapaneseText>うわああああっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>16204</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>36</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>16324</PointerOffset>
      <JapaneseText>はあはあはあはあ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>16396</PointerOffset>
      <JapaneseText>……ちくしょう……ちくしょうーっ！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>16500</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>39</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>16868</PointerOffset>
      <JapaneseText>馬鹿やろう！　俺のことは放っとけ！
殺されるぞ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17620</PointerOffset>
      <JapaneseText>チェスター、アミィちゃんが心配してたよ。
御両親の命日も近いんだろ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17996</PointerOffset>
      <JapaneseText>君がこのままこの連中と馬車を襲ったら、
アミィちゃんが悲しむ。それでもいいのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18596</PointerOffset>
      <JapaneseText>チェスター、アミィちゃんが心配してたよ。
御両親の命日も近いんだろ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>19052</PointerOffset>
      <JapaneseText>「夜光花」を摘みに行きたい、って
いってた。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>19348</PointerOffset>
      <JapaneseText>でも、ここでこいつらの仲間になったら、
もうそんなこともできないぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>19724</PointerOffset>
      <JapaneseText>それでもいいのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>20228</PointerOffset>
      <JapaneseText>よくねえよ！　そんなことは、
わかってんだよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>20940</PointerOffset>
      <JapaneseText>だがな、どうしろってんだよ！
この人数だぞ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>21364</PointerOffset>
      <JapaneseText>大したことないだろ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>21740</PointerOffset>
      <JapaneseText>……僕と、君の二人なら。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3900</SpeakerId>
      <Id>50</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>22148</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>51</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>22732</PointerOffset>
      <JapaneseText>……へ、へへへ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>52</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>23156</PointerOffset>
      <JapaneseText>ばかやろうだよ、おまえは！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>53</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>23804</PointerOffset>
      <JapaneseText>悪いな、クレイトンさん。そういうわけだ。
俺は、抜けさせてもらうぜ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>54</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>24180</PointerOffset>
      <JapaneseText>あ、それから、馬車も襲わせねえから。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4000</SpeakerId>
      <Id>55</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>24588</PointerOffset>
      <JapaneseText>ちっ……やっぱりガキはガキか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>56</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>25236</PointerOffset>
      <JapaneseText>……かまわねえ！　てめえら、景気づけだ！
このガキどもをぶっ殺せ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>57</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>25556</PointerOffset>
      <JapaneseText>おおっー！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4600</SpeakerId>
      <Id>58</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>25660</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>59</Id>
      <Status>Done</Status>
    </Entry>
