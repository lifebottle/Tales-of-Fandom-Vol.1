    <Entry>
      <PointerOffset>556</PointerOffset>
      <JapaneseText>バークライト家
過去</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>844</PointerOffset>
      <JapaneseText>あの時、あたし本当に嬉しかったな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3700</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1140</PointerOffset>
      <JapaneseText>お兄ちゃんとクレスさんが
仲良くなってくれて。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3700</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1260</PointerOffset>
      <JapaneseText>『夢、か……』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3700</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1548</PointerOffset>
      <JapaneseText>もう、だいじょうぶだよね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3700</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1732</PointerOffset>
      <JapaneseText>『そうだな、これは夢だ……』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3700</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1988</PointerOffset>
      <JapaneseText>あたしたち、これから幸せになれるよね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3700</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2444</PointerOffset>
      <JapaneseText>ばーか、当たり前だろ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3140</PointerOffset>
      <JapaneseText>……うん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3700</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3644</PointerOffset>
      <JapaneseText>……おやすみなさい、お兄ちゃん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3700</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4132</PointerOffset>
      <JapaneseText>ああ、ゆっくり休めよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4580</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>12</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>4740</PointerOffset>
      <JapaneseText>……ふっ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5036</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>14</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>5692</PointerOffset>
      <JapaneseText>お兄ちゃん？……もう、寝ちゃったの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3700</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6276</PointerOffset>
      <JapaneseText>お兄ちゃん……ずっと、大好きだよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3700</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6908</PointerOffset>
      <JapaneseText>ふふっ……おやすみ、お兄ちゃん……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3700</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
