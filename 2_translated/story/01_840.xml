      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>588</PointerOffset>
      <JapaneseText>『これは……。 やめろ……。&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>596</PointerOffset>
      <JapaneseText>こんなのは見たくない……』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>668</PointerOffset>
      <JapaneseText>『ぐっ、なんてことを！
こんな子供まで殺すことはないだろう！』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>740</PointerOffset>
      <JapaneseText>『皆殺しにしろ、とのマルス隊長の
ご命令だ！　逆らうのか！』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>876</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>5</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>1196</PointerOffset>
      <JapaneseText>お人形……クレスさん、
喜んでくれるかなあ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>6600</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1492</PointerOffset>
      <JapaneseText>くそっ！……これのどこが盗賊の村なんだ！
何もないじゃないか！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1564</PointerOffset>
      <JapaneseText>おい、撤退だ！　急げ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1636</PointerOffset>
      <JapaneseText>いくぞ！　そんなガキは捨て置け！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1708</PointerOffset>
      <JapaneseText>くっ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1852</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>11</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>2164</PointerOffset>
      <JapaneseText>喜んでくれるよね……。
お兄ちゃんも、そう……思うでしょ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2236</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>13</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>2620</PointerOffset>
      <JapaneseText>なんか……寒いな……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2692</PointerOffset>
      <JapaneseText>お兄ちゃんも……クレスさんも……。
風邪……ひかないと……いい……な……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2764</PointerOffset>
      <JapaneseText>とっても……さむ……ぃ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2860</PointerOffset>
      <JapaneseText></JapaneseText>
      <EnglishText></EnglishText>
      <Notes>Empty Line</Notes>
      <Id>17</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>3156</PointerOffset>
      <JapaneseText>アミィーっ！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
