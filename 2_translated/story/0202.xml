<SceneText>
  <FriendlyName>Conversation_0202</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x27a333</PointerOffset>
      <JapaneseText>サーチガルド！　サーチガルド！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a353</PointerOffset>
      <JapaneseText>いつまで探してるつもりだ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a36e</PointerOffset>
      <JapaneseText>もうレンズもガルドも根こそぎ拾ったろ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a396</PointerOffset>
      <JapaneseText>うっさいわねぇ！　もぅ落とし物したのよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a3c0</PointerOffset>
      <JapaneseText>まぁ！　何を落とされたのです？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a3df</PointerOffset>
      <JapaneseText>私達も一緒に探しますわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a3f8</PointerOffset>
      <JapaneseText>え……い、いいわよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a410</PointerOffset>
      <JapaneseText>おまえが遠慮するなんて気持ち悪いぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a435</PointerOffset>
      <JapaneseText>なにアンタまでしゃがんでんのよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a456</PointerOffset>
      <JapaneseText>いいってば！　ホントに！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a471</PointerOffset>
      <JapaneseText>はーい！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a47a</PointerOffset>
      <JapaneseText>コレ、そこの草むらで見つけましたぁ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a4a0</PointerOffset>
      <JapaneseText>ずいぶん分厚いノートだな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a4bb</PointerOffset>
      <JapaneseText>にっきちょう……と書いてありますね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a4e1</PointerOffset>
      <JapaneseText>うわああああああ！　見ないで！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a503</PointerOffset>
      <JapaneseText>おまえ、日記なんてつけていたのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a526</PointerOffset>
      <JapaneseText>似合わんな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a533</PointerOffset>
      <JapaneseText>日記帳っていうより</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a546</PointerOffset>
      <JapaneseText>おこづかい帳なんじゃないですかぁ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a56a</PointerOffset>
      <JapaneseText>さすがルーティさん！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a57f</PointerOffset>
      <JapaneseText>金銭管理の腕は確かですね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a59c</PointerOffset>
      <JapaneseText>……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x27a5a3</PointerOffset>
      <JapaneseText>……ふつう、もうちょっと興味示さない？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
