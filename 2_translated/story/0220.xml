<SceneText>
  <FriendlyName>Conversation_0220</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x29c89b</PointerOffset>
      <JapaneseText>どしたの？　お通夜みたいだよ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29c8bc</PointerOffset>
      <JapaneseText>ふん！　さっきまでジョニーにさんざん</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29c8e1</PointerOffset>
      <JapaneseText>持ち歌を披露されて疲れたんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29c902</PointerOffset>
      <JapaneseText>それで、ジョニーさんはどこに？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29c923</PointerOffset>
      <JapaneseText>もう部屋に戻った。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29c936</PointerOffset>
      <JapaneseText>夜更かしは喉に悪いそうだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29c953</PointerOffset>
      <JapaneseText>寝ていた我々を叩き起こしておいて</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29c974</PointerOffset>
      <JapaneseText>……まったく勝手なヤツだよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29c993</PointerOffset>
      <JapaneseText>いいじゃない。やっと落ち着いて</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29c9b2</PointerOffset>
      <JapaneseText>ふたりで話せるわけでしょ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29c9cf</PointerOffset>
      <JapaneseText>話の長いヤツとは喋りたくない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29c9ee</PointerOffset>
      <JapaneseText>なんだと？　ぼくはおまえの理解力に</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29ca11</PointerOffset>
      <JapaneseText>合わせて親切に説明してるだけだ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29ca33</PointerOffset>
      <JapaneseText>僕がバカだと言いたいのか！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29ca50</PointerOffset>
      <JapaneseText>お子様だと言ったんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29ca6a</PointerOffset>
      <JapaneseText>うるさい！　この場で斬られたいか！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29ca8e</PointerOffset>
      <JapaneseText>わあぁ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29ca97</PointerOffset>
      <JapaneseText>ちょ、ちょーっと待って、待って！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29cab9</PointerOffset>
      <JapaneseText>待ちなさーい！！！　なにケンカしてんの！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29cae2</PointerOffset>
      <JapaneseText>元はと言えばアイツがふっかけてきたんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29cb0b</PointerOffset>
      <JapaneseText>キール！　最後まで買い取るコトの出来ない</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29cb34</PointerOffset>
      <JapaneseText>ケンカを買うんじゃないの！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29cb51</PointerOffset>
      <JapaneseText>ふん！　学士だか何だか知らないが</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29cb72</PointerOffset>
      <JapaneseText>アイツのへ理屈には飽き飽きする！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29cb94</PointerOffset>
      <JapaneseText>こら！　口ゲンカに剣を持ち出すなんて</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29cbb9</PointerOffset>
      <JapaneseText>卑怯でしょ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29cbca</PointerOffset>
      <JapaneseText>ふたりともわかった？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29cbe2</PointerOffset>
      <JapaneseText>ふん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29cbee</PointerOffset>
      <JapaneseText>あぁ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29cbfa</PointerOffset>
      <JapaneseText>ファラさん、すごい……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29cc15</PointerOffset>
      <JapaneseText>あっという間にあのリオンさんを！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29cc37</PointerOffset>
      <JapaneseText>はぁ〜、疲れた。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29cc48</PointerOffset>
      <JapaneseText>男の子ってケンカばっかり！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29cc65</PointerOffset>
      <JapaneseText>このテーブルにいても疲れるだけだよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29cc8a</PointerOffset>
      <JapaneseText>次いこ、次！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x29cc97</PointerOffset>
      <JapaneseText>仰せのままに！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
