<SceneText>
  <FriendlyName>Conversation_0236</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x2b67db</PointerOffset>
      <JapaneseText>ちょっといいっすかぁ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b67f5</PointerOffset>
      <JapaneseText>はいはい？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6804</PointerOffset>
      <JapaneseText>あ〜あ〜、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b680f</PointerOffset>
      <JapaneseText>ずいぶんお肌荒れちゃってますねぇ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6832</PointerOffset>
      <JapaneseText>そ、そうか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6843</PointerOffset>
      <JapaneseText>若いから、男だからって安心してちゃダメですよ〜。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6874</PointerOffset>
      <JapaneseText>このままいくと１０年後には……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6895</PointerOffset>
      <JapaneseText>何つかまってんだよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b68ad</PointerOffset>
      <JapaneseText>あぁ、リッド！　どうしよ！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b68ca</PointerOffset>
      <JapaneseText>俺の肌、１０年後にはボロボロだって！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b68f0</PointerOffset>
      <JapaneseText>真に受けるなよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6901</PointerOffset>
      <JapaneseText>これはキャッチセールスといってだな……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b692a</PointerOffset>
      <JapaneseText>さぁ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6931</PointerOffset>
      <JapaneseText>あなたもダンディな男に変身しませんか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6959</PointerOffset>
      <JapaneseText>今ならこのベアの干し肉３ヶ月分がもれなく……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6988</PointerOffset>
      <JapaneseText>肉がついてくんのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b699d</PointerOffset>
      <JapaneseText>あっそ。へぇ！　３ヶ月分……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b69bc</PointerOffset>
      <JapaneseText>おい、だいじょうぶかい？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b69d7</PointerOffset>
      <JapaneseText>これ買っておこうぜ、「ダンディセット」！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6a00</PointerOffset>
      <JapaneseText>身だしなみは大事だろ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6a1a</PointerOffset>
      <JapaneseText>今なら肉がついてくんだってよ！　肉が！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6a42</PointerOffset>
      <JapaneseText>落ち着けって、２人とも。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6a5d</PointerOffset>
      <JapaneseText>いいかい？　冒険中、こんな道具を</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6a7e</PointerOffset>
      <JapaneseText>使っている余裕はないだろう？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6a9b</PointerOffset>
      <JapaneseText>そ、そりゃまぁ……たしかに。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6ab8</PointerOffset>
      <JapaneseText>それに、これを買うお金があったら</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6ad9</PointerOffset>
      <JapaneseText>上等な肉が山ほど買えるよ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6af6</PointerOffset>
      <JapaneseText>そっか……あぶねぇあぶねぇ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6b13</PointerOffset>
      <JapaneseText>つい勢いで……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6b24</PointerOffset>
      <JapaneseText>というわけなんで、悪いけど僕達は……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6b4b</PointerOffset>
      <JapaneseText>だんなぁ〜！！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6b5c</PointerOffset>
      <JapaneseText>俺にはもうじき２歳になる娘が……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6b7f</PointerOffset>
      <JapaneseText>これを売らないことにはアイツの</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6b9e</PointerOffset>
      <JapaneseText>おまんまが買えねぇんだよぅ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2b6bbd</PointerOffset>
      <JapaneseText>娘さんが……いるの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
