<SceneText>
  <FriendlyName>Conversation_0242</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x2bd81b</PointerOffset>
      <JapaneseText>ねぇねぇ彼女、学生さん？　かわいいね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bd842</PointerOffset>
      <JapaneseText>ちょっと時間ないかなぁ〜？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bd85f</PointerOffset>
      <JapaneseText>時間か？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bd86c</PointerOffset>
      <JapaneseText>は！　いけない！！　メルディさんと</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bd88f</PointerOffset>
      <JapaneseText>ルーティさんが都会の毒牙にぃ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bd8b0</PointerOffset>
      <JapaneseText>時は金なりってことわざ知ってる？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bd8d2</PointerOffset>
      <JapaneseText>は？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bd8dc</PointerOffset>
      <JapaneseText>あたし達の足を止めさせたいなら、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bd8fd</PointerOffset>
      <JapaneseText>それなりの金額を用意してもらわないと。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bd925</PointerOffset>
      <JapaneseText>金、ですか……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bd939</PointerOffset>
      <JapaneseText>そう、金よ！　どうなの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bd954</PointerOffset>
      <JapaneseText>えっとあいにく……っていうか</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bd971</PointerOffset>
      <JapaneseText>俺が欲しいくらいで……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bd98a</PointerOffset>
      <JapaneseText>ダメ！　話になんない！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bd9a1</PointerOffset>
      <JapaneseText>メルディ、行くよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bd9b7</PointerOffset>
      <JapaneseText>は、はいな！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bd9c8</PointerOffset>
      <JapaneseText>ルーティさん、強いですぅ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bd9e5</PointerOffset>
      <JapaneseText>おっと、ごめんね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bd9fb</PointerOffset>
      <JapaneseText>じゃじゃーん！　アーチェさん登場！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bda1f</PointerOffset>
      <JapaneseText>……あ、ども。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bda32</PointerOffset>
      <JapaneseText>なによ？　あたしに用はないわけ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bda54</PointerOffset>
      <JapaneseText>い、いや、用ってほどの用は……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bda75</PointerOffset>
      <JapaneseText>むぅ〜。せっかく来てやったのにぃ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bda99</PointerOffset>
      <JapaneseText>あ、じゃあ……ねぇねぇ彼女、学生さん？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bdac1</PointerOffset>
      <JapaneseText>ちがうよー。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bdad2</PointerOffset>
      <JapaneseText>あ、なら、社会人だ。かわいいねぇ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bdaf5</PointerOffset>
      <JapaneseText>ちょっと時間あるかな？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bdb0f</PointerOffset>
      <JapaneseText>時間？　あるあるあるー！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bdb29</PointerOffset>
      <JapaneseText>だからもっと言って！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bdb41</PointerOffset>
      <JapaneseText>は？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bdb4b</PointerOffset>
      <JapaneseText>かわいいってもっともっと言って！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bdb6c</PointerOffset>
      <JapaneseText>ぐふふふー。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bdb7d</PointerOffset>
      <JapaneseText>今日は……日が悪ぃや。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bdb97</PointerOffset>
      <JapaneseText>あ！　なんでいっちゃうのー？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bdbb6</PointerOffset>
      <JapaneseText>アーチェさん</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2bdbc3</PointerOffset>
      <JapaneseText>あらゆる意味で強いですぅ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
