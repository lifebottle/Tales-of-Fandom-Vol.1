      <Notes> </Notes>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2c7f15</PointerOffset>
      <JapaneseText>あ、し、失礼します！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
