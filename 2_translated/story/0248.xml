      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2c7ec1</PointerOffset>
      <JapaneseText>あのっ、そのっ……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2c7ed6</PointerOffset>
      <JapaneseText>クレスー！</JapaneseText>
