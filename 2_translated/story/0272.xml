<SceneText>
  <FriendlyName>Conversation_0272</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x2de42b</PointerOffset>
      <JapaneseText>ねぇ、今度みんなで演劇やるんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de44c</PointerOffset>
      <JapaneseText>レイスも出演してくれない？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de467</PointerOffset>
      <JapaneseText>ふむ……、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de472</PointerOffset>
      <JapaneseText>どうせ出るなら完ぺきを期したいものだな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de49b</PointerOffset>
      <JapaneseText>それはステキな心構えね……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de4b8</PointerOffset>
      <JapaneseText>って</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de4bd</PointerOffset>
      <JapaneseText>サインの練習から入ってどうすんのー！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de4fc</PointerOffset>
      <JapaneseText>おぅ、主役だな？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de50d</PointerOffset>
      <JapaneseText>え……それは……どうかな？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de528</PointerOffset>
      <JapaneseText>おぅ？　アレだぞ、アレ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de541</PointerOffset>
      <JapaneseText>主役じゃなきゃやらんぞぅ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de55c</PointerOffset>
      <JapaneseText>無理言わないで！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de56d</PointerOffset>
      <JapaneseText>おぅ！　なぜ無理なんだぁ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de5a8</PointerOffset>
      <JapaneseText>驩煙</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de5ad</PointerOffset>
      <JapaneseText>公演を</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de5b4</PointerOffset>
      <JapaneseText>今年も予定していたのですけれど、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de5d5</PointerOffset>
      <JapaneseText>肝心の役者さんが集まらないのです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de5f8</PointerOffset>
      <JapaneseText>なぁんだ、そんなことですか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de615</PointerOffset>
      <JapaneseText>役者さんを集めればいいんですね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de636</PointerOffset>
      <JapaneseText>はい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de63d</PointerOffset>
      <JapaneseText>５人ほど……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de64c</PointerOffset>
      <JapaneseText>５人……ですか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de65d</PointerOffset>
      <JapaneseText>無理ですよね、やっぱり。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de676</PointerOffset>
      <JapaneseText>そ、そんなことないです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de68f</PointerOffset>
      <JapaneseText>イケる、イケる！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de6a0</PointerOffset>
      <JapaneseText>ちょっと待っててくださいね！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x2de6bd</PointerOffset>
      <JapaneseText>あ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
