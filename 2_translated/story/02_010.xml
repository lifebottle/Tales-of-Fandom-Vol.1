    <Entry>
      <PointerOffset/>
      <JapaneseText>ソーディアン ディムロス</JapaneseText>
      <EnglishText>Swordian Dymlos</EnglishText>
      <Notes>Reference only</Notes>
      <Id>2900</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>532</PointerOffset>
      <JapaneseText>デバッグモード：ＯＮ</JapaneseText>
      <EnglishText>Debug Mode: ON</EnglishText>
      <Notes/>
      <SpeakerId>0</SpeakerId>
      <Id>0</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>1180</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>1</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>1340</PointerOffset>
      <JapaneseText>『我が名はディムロス。
お前が手にしている剣だ』</JapaneseText>
      <EnglishText>I am known as Dymlos.
I am the sword you are holding.</EnglishText>
      <Notes/>
      <Id>2</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>1476</PointerOffset>
      <JapaneseText>『け、剣がしゃべった……？』</JapaneseText>
      <EnglishText>Th-The sword talked...?</EnglishText>
      <Notes/>
      <Id>3</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>1612</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>4</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>2260</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>5</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>2324</PointerOffset>
      <JapaneseText>『わたしはお前に力を貸そう。
だからお前も、わたしを信じろ』</JapaneseText>
      <EnglishText>I shall assist you,
so you must have faith in me.</EnglishText>
      <Notes/>
      <Id>6</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>2508</PointerOffset>
      <JapaneseText>『わ、わかった……』</JapaneseText>
      <EnglishText>G-Got it...</EnglishText>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>7</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>2644</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>8</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>3292</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>9</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>3356</PointerOffset>
      <JapaneseText>『コアクリスタルを共鳴振動させ、
神の眼を連鎖的に破壊する！』</JapaneseText>
      <EnglishText>We'll resonate our core crystals together,
and destroy the Eye of Atamoni!</EnglishText>
      <Notes/>
      <Id>10</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>3540</PointerOffset>
      <JapaneseText>『待てよ！
そんなことしたら、お前は……』</JapaneseText>
      <EnglishText>Wait!
If you do that, you'll...!</EnglishText>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>11</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>3676</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>12</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>4324</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>13</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>4388</PointerOffset>
      <JapaneseText>『急げ！　もう時間がないのだ。
世界が破壊し尽くされてもいいのか！』</JapaneseText>
      <EnglishText>Hurry! There's no time left,
or would you prefer the world be destroyed!?</EnglishText>
      <Notes/>
      <Id>14</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>4572</PointerOffset>
      <JapaneseText>『だけど！』</JapaneseText>
      <EnglishText>But...!</EnglishText>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>15</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>4708</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>16</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>5356</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>17</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>5420</PointerOffset>
      <JapaneseText>『世界の行く末は、お前たちが決めるんだ。
いい未来を、作ってくれよ』</JapaneseText>
      <EnglishText>The world's future is yours to decide.
See to it that it is a bright one.</EnglishText>
      <Notes/>
      <Id>18</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>5604</PointerOffset>
      <JapaneseText>『ああ、約束する……』</JapaneseText>
      <EnglishText>Yeah, that's a promise...</EnglishText>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>19</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>5884</PointerOffset>
      <JapaneseText>『さらばだ、スタン！』</JapaneseText>
      <EnglishText>Farewell, Stahn!</EnglishText>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>20</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>6068</PointerOffset>
      <JapaneseText>『ディムロス！　ディムローーーース！』</JapaneseText>
      <EnglishText>Dymlos! DYMLOS!!!</EnglishText>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>21</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>6204</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>22</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>6428</PointerOffset>
      <JapaneseText>スタン……。&lt;nl&gt;</JapaneseText>
      <EnglishText>Stahn...</EnglishText>
      <Notes>Title Card</Notes>
      <Id>23</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>6516</PointerOffset>
      <JapaneseText>聞こえるか、スタン……。&lt;nl&gt;</JapaneseText>
      <EnglishText>Do you hear me, Stahn...?</EnglishText>
      <Notes>Title Card</Notes>
      <Id>24</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>6604</PointerOffset>
      <JapaneseText>聞こえるか、わたしの声が……。&lt;nl&gt;</JapaneseText>
      <EnglishText>Do you hear my voice...?</EnglishText>
      <Notes>Title Card</Notes>
      <Id>25</Id>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <PointerOffset>6692</PointerOffset>
      <JapaneseText>わたしの……。&lt;nl&gt;</JapaneseText>
      <EnglishText>My...</EnglishText>
      <Notes>Title Card</Notes>
      <Id>26</Id>
      <Status>Editing</Status>
    </Entry>
  </Strings>
</SceneText>
