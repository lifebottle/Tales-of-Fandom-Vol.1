      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>1340</PointerOffset>
      <JapaneseText>『我が名はディムロス。
お前が手にしている剣だ』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1476</PointerOffset>
      <JapaneseText>『け、剣がしゃべった……？』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1612</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>4</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>2260</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>5</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>2324</PointerOffset>
      <JapaneseText>『わたしはお前に力を貸そう。
だからお前も、わたしを信じろ』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2508</PointerOffset>
      <JapaneseText>『わ、わかった……』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2644</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>8</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>3292</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>9</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>3356</PointerOffset>
      <JapaneseText>『コアクリスタルを共鳴振動させ、
神の眼を連鎖的に破壊する！』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3540</PointerOffset>
      <JapaneseText>『待てよ！
そんなことしたら、お前は……』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3676</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>12</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>4324</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>13</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>4388</PointerOffset>
      <JapaneseText>『急げ！　もう時間がないのだ。
世界が破壊し尽くされてもいいのか！』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4572</PointerOffset>
      <JapaneseText>『だけど！』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4708</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>16</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>5356</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>17</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>5420</PointerOffset>
      <JapaneseText>『世界の行く末は、お前たちが決めるんだ。
いい未来を、作ってくれよ』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5604</PointerOffset>
      <JapaneseText>『ああ、約束する……』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5884</PointerOffset>
      <JapaneseText>『さらばだ、スタン！』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6068</PointerOffset>
      <JapaneseText>『ディムロス！　ディムローーーース！』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6204</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>22</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>6428</PointerOffset>
      <JapaneseText>スタン……。&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Title Card</Notes>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6516</PointerOffset>
      <JapaneseText>聞こえるか、スタン……。&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Title Card</Notes>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6604</PointerOffset>
      <JapaneseText>聞こえるか、わたしの声が……。&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Title Card</Notes>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6692</PointerOffset>
      <JapaneseText>わたしの……。&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Title Card</Notes>
