      <PointerOffset>15244</PointerOffset>
      <JapaneseText>…………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>51</Id>
      <Status>To Do</Status>
