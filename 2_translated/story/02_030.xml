      <Notes>Single JP space line</Notes>
      <Id>24</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>6292</PointerOffset>
      <JapaneseText>お兄ちゃん、起きて。ね？
おねがい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7796</PointerOffset>
      <JapaneseText>お兄ちゃーん、朝よー！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9100</PointerOffset>
      <JapaneseText>せーのっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9532</PointerOffset>
      <JapaneseText>ぐえっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10020</PointerOffset>
      <JapaneseText>ん〜……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10220</PointerOffset>
      <JapaneseText>ふあ〜ああ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10508</PointerOffset>
      <JapaneseText>あ……リリス。おはよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10884</PointerOffset>
      <JapaneseText>おはよう、お兄ちゃん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11084</PointerOffset>
      <JapaneseText>毎朝起こしてもらって、悪いなー。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11204</PointerOffset>
      <JapaneseText>でも、今日はすぐに起きられただろう？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11420</PointerOffset>
      <JapaneseText>ほんとにそう思ってる？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11636</PointerOffset>
      <JapaneseText>う……違うのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11996</PointerOffset>
      <JapaneseText>はあ。もういいわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12268</PointerOffset>
      <JapaneseText>いつものことだしね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12340</PointerOffset>
      <JapaneseText>さ、早く顔洗ってきて。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12460</PointerOffset>
      <JapaneseText>おじいちゃん、おなかすかせてるわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12604</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>41</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>12972</PointerOffset>
      <JapaneseText>次はどうしてくれようかしら。
えーと……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13372</PointerOffset>
      <JapaneseText>ん〜……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13444</PointerOffset>
      <JapaneseText>ふあ〜ああ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13836</PointerOffset>
      <JapaneseText>あら、ひとりでに起きちゃった。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14188</PointerOffset>
      <JapaneseText>おはよ、リリス。
ん？　なんだか疲れた顔してないか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14524</PointerOffset>
      <JapaneseText>まあね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14724</PointerOffset>
      <JapaneseText>だめだめ、ちゃんと眠らなきゃ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14892</PointerOffset>
      <JapaneseText>そんなことじゃ、美容に悪いぞー。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15012</PointerOffset>
      <JapaneseText>さてと。顔洗ってこようかな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>50</Id>
      <Status>To Do</Status>
    </Entry>
