  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>956</PointerOffset>
      <JapaneseText>氷晶霊の山</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1076</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>1</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>1236</PointerOffset>
      <JapaneseText>聞いた話だと、この雪山の山頂に、
究極のトマトがあるらしいけど……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1612</PointerOffset>
      <JapaneseText>この気候で育つのか？
常識では考えがたい。さすが異世界だな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3000</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2028</PointerOffset>
      <JapaneseText>あっ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2324</PointerOffset>
      <JapaneseText>味マスターさん？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2556</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>6</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>3332</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>7</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>3396</PointerOffset>
      <JapaneseText>ま、またお会いしましたね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3644</PointerOffset>
      <JapaneseText>そ、そうね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3916</PointerOffset>
      <JapaneseText>こ、この山に何かご用でも？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4188</PointerOffset>
      <JapaneseText>え、ええ。
大したことじゃないんだけど……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4660</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>12</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>4964</PointerOffset>
      <JapaneseText>も、もしかして……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5180</PointerOffset>
      <JapaneseText>あ、あなたの目的も……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5452</PointerOffset>
      <JapaneseText>……トマト？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5748</PointerOffset>
      <JapaneseText>…………ぷっ、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6004</PointerOffset>
      <JapaneseText>あははは！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6412</PointerOffset>
      <JapaneseText>まさか、同じ食材に目をつけるとはね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6628</PointerOffset>
      <JapaneseText>わたしも驚きました。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6844</PointerOffset>
      <JapaneseText>さすが、味マスターさんですね！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6956</PointerOffset>
      <JapaneseText>ふゆトマトはわたしだけの、
秘密兵器にしようと思ってたけど……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7076</PointerOffset>
      <JapaneseText>こうなったらとことん、
フェアにいきましょう！　こっちです！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7364</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>23</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>8236</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>24</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>8300</PointerOffset>
      <JapaneseText>セルシウス〜。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8612</PointerOffset>
      <JapaneseText>なに？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5300</SpeakerId>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8812</PointerOffset>
      <JapaneseText>あなたのトマト、
この人の分ももらっていい？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9060</PointerOffset>
      <JapaneseText>あれは、精霊の一種だ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3000</SpeakerId>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9292</PointerOffset>
      <JapaneseText>え？　ということは、
あの人がディムロスを直せるの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9620</PointerOffset>
      <JapaneseText>わたしは観賞用として、
ふゆトマトを育てているのに。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5300</SpeakerId>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9868</PointerOffset>
      <JapaneseText>美をめでるどころか、食すなんて。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5300</SpeakerId>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10116</PointerOffset>
      <JapaneseText>人間の感覚は、わからないわね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5300</SpeakerId>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10332</PointerOffset>
      <JapaneseText>あはは……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10556</PointerOffset>
      <JapaneseText>まあいいわ。
好きなだけ、持っていきなさい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5300</SpeakerId>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10724</PointerOffset>
      <JapaneseText>ありがと！
よかったですね、味マスターさん！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10980</PointerOffset>
      <JapaneseText>あ、はい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11180</PointerOffset>
      <JapaneseText>どうも。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11468</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>38</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>11820</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>39</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>11884</PointerOffset>
      <JapaneseText>それじゃ、帰りましょうか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12052</PointerOffset>
      <JapaneseText>そこのあなた。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5300</SpeakerId>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12268</PointerOffset>
      <JapaneseText>あたしですか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12524</PointerOffset>
      <JapaneseText>そう。
あなた、面白いものを持っているわね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5300</SpeakerId>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12836</PointerOffset>
      <JapaneseText>お初にお目にかかります。
偉大なる氷の精霊よ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3000</SpeakerId>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13228</PointerOffset>
      <JapaneseText>晶霊よ。この世界では、
我らはそう呼ばれている。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5300</SpeakerId>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13428</PointerOffset>
      <JapaneseText>失礼いたしました、晶霊よ。
質問をひとつ、よろしいでしょうか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3000</SpeakerId>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13740</PointerOffset>
      <JapaneseText>許します。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5300</SpeakerId>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13908</PointerOffset>
      <JapaneseText>私は自分の身を再生する術を求め、
異世界よりやってまいりました。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3000</SpeakerId>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13980</PointerOffset>
      <JapaneseText>この地のどこかに、
私の探す金属があるはずなのです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3000</SpeakerId>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14052</PointerOffset>
      <JapaneseText>ご存知であれば、
どうか教えていただきたい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3000</SpeakerId>
      <Id>50</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14172</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>51</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>14452</PointerOffset>
      <JapaneseText>ここより対面にあるところ。
レグルスの丘と呼ばれる場所へ行きなさい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5300</SpeakerId>
      <Id>52</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14620</PointerOffset>
      <JapaneseText>詳しくは、そこのファラに聞くといい。
そこに、あなたの求めるものがあります。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5300</SpeakerId>
      <Id>53</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14820</PointerOffset>
      <JapaneseText>レグルスの丘ですね。わかりました。
感謝いたします。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3000</SpeakerId>
      <Id>54</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15180</PointerOffset>
      <JapaneseText>だが、たとえ金属を手に入れたとしても、
この世界で剣に加工することはできません。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5300</SpeakerId>
      <Id>55</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15252</PointerOffset>
      <JapaneseText>あなたはさらに、
別の世界をおとなう必要があります。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5300</SpeakerId>
      <Id>56</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15372</PointerOffset>
      <JapaneseText>旅の終えんは、
すぐには訪れないと知りなさい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5300</SpeakerId>
      <Id>57</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15540</PointerOffset>
      <JapaneseText>ご助言、しかと心に刻みます。
氷の晶霊よ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3000</SpeakerId>
      <Id>58</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15828</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>59</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>16660</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>60</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>16724</PointerOffset>
      <JapaneseText>ふゆトマトが手に入って、よかったですね！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>61</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>16940</PointerOffset>
      <JapaneseText>あなたのおかげよ。ありがと。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>62</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17196</PointerOffset>
      <JapaneseText>これでまったく同じ材料を使って、
勝負することになりますね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>63</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17412</PointerOffset>
      <JapaneseText>ええ。あとは純粋に、
お互いの技を競い合うのみ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>64</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17580</PointerOffset>
      <JapaneseText>わたし、負けませんよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>65</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17748</PointerOffset>
      <JapaneseText>こちらこそ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>66</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17964</PointerOffset>
      <JapaneseText>全力でお相手させていただくわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>67</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18828</PointerOffset>
      <JapaneseText>スポ根やるのは勝手だけどよ……。
何もここじゃなくてもいいだろ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>68</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18948</PointerOffset>
      <JapaneseText>見ろ。
すっかりキールが凍っちまったぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>69</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>19284</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>70</Id>
      <Status>Done</Status>
    </Entry>
  </Strings>
</SceneText>
