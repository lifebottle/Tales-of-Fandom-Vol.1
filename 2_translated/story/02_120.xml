  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>652</PointerOffset>
      <JapaneseText>リーネの村</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>900</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>1</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>1060</PointerOffset>
      <JapaneseText>ボブおじさーん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1276</PointerOffset>
      <JapaneseText>おお、リリス。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5700</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1492</PointerOffset>
      <JapaneseText>トマト、なったんだって？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1652</PointerOffset>
      <JapaneseText>おことばに甘えて、もらいにきちゃった。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1876</PointerOffset>
      <JapaneseText>そうかそうか。
好きなだけ、もっていくといい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5700</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1988</PointerOffset>
      <JapaneseText>リリスはいつも喜んでくれるから、
あげがいがあるよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5700</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2156</PointerOffset>
      <JapaneseText>だってあたし、おじさんのトマト、
ほんとに大好きなんだもの！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2316</PointerOffset>
      <JapaneseText>おいしいトマトソースを作って、
お返しするからね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2524</PointerOffset>
      <JapaneseText>楽しみにしているよ。わしもマギーも、
リリスの料理のファンだからのう。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5700</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2884</PointerOffset>
      <JapaneseText>まっかせといてよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3092</PointerOffset>
      <JapaneseText>ほっほっほ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5700</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3532</PointerOffset>
      <JapaneseText>よし！　おじさんのトマトさえあれば、
きっと最高のペスカトーレが作れるわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3996</PointerOffset>
      <JapaneseText>自信たっぷりだな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3000</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4212</PointerOffset>
      <JapaneseText>おじさんの作ったものにかなうトマトなんて
異世界探したってあるはずないわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4436</PointerOffset>
      <JapaneseText>ディムロスにも食べさせてあげたいよ。
きっと驚くこと、間違いなしだよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4644</PointerOffset>
      <JapaneseText>ま、わたしには口がないからな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3000</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4764</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>18</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>5052</PointerOffset>
      <JapaneseText>もう一度あの異世界へ！
よろしくね、ディムロス。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5460</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>20</Id>
      <Status>Done</Status>
    </Entry>
  </Strings>
</SceneText>
