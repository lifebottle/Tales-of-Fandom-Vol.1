      <Notes>Single JP space line</Notes>
      <Id>31</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>8812</PointerOffset>
      <JapaneseText>ハイレベルな戦いが繰り広げられています！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8876</PointerOffset>
      <JapaneseText>両選手とも、まったく退く構えなし。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9324</PointerOffset>
      <JapaneseText>これは、すごい。
間違いなく、歴史に残る一戦だ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9588</PointerOffset>
      <JapaneseText>どっちが作る料理も、うめーんだろうな。
想像しただけで、腹が鳴りそうだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9804</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>36</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>9972</PointerOffset>
      <JapaneseText>さらに加えるのは「パスタ」&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9980</PointerOffset>
      <JapaneseText>さらに加えるのは「ライス」&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9988</PointerOffset>
      <JapaneseText>さらに加えるのは「ブレッド」&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10436</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>40</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>10548</PointerOffset>
      <JapaneseText>キール、気づいたか？　いつのまにか、
会場内がしんと静まり返っている。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10868</PointerOffset>
      <JapaneseText>ああ。
皆が固唾を飲んで見守っているんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11012</PointerOffset>
      <JapaneseText>息詰まる、とはまさにこのことだな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11228</PointerOffset>
      <JapaneseText>いよいよ、クライマックスか……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11468</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>45</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>11700</PointerOffset>
      <JapaneseText>仕上げは「まぐろ」&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11708</PointerOffset>
      <JapaneseText>仕上げは「ポテト」&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11716</PointerOffset>
      <JapaneseText>仕上げは「いか」&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11932</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>49</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>11996</PointerOffset>
      <JapaneseText>間もなく、終了となります。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>50</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12108</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>51</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>12724</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>52</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>12788</PointerOffset>
      <JapaneseText>鐘が鳴らされました。
これより、試食へ移ります。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>53</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13084</PointerOffset>
      <JapaneseText>どっちが勝ったと思う？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>54</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13300</PointerOffset>
      <JapaneseText>わからない。
接戦であることは、確かだが。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>55</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13868</PointerOffset>
      <JapaneseText>果たして栄光をつかむのは、どちらか？
味マスターか、それとも挑戦者か！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>6500</SpeakerId>
      <Id>56</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14076</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>57</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>14756</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>58</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>14844</PointerOffset>
      <JapaneseText>お……。
おいしーーーーーーーーーっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>59</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14940</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>60</Id>
      <Status>Done</Status>
    </Entry>
