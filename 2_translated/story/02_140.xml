      <SpeakerId>2600</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2604</PointerOffset>
      <JapaneseText>よし。これでこの世界の用はすんだ。
