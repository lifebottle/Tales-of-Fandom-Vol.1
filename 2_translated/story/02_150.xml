      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>1540</PointerOffset>
      <JapaneseText>お待たせ−、ディムロス。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1780</PointerOffset>
      <JapaneseText>遅い！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3000</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2012</PointerOffset>
      <JapaneseText>ごめんごめん。お夕飯のスープの準備、
してたからさ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2580</PointerOffset>
      <JapaneseText>なんでお前はそう……ええい、だから！
その手に握っているおたまはなんだ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3000</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3228</PointerOffset>
      <JapaneseText>あははは！　つい、持ってきちゃった。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3460</PointerOffset>
      <JapaneseText>あは、あはははは……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3684</PointerOffset>
      <JapaneseText>あははじゃない！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3000</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3924</PointerOffset>
      <JapaneseText>まあまあ。あって困るものでもないし。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4412</PointerOffset>
      <JapaneseText>なくても困らん！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3000</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4652</PointerOffset>
      <JapaneseText>もう、そんな怒ってばっかいないでさ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4860</PointerOffset>
      <JapaneseText>早く精霊さん、探しに行こうよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5172</PointerOffset>
      <JapaneseText>まったく……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3000</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
