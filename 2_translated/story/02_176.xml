    </Entry>
    <Entry>
      <PointerOffset>18148</PointerOffset>
      <JapaneseText>あ、ありがとう……ございまし……た……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>60</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18572</PointerOffset>
      <JapaneseText>クレス・アルベイン、敗れる！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>61</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18644</PointerOffset>
      <JapaneseText>時空の剣士、とうとう力尽きました！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>62</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18812</PointerOffset>
