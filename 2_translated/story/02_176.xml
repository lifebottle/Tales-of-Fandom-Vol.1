    <Entry>
      <PointerOffset>1044</PointerOffset>
      <JapaneseText>我が身の内に宿るすべてのともし火よ。
今こそ我が呼びかけに応えよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2060</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>2</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>2332</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>3</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>2492</PointerOffset>
      <JapaneseText>……不思議な旋律が、響いてくる。
どこから？　あたしの中から？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3140</PointerOffset>
      <JapaneseText>あの剣は、いったい何だ？
中から、ものすごい密度の気が……！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3652</PointerOffset>
      <JapaneseText>これに合わせて、口ずさめばいいのね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3948</PointerOffset>
      <JapaneseText>妙なる息吹を糧となし、
炎よ、翼持ちてはばたくがいい！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4516</PointerOffset>
      <JapaneseText>このままでは……まずい！
こちらから先に、仕掛けなければ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4660</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>9</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>5644</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>10</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>5852</PointerOffset>
      <JapaneseText>我らが内に宿りたる、
炎と風の雄こんなる調べ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6324</PointerOffset>
      <JapaneseText>今こそこの場に！　体現せしめん！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7044</PointerOffset>
      <JapaneseText>うなれ！
マキシマム・レッド・ブラスター！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7740</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>14</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>7892</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>15</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>8060</PointerOffset>
      <JapaneseText>こっ、これは？
何が起こったんだ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8132</PointerOffset>
      <JapaneseText>ものすごい光があふれ出たと思ったら、
いつのまにか、立っているのは少女だけだ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8380</PointerOffset>
      <JapaneseText>勝ったよ、ディムロス……どう？
あたし、ちゃんと当てたでしょ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8716</PointerOffset>
      <JapaneseText>ディムロス？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8884</PointerOffset>
      <JapaneseText>ちょっと。返事しなさいよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9268</PointerOffset>
      <JapaneseText>ディムロスったら！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9428</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>22</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>9724</PointerOffset>
      <JapaneseText>ううう……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10068</PointerOffset>
      <JapaneseText>あなた！　まだ立ち上がるつもり？
もう無理よ、やめなさい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10404</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>25</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>10628</PointerOffset>
      <JapaneseText>素晴らしい攻撃だった。
あれほどの技を見たのは、初めてだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10748</PointerOffset>
      <JapaneseText>どうやら僕は、思い違いをしていたらしい。
きみがダオスの手の者であるはずがない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10820</PointerOffset>
      <JapaneseText>なぜなら、きみの攻撃には、
よこしまなところがまるでないからだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10892</PointerOffset>
      <JapaneseText>川のせせらぎのように澄み切っている……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11188</PointerOffset>
      <JapaneseText>それでもあなたは、
そうやって剣を構えなおすのね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11388</PointerOffset>
      <JapaneseText>ああ。事実を知っても、剣士としての血が、
戦いをやめさせてくれない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11460</PointerOffset>
      <JapaneseText>きみのような強敵とめぐり会えたことで、
身体が喜びに震えているんだ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11836</PointerOffset>
      <JapaneseText>あなた、うちのお兄ちゃんそっくり。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12116</PointerOffset>
      <JapaneseText>強くなることにひたむきで。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12188</PointerOffset>
      <JapaneseText>どんな苦労もいとわなくて。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12260</PointerOffset>
      <JapaneseText>夢中になって、何も目に入らなくなるの。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12460</PointerOffset>
      <JapaneseText>あなたみたいな人には、
何をいってもダメなのよね。知ってるわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12660</PointerOffset>
      <JapaneseText>……あと一回よ。
それで、決着をつけましょ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13044</PointerOffset>
      <JapaneseText>ありがたい。ならば、今こそ見せよう！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13196</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>40</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>13716</PointerOffset>
