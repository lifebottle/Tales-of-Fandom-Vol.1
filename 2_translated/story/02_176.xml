      <Notes>Single JP space line</Notes>
      <Id>45</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>14924</PointerOffset>
      <JapaneseText>攻撃を受け止めている余裕はない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15132</PointerOffset>
      <JapaneseText>こっちからも攻撃して、相殺するしか！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
