      <Notes>Single JP space line</Notes>
      <Id>41</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>13828</PointerOffset>
      <JapaneseText>最終奥義！　冥空！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14028</PointerOffset>
      <JapaneseText>斬しょう剣！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14404</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
