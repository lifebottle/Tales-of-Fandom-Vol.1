    <Entry>
      <PointerOffset/>
      <JapaneseText>クレス・アルベイン</JapaneseText>
      <EnglishText>Cless Albane</EnglishText>
      <Notes>Reference only</Notes>
      <Id>3200</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>876</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>916</PointerOffset>
      <JapaneseText>ユークリッドの都</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1108</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>2</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>1268</PointerOffset>
      <JapaneseText>うう……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1756</PointerOffset>
      <JapaneseText>ディムロス、あたしの声、聞こえる？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1980</PointerOffset>
      <JapaneseText>リリス……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2228</PointerOffset>
      <JapaneseText>よかった……！　ディムロス、わかる？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2388</PointerOffset>
      <JapaneseText>あなた、元通りになったんだよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2724</PointerOffset>
      <JapaneseText>おお……！　この、全身にみなぎる充実感。
心地よい、鋼の重み。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2796</PointerOffset>
      <JapaneseText>確かに、かつてのわたしそのものだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3068</PointerOffset>
      <JapaneseText>ね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3236</PointerOffset>
      <JapaneseText>わたしが意識を失っている間に、
精霊を見つけてくれたのか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3452</PointerOffset>
      <JapaneseText>えへへ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3772</PointerOffset>
      <JapaneseText>感謝する。よくやってくれた、リリス。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4132</PointerOffset>
      <JapaneseText>返事してくれないときは、
どうなることかと思ったよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4204</PointerOffset>
      <JapaneseText>さっき、全エネルギーを放射するとか、
いってたよね。あれって……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4372</PointerOffset>
      <JapaneseText>人間でいうなら、生命力に等しいな。
あの後のわたしは、死んだも同然だった。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4444</PointerOffset>
      <JapaneseText>お前がこうして復活させてくれなかったら、
ずっとそのままだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4660</PointerOffset>
      <JapaneseText>やっぱり……もう！
なんでそんな危ないことするのよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4908</PointerOffset>
      <JapaneseText>お前ならきっと何とかしてくれると、
信じていたからだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5060</PointerOffset>
      <JapaneseText>そうだろう？　パートナーよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5308</PointerOffset>
      <JapaneseText>……ばか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5756</PointerOffset>
      <JapaneseText>あの口ぶりだと、うまくいったようだな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6300</PointerOffset>
      <JapaneseText>よかった……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6604</PointerOffset>
      <JapaneseText>ありがとうございます、クラースさん。
クレスさんも。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6772</PointerOffset>
      <JapaneseText>リリス！　そこにいるのは、
先ほど戦っていた剣士ではないか！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7180</PointerOffset>
      <JapaneseText>クレスさんよ。隣にいるのはクラースさん。
クラースさんがオリジンを呼んでくれたの。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7348</PointerOffset>
      <JapaneseText>オリジン？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7564</PointerOffset>
      <JapaneseText>精霊だよ！　オリジンが、ディムロスと、
リバヴィウス鉱を融合してくれたんだよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7732</PointerOffset>
      <JapaneseText>そうだったのか……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8084</PointerOffset>
      <JapaneseText>剣をきたえる精霊を探してるって聞いて、
すぐオリジンのことだとわかったよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8300</PointerOffset>
      <JapaneseText>わたしたちに出会えて、よかったな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8564</PointerOffset>
      <JapaneseText>リリスさん、申し訳ありませんでした。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8636</PointerOffset>
      <JapaneseText>なんておわびをしていいか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8852</PointerOffset>
      <JapaneseText>いいんですよ。クレスさんたちのおかげで、
ディムロスも元通りになったんですから。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8972</PointerOffset>
      <JapaneseText>終わりよければ、すべてよしです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9092</PointerOffset>
      <JapaneseText>久しぶりに暴れて、スカッとできましたし。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9340</PointerOffset>
      <JapaneseText>そういってもらえると、気が楽になります。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9508</PointerOffset>
      <JapaneseText>元はといえばいきなり空中に現われた、
我々のほうが悪いのだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9620</PointerOffset>
      <JapaneseText>あれで怪しまれないはずがない。
クレスどのの行動は、当然だ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9836</PointerOffset>
      <JapaneseText>我々、じゃないでしょ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10004</PointerOffset>
      <JapaneseText>いいや、連帯責任だ。
なぜならわたしたちは……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10316</PointerOffset>
      <JapaneseText>あーはいはい、パートナーだってんでしょ。
あんた、直るなり減らず口ばっかね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10668</PointerOffset>
      <JapaneseText>それで？　これからどうする？
すぐに、元の世界へ戻るのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10884</PointerOffset>
      <JapaneseText>そうですね。そろそろお夕飯のしたく、
しなくちゃいけないし。帰ります。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11156</PointerOffset>
      <JapaneseText>そうか。なら仕方ないな。
異世界の話を、もっと聞きたかったが。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11420</PointerOffset>
      <JapaneseText>リリスさん。もし僕の力が必要なら、
いつでもいってください。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11492</PointerOffset>
      <JapaneseText>時空を飛び越えて、
必ず助けにいきますから！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11740</PointerOffset>
      <JapaneseText>ありがと、クレスさん。
そのときはよろしくね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11940</PointerOffset>
      <JapaneseText>この世界の人々に、幸あらんことを。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12196</PointerOffset>
      <JapaneseText>ディムロスが、みなさんによろしくって。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>50</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12500</PointerOffset>
      <JapaneseText>それじゃ、あたしたち、行きます。
本当にどうも、ありがとうございました。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>51</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12820</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>52</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>13564</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>53</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>13772</PointerOffset>
      <JapaneseText>スカッとした、か。
あの子にはかなわないな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>54</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14116</PointerOffset>
      <JapaneseText>いい体験ができたと思えばいい。
そうだろう？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>55</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14332</PointerOffset>
      <JapaneseText>ええ。今日のことを反省材料に、
また自分を鍛え直します。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>56</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14628</PointerOffset>
      <JapaneseText>頑張れよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>57</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14892</PointerOffset>
      <JapaneseText>はい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>58</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15100</PointerOffset>
      <JapaneseText>デバッグ「クレスに勝った」&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>59</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15108</PointerOffset>
      <JapaneseText>デバッグ「クレスと相打ち」&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>60</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15484</PointerOffset>
      <JapaneseText>でも……おたまに負けたのは、
やっぱりショックですよ。はああ〜……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>61</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15796</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>62</Id>
      <Status>Done</Status>
    </Entry>
  </Strings>
</SceneText>
