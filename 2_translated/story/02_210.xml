  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <PointerOffset/>
      <JapaneseText>ソーディアン ディムロス</JapaneseText>
      <EnglishText>Swordian Dymlos</EnglishText>
      <Notes>Reference only</Notes>
      <Id>2900</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset/>
      <JapaneseText>リリス・エルロン</JapaneseText>
      <EnglishText>Lilith Aileron</EnglishText>
      <Notes>Reference only</Notes>
      <Id>2600</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>588</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>748</PointerOffset>
      <JapaneseText>プ、プレゼントお？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1084</PointerOffset>
      <JapaneseText>そ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1252</PointerOffset>
      <JapaneseText>誰が。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1468</PointerOffset>
      <JapaneseText>あなたが。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1636</PointerOffset>
      <JapaneseText>誰の。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1852</PointerOffset>
      <JapaneseText>お兄ちゃんの。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2060</PointerOffset>
      <JapaneseText>何の。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2276</PointerOffset>
      <JapaneseText>誕生日の。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2444</PointerOffset>
      <JapaneseText>プレゼントは、わたし？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2516</PointerOffset>
      <JapaneseText>誕生日のプレゼントに、わたしをあげる？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2876</PointerOffset>
      <JapaneseText>ちょっと待て、ちょっと待て！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3252</PointerOffset>
      <JapaneseText>何よ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3468</PointerOffset>
      <JapaneseText>なんだかそのことばの響きには、
非常に……抵抗を感じるぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3684</PointerOffset>
      <JapaneseText>そんなことないよ。
ぜんぜんおかしくないって。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3852</PointerOffset>
      <JapaneseText>あのな。
わたしは人格的には男だぞ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4164</PointerOffset>
      <JapaneseText>それがどうしたの？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4332</PointerOffset>
      <JapaneseText>わからないのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4588</PointerOffset>
      <JapaneseText>だから、何が？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4812</PointerOffset>
      <JapaneseText>はあ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5148</PointerOffset>
      <JapaneseText>プレゼントをどうするか、
決まらなくて悩んでたんだよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5316</PointerOffset>
      <JapaneseText>お兄ちゃん今度で２０才だからさ、
絶対喜んでもらえるものにしたかったの。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5388</PointerOffset>
      <JapaneseText>ディムロスだったら間違いないじゃない？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5556</PointerOffset>
      <JapaneseText>ああ、あたしってほんとに兄想いの妹。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5860</PointerOffset>
      <JapaneseText>それが別の理由か。なんということだ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6132</PointerOffset>
      <JapaneseText>さ、家に帰るわよ。
感動の、ごたいめーん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6348</PointerOffset>
      <JapaneseText>ま、待て！
待てというのに！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2900</SpeakerId>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6588</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>27</Id>
      <Status>Done</Status>
    </Entry>
  </Strings>
</SceneText>
