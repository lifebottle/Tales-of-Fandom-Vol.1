<SceneText>
  <FriendlyName>Conversation_0353</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x31d17b</PointerOffset>
      <JapaneseText>お〜いキール、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d18a</PointerOffset>
      <JapaneseText>イイこと教えてやる！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d1a1</PointerOffset>
      <JapaneseText>なんだイイことって！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d1b8</PointerOffset>
      <JapaneseText>また食べ物の話なんじゃないのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d1d9</PointerOffset>
      <JapaneseText>ちげーよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d1e4</PointerOffset>
      <JapaneseText>髪の毛のことだよ！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d1f9</PointerOffset>
      <JapaneseText>えっ！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d202</PointerOffset>
      <JapaneseText>髪の毛は古くなった頭皮が残ったり、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d225</PointerOffset>
      <JapaneseText>整髪料が毛穴につまると</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d23c</PointerOffset>
      <JapaneseText>生えにくくなるんだぜ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d253</PointerOffset>
      <JapaneseText>と、あと、あ〜んまり</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d268</PointerOffset>
      <JapaneseText>アタマ使ってるとハゲるらしいなぁ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d28b</PointerOffset>
      <JapaneseText>な、なにを根拠に……、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d2a2</PointerOffset>
      <JapaneseText>じゃあ天才はみなハゲるとでもいうのか！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d2cb</PointerOffset>
      <JapaneseText>天才ってのは、あんまりアタマ使わなくても</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d2f4</PointerOffset>
      <JapaneseText>エライから天才なんじゃねーの！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d315</PointerOffset>
      <JapaneseText>ううっ、じゃあボクは天才ではなく、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d338</PointerOffset>
      <JapaneseText>どちらかというと秀才タイプで、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d357</PointerOffset>
      <JapaneseText>頭よく使うからハゲるかもしれない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d37a</PointerOffset>
      <JapaneseText>『けけけ、考えろ、考えろっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d397</PointerOffset>
      <JapaneseText>そしてハゲろぉ！！』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d3ac</PointerOffset>
      <JapaneseText>キール、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d3b5</PointerOffset>
      <JapaneseText>メルディがしつもんあるよ〜</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d3d0</PointerOffset>
      <JapaneseText>なんでヴォルトに</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d3e1</PointerOffset>
      <JapaneseText>髪の毛ないかなぁ〜☆</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d3f6</PointerOffset>
      <JapaneseText>うあぁぁぁぁああ！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d40b</PointerOffset>
      <JapaneseText>なあなあ、なんでかな〜？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d424</PointerOffset>
      <JapaneseText>キールぅ☆</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d42f</PointerOffset>
      <JapaneseText>『メルディ、あどけない顔して</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x31d44c</PointerOffset>
      <JapaneseText>さらりとトドメさしやがった！！』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
