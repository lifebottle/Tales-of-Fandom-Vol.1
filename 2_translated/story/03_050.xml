  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>524</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>652</PointerOffset>
      <JapaneseText>実験室</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1332</PointerOffset>
      <JapaneseText>……ん？				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1596</PointerOffset>
      <JapaneseText>はあ、はあ。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1916</PointerOffset>
      <JapaneseText>プリムラじゃないか！
なにやってるんだ、そんな窓から！？	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2228</PointerOffset>
      <JapaneseText>い、いいから手、貸してってば！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2948</PointerOffset>
      <JapaneseText>はあ、はあ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3220</PointerOffset>
      <JapaneseText>なんだか大変な事になっちゃったね。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3484</PointerOffset>
      <JapaneseText>うむ……。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3748</PointerOffset>
      <JapaneseText>あなたは、やってないのよね？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4084</PointerOffset>
      <JapaneseText>当たり前だ！
まさかおまえ、僕のことを――		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4404</PointerOffset>
      <JapaneseText>そんなわけないでしょ！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4732</PointerOffset>
      <JapaneseText>一応確認しただけよ。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4996</PointerOffset>
      <JapaneseText>……くそっ！
いったい誰が、なんのためにこんな事を。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5260</PointerOffset>
      <JapaneseText>安心して、キール。
私が絶対になんとかしてあげるから！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5364</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5708</PointerOffset>
      <JapaneseText>余計なことはしなくていい。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5972</PointerOffset>
      <JapaneseText>え？					</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6236</PointerOffset>
      <JapaneseText>なにもしなくていいって言ったんだ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6308</PointerOffset>
      <JapaneseText>教授会が終わるまであと６メウム。
こうなったら静かに待つしかない。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6604</PointerOffset>
      <JapaneseText>で、でも――				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6892</PointerOffset>
      <JapaneseText>君がどうこうできる問題じゃない。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6964</PointerOffset>
      <JapaneseText>君ひとりでなにか事件を解決したことが
いままで一回でもあったか？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7244</PointerOffset>
      <JapaneseText>打開策はひとりで考える。
帰ってくれ。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7748</PointerOffset>
      <JapaneseText>キールのバカ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8252</PointerOffset>
      <JapaneseText>うわーん！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8380</PointerOffset>
      <JapaneseText>お、おい！？				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8452</PointerOffset>
      <JapaneseText>なんだ君は！　どこから入った！？
ちょっと待て、おーい……！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8748</PointerOffset>
      <JapaneseText>ありがとう、プリムラ。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
