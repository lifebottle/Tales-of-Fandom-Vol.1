    </Entry>
    <Entry>
      <PointerOffset/>
      <JapaneseText>Keele Zeibel</JapaneseText>
      <EnglishText>Keele Zeibel</EnglishText>
      <Notes>Reference only</Notes>
      <Id>300</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset/>
      <JapaneseText>Cinq Lissajous</JapaneseText>
      <EnglishText>Cinq Lissajous</EnglishText>
      <Notes>Reference only</Notes>
      <Id>1700</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>1052</PointerOffset>
      <JapaneseText>くすん。ありがとう。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1292</PointerOffset>
      <JapaneseText>このまま入学金が見つからなかったら、
私、どうすればいいかって……ぐすっ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1508</PointerOffset>
      <JapaneseText>本当にありがとう！
このお礼はいつか必ず――		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1772</PointerOffset>
      <JapaneseText>礼なんて必要ない。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1988</PointerOffset>
      <JapaneseText>偶然通りがかって、思いついたことを
指摘したまでだ。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2252</PointerOffset>
      <JapaneseText>そうかー！　私はてっきり、
お母さんが名前を書いたパンツを		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2324</PointerOffset>
      <JapaneseText>私に見られたからだとばかり――		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2588</PointerOffset>
      <JapaneseText>うわー！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2860</PointerOffset>
      <JapaneseText>黙れっ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3212</PointerOffset>
      <JapaneseText>ん？	パンツ？	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1700</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3500</PointerOffset>
      <JapaneseText>なんでもない！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3756</PointerOffset>
      <JapaneseText>その、パンを作ったら焦げて……。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3996</PointerOffset>
      <JapaneseText>あー……なんでもないんだ！
忘れてくれ、サンク！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4324</PointerOffset>
      <JapaneseText>さ、さあて、帰って勉強でも――　</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4812</PointerOffset>
      <JapaneseText>うわっ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5372</PointerOffset>
      <JapaneseText>いたたた……。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5724</PointerOffset>
      <JapaneseText>ぷっ！					</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5988</PointerOffset>
      <JapaneseText>わ、笑うなっ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6436</PointerOffset>
      <JapaneseText>あははははは。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6700</PointerOffset>
      <JapaneseText>はははははは。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1700</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7012</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>20</Id>
      <Status>Done</Status>
    </Entry>
  </Strings>
</SceneText>
