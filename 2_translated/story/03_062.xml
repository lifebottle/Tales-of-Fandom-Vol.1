<SceneText>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <PointerOffset/>
      <JapaneseText>プリムラ・ロッソ</JapaneseText>
      <EnglishText>Primula Rosso</EnglishText>
      <Notes>Reference only</Notes>
      <Id>1100</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>724</PointerOffset>
      <JapaneseText>ふふふ……。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>796</PointerOffset>
      <JapaneseText>キールって頭がいいし超然としてるから
付き合いにくい感じがするけど、		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>868</PointerOffset>
      <JapaneseText>そんなことないんだよね。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>940</PointerOffset>
      <JapaneseText>ホントはおっちょこちょいで、優しいところもあって……。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1092</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1420</PointerOffset>
      <JapaneseText>……もしかして……。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1516</PointerOffset>
      <JapaneseText>キールは私を巻き込まないように
『余計なことをするな』って……。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1668</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1996</PointerOffset>
      <JapaneseText>よしっ！
こんなところでイジイジしてられない！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2252</PointerOffset>
      <JapaneseText>前向きなのが私のいいとこじゃない！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2468</PointerOffset>
      <JapaneseText>考えて！
考えるのよプリムラ！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2892</PointerOffset>
      <JapaneseText>こんなとき、キールならどうするかって！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3036</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>12</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>3084</PointerOffset>
      <JapaneseText>部屋にこもって考える&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3092</PointerOffset>
      <JapaneseText>町の中で情報収集をする&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
