  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>612</PointerOffset>
      <JapaneseText>カフェテリア</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>972</PointerOffset>
      <JapaneseText>情報収集は探偵の基本！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1044</PointerOffset>
      <JapaneseText>人が集まるカフェで、
とっかかりになる情報をゲットよ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1260</PointerOffset>
      <JapaneseText>どんなつまらない日常会話の中からも	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1476</PointerOffset>
      <JapaneseText>真実に繋がる糸口を見出す。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1548</PointerOffset>
      <JapaneseText>これが真の名探偵というものよね！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1764</PointerOffset>
      <JapaneseText>……どれどれ。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2100</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>7</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>2644</PointerOffset>
      <JapaneseText>――そしたらアイツむくれちゃって、
もうご機嫌取りに大変だよ！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2908</PointerOffset>
      <JapaneseText>それって、一〇二に住んでる子だっけ？	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3172</PointerOffset>
      <JapaneseText>いや、三〇一のほう。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3436</PointerOffset>
      <JapaneseText>二股はやばいって、アンタ！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3700</PointerOffset>
      <JapaneseText>愛を分け与えるのは、モテる男の義務さ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4140</PointerOffset>
      <JapaneseText>ぎゃはは、よく言うわよ。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4356</PointerOffset>
      <JapaneseText>ぎゃははは！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4668</PointerOffset>
      <JapaneseText>ところで今度のコンパだけどさぁ――	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4956</PointerOffset>
      <JapaneseText>ちょっとー！　アンタたち、
もう少し身のある会話しなさいよっ！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5516</PointerOffset>
      <JapaneseText>な、なに……あんた？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5828</PointerOffset>
      <JapaneseText>ミンツの学生のくせにベチャベチャ
つまんない話してんじゃないわよ！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6092</PointerOffset>
      <JapaneseText>こっちは貴重な時間を裂いて
アンタたちの話聞いてるんだから！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6620</PointerOffset>
      <JapaneseText>は、話聞いてたって――			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6884</PointerOffset>
      <JapaneseText>そもそもアンタ程度の男がよ、		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7004</PointerOffset>
      <JapaneseText>二股とかいって女の子のハートを
もてあそんで許されると思ってるわけ！？	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7348</PointerOffset>
      <JapaneseText>ムカツクー！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7676</PointerOffset>
      <JapaneseText>ね？　みんなもそう思うでしょ！？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8020</PointerOffset>
      <JapaneseText>ありがとう！
ありがとーう！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8852</PointerOffset>
      <JapaneseText>う、うう……なんなんだ。
おれたちにどうしろって言うんだ？	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9116</PointerOffset>
      <JapaneseText>情報よ！　ネタよ！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9236</PointerOffset>
      <JapaneseText>なにかないワケ、こう……。　</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9452</PointerOffset>
      <JapaneseText>超ビッグニュース、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9764</PointerOffset>
      <JapaneseText>みたいな！？				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10028</PointerOffset>
      <JapaneseText>ビッグニュースって言われても……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10292</PointerOffset>
      <JapaneseText>ジロッ！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10748</PointerOffset>
      <JapaneseText>そ、そういえば！
この前捕まった爆弾魔がいるだろ？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10940</PointerOffset>
      <JapaneseText>大学の地下に監禁されてるんだけど、	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11012</PointerOffset>
      <JapaneseText>そいつを引き取りに今晩、インフェリア
からロエンって人が来るらしいぜ！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11276</PointerOffset>
      <JapaneseText>それがどうしたっていうのよ！
そんな解決した事件の情報なんて……。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11972</PointerOffset>
      <JapaneseText>情報なんて……。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12236</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12508</PointerOffset>
      <JapaneseText>…………。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12732</PointerOffset>
      <JapaneseText>…………。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13052</PointerOffset>
      <JapaneseText>あ、あの〜、もしもし？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
