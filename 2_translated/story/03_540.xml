  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>1116</PointerOffset>
      <JapaneseText>ジャッコはいないみたいね……。
本当はこんなのマズイんだけど――		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1800</SpeakerId>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1188</PointerOffset>
      <JapaneseText>時間がないからゴメンナサイ、と。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1800</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1324</PointerOffset>
      <JapaneseText>ジャッコの部屋</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1732</PointerOffset>
      <JapaneseText>ゴメンナサイついでに、
ちょっくら調べさせてもらうわよ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1804</PointerOffset>
      <JapaneseText>いつ帰ってくるかわからないから
手早く、手早く……ね。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2100</PointerOffset>
      <JapaneseText>机を調べる&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2108</PointerOffset>
      <JapaneseText>ベッドを調べる&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2116</PointerOffset>
      <JapaneseText>本棚を調べる&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2124</PointerOffset>
      <JapaneseText>床を調べる&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2908</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3204</PointerOffset>
      <JapaneseText>ゴチャゴチャした机ね……。
なにがなんだかさっぱり。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3276</PointerOffset>
      <JapaneseText>完璧に調べるには相当時間がいるわね。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3780</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4100</PointerOffset>
      <JapaneseText>時間がかかりすぎるわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4172</PointerOffset>
      <JapaneseText>もっと簡単に調べられる場所から
先に調べるべきね。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4996</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5292</PointerOffset>
      <JapaneseText>とりあえず何もないわね。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5412</PointerOffset>
      <JapaneseText>なんだかすっぱい匂いが……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5580</PointerOffset>
      <JapaneseText>男子の部屋ってフケツでいやね！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6092</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6388</PointerOffset>
      <JapaneseText>やっぱり何もないみたい。
すっぱい匂いだけね、ウン。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7396</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7900</PointerOffset>
      <JapaneseText>ミンツの学生のくせに本棚スカスカ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8116</PointerOffset>
      <JapaneseText>この程度なら本のあいだを調べても、
たいした時間はかからないわね。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8188</PointerOffset>
      <JapaneseText>さて……。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9268</PointerOffset>
      <JapaneseText>あっ！　変な紙が挟んである！&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9668</PointerOffset>
      <JapaneseText>なになに……				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9740</PointerOffset>
      <JapaneseText>『未徴収者リスト。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9812</PointerOffset>
      <JapaneseText>Ｗ・Ｗ					</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9884</PointerOffset>
      <JapaneseText>Ａ・Ｈ					</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9956</PointerOffset>
      <JapaneseText>Ａ・Ｌ』				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10060</PointerOffset>
      <JapaneseText>なんだろう、コレ……？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10284</PointerOffset>
      <JapaneseText>！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10924</PointerOffset>
      <JapaneseText>ん〜？　鍵かけ忘れたか？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1800</SpeakerId>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11148</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11348</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11652</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1800</SpeakerId>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11948</PointerOffset>
      <JapaneseText>気のせいか。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1800</SpeakerId>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12708</PointerOffset>
      <JapaneseText>よいしょ、よいしょ……！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13012</PointerOffset>
      <JapaneseText>ふう、間一髪！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13228</PointerOffset>
      <JapaneseText>それにしても私、
なんだか窓にぶら下がってばっかりね。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14540</PointerOffset>
      <JapaneseText>床は床よね。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14612</PointerOffset>
      <JapaneseText>時間がないのにこんなところを
調べている場合じゃないわね。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
