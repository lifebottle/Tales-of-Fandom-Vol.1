      <JapaneseText>アンの部屋</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>940</PointerOffset>
      <JapaneseText>なによ、あなた？
私に何かご用かしら？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1116</PointerOffset>
      <JapaneseText>ジャッコの使いだと嘘をつく&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1124</PointerOffset>
      <JapaneseText>正直に協力を申し出る&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1500</PointerOffset>
      <JapaneseText>そうね。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1572</PointerOffset>
      <JapaneseText>ジャッコの使い、って言えば
わかってもらえるかしら？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2324</PointerOffset>
      <JapaneseText>あ、ちょっと待って！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2396</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2468</PointerOffset>
      <JapaneseText>う〜ん、なんかワケアリっぽくは
あるんだけど……。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2780</PointerOffset>
      <JapaneseText>私、探偵部のプリムラといいます。
ジャッコの事をちょっと聞きたくて――	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3052</PointerOffset>
      <JapaneseText>…………。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3412</PointerOffset>
      <JapaneseText>あ、ちょっと待って！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
