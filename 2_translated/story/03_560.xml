    <Entry>
      <PointerOffset>508</PointerOffset>
      <JapaneseText>ウィリアムの部屋</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>940</PointerOffset>
      <JapaneseText>なんだよ、おまえ？
僕に何か用か？				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1116</PointerOffset>
      <JapaneseText>ジャッコの使いだと嘘をつく&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1124</PointerOffset>
      <JapaneseText>正直に協力を申し出る&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes>Choice text</Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1500</PointerOffset>
      <JapaneseText>そうね。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1572</PointerOffset>
      <JapaneseText>ジャッコの使い、って言えば
わかってもらえるかしら？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2324</PointerOffset>
      <JapaneseText>あ、ちょっと待って！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2396</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2468</PointerOffset>
      <JapaneseText>う〜ん、なんかワケアリっぽくは
あるんだけど……。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2828</PointerOffset>
      <JapaneseText>私、探偵部のプリムラといいます。
ジャッコの事をちょっと聞きたくて――	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3100</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3460</PointerOffset>
      <JapaneseText>あ、ちょっと待って！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3532</PointerOffset>
