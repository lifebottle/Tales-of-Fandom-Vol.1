  <FriendlyName>03_635</FriendlyName>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <PointerOffset/>
      <JapaneseText>Anne Hideaway</JapaneseText>
      <EnglishText>Anne Hideaway</EnglishText>
      <Notes>Reference only</Notes>
      <Id>1300</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset/>
      <JapaneseText>Primula Rosso</JapaneseText>
      <EnglishText>Primula Rosso</EnglishText>
      <Notes>Reference only</Notes>
      <Id>1100</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>772</PointerOffset>
      <JapaneseText>試験勉強で徹夜続きでお肌がカサカサ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1188</PointerOffset>
      <JapaneseText>しっかり考えて行動すると、
名探偵ポイントがあがるらしいわよ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1292</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1652</PointerOffset>
      <JapaneseText>伝説の生物ねこにん……。
友達になりたい……。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2068</PointerOffset>
      <JapaneseText>適当に移動していると名探偵ポイントが
下がっちゃうわよ。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2172</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2532</PointerOffset>
      <JapaneseText>ウルタス・ブイの劇、観に行きたいなあ……</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2948</PointerOffset>
      <JapaneseText>適当に動き回るくらいなら
アドバイスを仰いだほうが賢明ね		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3052</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3412</PointerOffset>
      <JapaneseText>大晶霊が主人公の小説を書いているの。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3484</PointerOffset>
      <JapaneseText>イフリート様は知性的で、
ハンサムなお方なのよ。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3556</PointerOffset>
      <JapaneseText>ああ、イフリート様……。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3972</PointerOffset>
      <JapaneseText>王都から来るロエンって人、
アレンデ姫にぞっこんなんだって！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4388</PointerOffset>
      <JapaneseText>世界は謎に満ちている……ぶつぶつぶつ……</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5028</PointerOffset>
      <JapaneseText>あてずっぽうに動いても時間の無駄だわ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5244</PointerOffset>
      <JapaneseText>ちゃんと考えて行動しなくちゃ
名探偵の名が泣くわ！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5628</PointerOffset>
      <JapaneseText>あてずっぽうに動いても無意味だわ！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5844</PointerOffset>
      <JapaneseText>	ここはよーく考えて……考えて……
考えて……。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6132</PointerOffset>
      <JapaneseText>プリムラ。僕は実は……。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6204</PointerOffset>
      <JapaneseText>セレスティアから来た
セレスティア王子なんだ！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6276</PointerOffset>
      <JapaneseText>えーっ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6740</PointerOffset>
      <JapaneseText>……はっ？！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6956</PointerOffset>
      <JapaneseText>また無意味な妄想に逃げてしまった……。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7380</PointerOffset>
      <JapaneseText>教室</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
