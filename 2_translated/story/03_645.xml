<SceneText>
  <FriendlyName>03_645</FriendlyName>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <PointerOffset/>
      <JapaneseText>Roen Lamoa</JapaneseText>
      <EnglishText>Roen Lamoa</EnglishText>
      <Notes>Reference only</Notes>
      <Id>1500</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>660</PointerOffset>
      <JapaneseText>近き者はその目に見よ、
遠き者は耳に聞け！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1500</SpeakerId>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>732</PointerOffset>
      <JapaneseText>我が名はロエン・ラーモア！
栄光あるインフェリアの衛兵隊長だ！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1500</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>804</PointerOffset>
      <JapaneseText>もう安心だ、ミンツの民よ。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1500</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>876</PointerOffset>
      <JapaneseText>俺が来たからには、犯罪者どもに
でかい面はさせんぞ！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1500</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>948</PointerOffset>
      <JapaneseText>なぜなら俺は正義の使者、
ロエン・ラーモアだからだッ！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1500</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1068</PointerOffset>
      <JapaneseText>……ウム、我ながら決まったな。
また伝説を作ってしまった……。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1500</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1284</PointerOffset>
      <JapaneseText>いつかアレンデ姫のお耳に届けば
好感度アップ間違いなし！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1500</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1404</PointerOffset>
      <JapaneseText>オラ、とっとと歩かんか犯罪者ども！
ふっふっふ。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1500</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1668</PointerOffset>
      <JapaneseText>うわーっはっはっは！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1500</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1860</PointerOffset>
      <JapaneseText>その後、
キールの姿を見た者はいない……。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1500</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
