<SceneText>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <PointerOffset/>
      <JapaneseText>ウィリアム・ウォーベック</JapaneseText>
      <EnglishText>William Warbeck</EnglishText>
      <Notes>Reference only</Notes>
      <Id>1200</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset/>
      <JapaneseText>プリムラ・ロッソ</JapaneseText>
      <EnglishText>Primula Rosso</EnglishText>
      <Notes>Reference only</Notes>
      <Id>1100</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>644</PointerOffset>
      <JapaneseText>なんだい、君は？
勉強の邪魔だ、帰ってくれ！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1068</PointerOffset>
      <JapaneseText>黒体の異変は吉兆だというのが
セイファート教会の公式見解だけど……。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1140</PointerOffset>
      <JapaneseText>僕はちょっと変だと思うんだ。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1212</PointerOffset>
      <JapaneseText>まあ、表立ってケチつけるほど
バカじゃないけどね……			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1636</PointerOffset>
      <JapaneseText>噂だけど、試験問題が金で買えるらしいぜ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1708</PointerOffset>
      <JapaneseText>誰に頼めばいいのか、わかったら僕にも
教えてくれよ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2132</PointerOffset>
      <JapaneseText>ラシュアンを知っているかい？
メチャクチャ田舎なんだぜ。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2548</PointerOffset>
      <JapaneseText>死ぬまでに一回でいいから
大晶霊とあってみたいなぁ。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2964</PointerOffset>
      <JapaneseText>君も大晶霊ウンディーネのファンクラブに
入会しないか！？	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3388</PointerOffset>
      <JapaneseText>イフリートのイメージカラーは赤！
試験に出るぞ！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3836</PointerOffset>
      <JapaneseText>隣の部屋のヤツが犯人だよ！
昨日も遅くまで酒飲んで大騒ぎしてたし！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4252</PointerOffset>
      <JapaneseText>キール？　アイツ、感じ悪いよね……。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4892</PointerOffset>
      <JapaneseText>あてずっぽうに動いても時間の無駄だわ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5108</PointerOffset>
      <JapaneseText>ちゃんと考えて行動しなくちゃ
名探偵の名が泣くわ！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5492</PointerOffset>
      <JapaneseText>あてずっぽうに動いても無意味だわ！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5708</PointerOffset>
      <JapaneseText>	ここはよーく考えて……考えて……
考えて……。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5996</PointerOffset>
      <JapaneseText>プリムラ。僕は実は……。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6068</PointerOffset>
      <JapaneseText>セレスティアから来た
セレスティア王子なんだ！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6140</PointerOffset>
      <JapaneseText>えーっ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6604</PointerOffset>
      <JapaneseText>……はっ？！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6820</PointerOffset>
      <JapaneseText>また無意味な妄想に逃げてしまった……。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7340</PointerOffset>
      <JapaneseText>ジェイムズの部屋</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
