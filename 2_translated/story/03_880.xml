      <EnglishText>Primula Rosso</EnglishText>
      <Notes>Reference only</Notes>
      <Id>1100</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset/>
      <JapaneseText>Janko Ribera</JapaneseText>
      <EnglishText>Janko Ribera</EnglishText>
      <Notes>Reference only</Notes>
      <Id>1800</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>476</PointerOffset>
      <JapaneseText>大食堂</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>844</PointerOffset>
      <JapaneseText>貴族だけに、いいもの食べてるわね。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1108</PointerOffset>
      <JapaneseText>ちょっとつまみ食い……
そんな場合じゃないか。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1740</PointerOffset>
      <JapaneseText>へっへっへ。
見つけたぜ女ァ！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1800</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2228</PointerOffset>
      <JapaneseText>縛って洞窟に転がしておいたのに……
しつこいわねえ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2516</PointerOffset>
      <JapaneseText>てめえをブっ殺してレイゼン卿に
詫びいれることにするぜ……！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1800</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2588</PointerOffset>
      <JapaneseText>食らえ、ウィンドカッター！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1800</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2964</PointerOffset>
      <JapaneseText>避けるっ！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3580</PointerOffset>
      <JapaneseText>あーっ！
壊れた壁の向こうに隠し通路発見！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4148</PointerOffset>
      <JapaneseText>く、くそーっ！
見るなっ。見るんじゃねーよ！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1800</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4404</PointerOffset>
      <JapaneseText>レイゼン卿に殺されちまう〜！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1800</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4740</PointerOffset>
      <JapaneseText>…………。
あんた、バカね。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5004</PointerOffset>
      <JapaneseText>うがーっ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1800</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5620</PointerOffset>
      <JapaneseText>バカに構ってるほど暇じゃないの。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6420</PointerOffset>
      <JapaneseText>それっ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6868</PointerOffset>
      <JapaneseText>ぎゃーーー！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7196</PointerOffset>
      <JapaneseText>失礼あそばせ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
