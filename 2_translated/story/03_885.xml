    </Entry>
    <Entry>
      <PointerOffset/>
      <JapaneseText>Janko Ribera</JapaneseText>
      <EnglishText>Janko Ribera</EnglishText>
      <Notes>Reference only</Notes>
      <Id>1800</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>748</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>1004</PointerOffset>
      <JapaneseText>うわ―……。
捕まっちゃった……。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1268</PointerOffset>
      <JapaneseText>貴様バカか？
貴族の館に殴り込むとはな！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>6300</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1964</PointerOffset>
      <JapaneseText>失礼ね！
殴り込んだんじゃなくて忍びこんだのよ！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2372</PointerOffset>
      <JapaneseText>うるせえ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1800</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2700</PointerOffset>
      <JapaneseText>とにかくこれだけ派手にやったんだ。
覚悟はできてるんだろうな？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1800</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2996</PointerOffset>
      <JapaneseText>もう小細工はさせねえ。
一気にぶった切ってやる！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1800</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3356</PointerOffset>
      <JapaneseText>…………。
ば、万事休すか……			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3428</PointerOffset>
      <JapaneseText>キール……！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3652</PointerOffset>
      <JapaneseText>待てっ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3964</PointerOffset>
      <JapaneseText>！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1800</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4228</PointerOffset>
      <JapaneseText>！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>6300</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4564</PointerOffset>
      <JapaneseText>だ、だれっ！？				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4684</PointerOffset>
      <JapaneseText>正義の味方、
とでもいっておこうか。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4756</PointerOffset>
      <JapaneseText>たぁーっ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4940</PointerOffset>
      <JapaneseText>ぎゃー！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5012</PointerOffset>
      <JapaneseText>うわー！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5084</PointerOffset>
      <JapaneseText>…………。
さあ、早く逃げたまえ。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5156</PointerOffset>
      <JapaneseText>あ、ありがとうございます。
あなたは一体？				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5228</PointerOffset>
      <JapaneseText>「評議会」の事は任せておけ。
君の友人も悪いようにはしない。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5300</PointerOffset>
      <JapaneseText>私の事は……忘れたほうがいい。
……さらばだ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5804</PointerOffset>
      <JapaneseText>いったい誰だったのかしら……？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
