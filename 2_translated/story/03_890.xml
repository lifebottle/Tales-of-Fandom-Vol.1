      <EnglishText>Dragon</EnglishText>
      <Notes>Reference only</Notes>
      <Id>5400</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>572</PointerOffset>
      <JapaneseText>レイゼン家前</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>996</PointerOffset>
      <JapaneseText>はあ、はあ。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1172</PointerOffset>
      <JapaneseText>証拠はゲットできなかったけど、
これ以上は無理みたい！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1244</PointerOffset>
      <JapaneseText>ロエンとかいう人が来る前に
キールを助け出さなくちゃ――		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1596</PointerOffset>
      <JapaneseText>はあ、はあ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1772</PointerOffset>
      <JapaneseText>隠し部屋で証拠もゲットしたし、
いつまでも長居は無用ね！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1844</PointerOffset>
      <JapaneseText>ロエンとかいう人が来る前に
キールを助け出さなくちゃ――		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2436</PointerOffset>
      <JapaneseText>！！！！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2908</PointerOffset>
      <JapaneseText>！！！！
ド、ドラゴン！？				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3220</PointerOffset>
      <JapaneseText>はあ、はあ、はあ。
逃がしゃしねえぞ、女ァ。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1800</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3292</PointerOffset>
      <JapaneseText>レイゼン卿のペットを放したとあっちゃ
タダじゃすまねえが……			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1800</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3364</PointerOffset>
      <JapaneseText>それでもてめえをぶっ殺せるなら
構やしねえ！　かかれッ！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1800</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3628</PointerOffset>
      <JapaneseText>グオオオオーーーッ！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5400</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
