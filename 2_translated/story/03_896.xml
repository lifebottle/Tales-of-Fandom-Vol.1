      <Id>73</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>20380</PointerOffset>
      <JapaneseText>「評議会」とやらの秘密、
洗いざらい話してもらうぞ。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1500</SpeakerId>
      <Id>74</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>20724</PointerOffset>
      <JapaneseText>ば、ばかな！
一体何の証拠があって――		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1400</SpeakerId>
      <Id>75</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>20988</PointerOffset>
      <JapaneseText>黙れ！					</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1500</SpeakerId>
      <Id>76</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>21356</PointerOffset>
      <JapaneseText>よし、しょっぴけ！
館の周りも固めておけよ！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1500</SpeakerId>
      <Id>77</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>21764</PointerOffset>
      <JapaneseText>ひいっ！
た、助けて！　助けてくれー！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1400</SpeakerId>
      <Id>78</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>21916</PointerOffset>
      <JapaneseText>大学の地位が……
大学の地位がーーーーっ！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1400</SpeakerId>
      <Id>79</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>21988</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1400</SpeakerId>
      <Id>80</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>22060</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1400</SpeakerId>
      <Id>81</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>22356</PointerOffset>
      <JapaneseText>終わった、のかな？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>82</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>22620</PointerOffset>
      <JapaneseText>のようだな。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>83</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>22884</PointerOffset>
      <JapaneseText>ふふ……。
キール、煤だらけで変な顔！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>84</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>23148</PointerOffset>
      <JapaneseText>お、お前だって！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>85</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>23412</PointerOffset>
      <JapaneseText>あははは。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>86</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>23628</PointerOffset>
      <JapaneseText>でも本当に良かった。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>87</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>23700</PointerOffset>
      <JapaneseText>一年前の恩返しもできたっぽいし！
これであなたと私は対等ってことよね！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>88</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>23772</PointerOffset>
      <JapaneseText>もうダ・メー探偵だなんて
バカにさせないから！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>89</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>24036</PointerOffset>
      <JapaneseText>はいはい。
わかりましたよ、名探偵さま。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>90</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>24300</PointerOffset>
      <JapaneseText>よーし！
それじゃあ町に戻ってパーッと食事でも――　</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>91</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>24444</PointerOffset>
      <JapaneseText>そうはいかんよ、
名探偵殿？				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>92</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
