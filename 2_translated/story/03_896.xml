    <Entry>
      <PointerOffset>2156</PointerOffset>
      <JapaneseText>なんだ！？
い、いまの輝きは一体……！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2404</PointerOffset>
      <JapaneseText>……あれ？　あれれれ？
