      <Id>94</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>25372</PointerOffset>
      <JapaneseText>貴様！
どうやって抜け出した！？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>95</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>25636</PointerOffset>
      <JapaneseText>君だって抜け出したじゃないか。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1600</SpeakerId>
      <Id>96</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>25708</PointerOffset>
      <JapaneseText>間抜けな見張りをあざむくくらい
なんということはないさ……。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1600</SpeakerId>
      <Id>97</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>25780</PointerOffset>
      <JapaneseText>護送車に移される際のごたごたを利用して
気持ちよくスルリと抜けさせてもらったよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1600</SpeakerId>
      <Id>98</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>26044</PointerOffset>
      <JapaneseText>……なんの用かしら！？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>99</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>26308</PointerOffset>
      <JapaneseText>オイオイ。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1600</SpeakerId>
      <Id>100</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>26380</PointerOffset>
