    <Entry>
      <PointerOffset>1028</PointerOffset>
      <JapaneseText>実験室</JapaneseText>
      <EnglishText/>
      <Notes>System Message</Notes>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1580</PointerOffset>
      <JapaneseText>はあ。					</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1652</PointerOffset>
      <JapaneseText>「君にはついていけない」って
キールも退部しちゃったし……		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1724</PointerOffset>
      <JapaneseText>なんだか寂しくなっちゃったな、探偵部。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2044</PointerOffset>
      <JapaneseText>しょうがないから、
ひとりでいつものやつ、やるかぁ……。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2260</PointerOffset>
      <JapaneseText>せーのっ</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2332</PointerOffset>
      <JapaneseText>真実を得るためならば、私は戦う！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2484</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2556</PointerOffset>
      <JapaneseText>…………。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2796</PointerOffset>
      <JapaneseText>……むなしい。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3324</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>10</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>3684</PointerOffset>
      <JapaneseText>部長！
事件報告書の「経費」のところに		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3756</PointerOffset>
      <JapaneseText>張り込みのときのコーヒー代も
入れていいんですか？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1200</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4052</PointerOffset>
      <JapaneseText>プリムラ部長〜！
容疑者の尾行に失敗しましたぁ〜！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4124</PointerOffset>
      <JapaneseText>ごめんなさい〜！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4484</PointerOffset>
      <JapaneseText>――噂を聞きつけてきた新入部員たちで
我が探偵部は大騒ぎ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4556</PointerOffset>
      <JapaneseText>部長も楽じゃありません。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4780</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>17</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>5044</PointerOffset>
      <JapaneseText>やあ、忙しそうだね、子猫ちゃん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2100</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5308</PointerOffset>
      <JapaneseText>あ、ダーリン！
もうちょっとで仕事終わるから待っててね！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5756</PointerOffset>
      <JapaneseText>待ちきれないよ、子猫ちゃん！
ああ、君が隣にいない時間の孤独さよ！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2100</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5828</PointerOffset>
      <JapaneseText>心臓は鼓動をとめ、太陽さえも輝きを
失い色あせる……。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2100</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6092</PointerOffset>
      <JapaneseText>やれやれ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6596</PointerOffset>
      <JapaneseText>プリムラさん、事件です！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5900</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6916</PointerOffset>
      <JapaneseText>あー、ゴメン。
私このあとキーファとデートだから。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6988</PointerOffset>
      <JapaneseText>キール、かわりにやっといて。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7924</PointerOffset>
      <JapaneseText>なんで僕が……。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8140</PointerOffset>
      <JapaneseText>ふう。みんな、いつものいくぞー。
真実を得るためならば……！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8596</PointerOffset>
      <JapaneseText>僕は戦うっ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1300</SpeakerId>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9068</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>29</Id>
      <Status>Done</Status>
    </Entry>
