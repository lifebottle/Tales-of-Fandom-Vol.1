      <Id>60</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17068</PointerOffset>
      <JapaneseText>よーし！
みんな、いつものいくよっ！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>1100</SpeakerId>
      <Id>61</Id>
      <Status>To Do</Status>
