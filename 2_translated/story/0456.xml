      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1473026</PointerOffset>
      <JapaneseText>ペスカトーレ、ペスカトーレと。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1473057</PointerOffset>
      <JapaneseText>勝算はあるのか？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1473074</PointerOffset>
      <JapaneseText>どうだろ。まあ、なんとかなるでしょ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1473111</PointerOffset>
      <JapaneseText>何度も作ったことあるし。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1473136</PointerOffset>
      <JapaneseText>たぶん特定の食材の選び方が、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1473165</PointerOffset>
      <JapaneseText>勝敗を左右することになると思うの。</JapaneseText>
      <EnglishText> </EnglishText>
