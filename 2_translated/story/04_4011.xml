  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>620</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>1100</PointerOffset>
      <JapaneseText>あらリオン！　おかえりなさい。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2800</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1172</PointerOffset>
      <JapaneseText>お約束のアレ
ちゃんと作ってありますからね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2800</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1428</PointerOffset>
      <JapaneseText>アレ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1716</PointerOffset>
      <JapaneseText>えぇ、リオンの大好物！
特大プリンの生クリームたっぷり添えです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2800</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2068</PointerOffset>
      <JapaneseText>マ、マリアン！　僕はプリンなんか……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2332</PointerOffset>
      <JapaneseText>だいじょうぶ！　卵はリーネ製ですし
砂糖はジェノスで買ってきました。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2800</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2532</PointerOffset>
      <JapaneseText>リオンのこだわりを知ってますもの。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2796</PointerOffset>
      <JapaneseText>……ありがとう。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3060</PointerOffset>
      <JapaneseText>むっふっふっふ。リオ〜ン？
プリンはお嫌いなんじゃなかったの〜？	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3692</PointerOffset>
      <JapaneseText>うわ〜！　ティアラが〜！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
