  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>636</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>772</PointerOffset>
      <JapaneseText>サーチガルド！　サーチガルド！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1820</PointerOffset>
      <JapaneseText>いつまで探してるつもりだ？
もうレンズもガルドも根こそぎ拾ったろ？	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2300</PointerOffset>
      <JapaneseText>うっさいわねぇ！　もぅ落とし物したのよ！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2564</PointerOffset>
      <JapaneseText>まぁ！　何を落とされたのです？
私達も一緒に探しますわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2908</PointerOffset>
      <JapaneseText>え……い、いいわよ。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3228</PointerOffset>
      <JapaneseText>おまえが遠慮するなんて気持ち悪いぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3596</PointerOffset>
      <JapaneseText>なにアンタまでしゃがんでんのよ！
いいってば！　ホントに！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3916</PointerOffset>
      <JapaneseText>はーい！
コレ、そこの草むらで見つけましたぁ！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2700</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4324</PointerOffset>
      <JapaneseText>ずいぶん分厚いノートだな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4588</PointerOffset>
      <JapaneseText>にっきちょう……と書いてありますね。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4908</PointerOffset>
      <JapaneseText>うわああああああ！　見ないで！！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5572</PointerOffset>
      <JapaneseText>おまえ、日記なんてつけていたのか？
似合わんな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5836</PointerOffset>
      <JapaneseText>日記帳っていうより
おこづかい帳なんじゃないですかぁ？	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2700</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6100</PointerOffset>
      <JapaneseText>さすがルーティさん！
金銭管理の腕は確かですね。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6460</PointerOffset>
      <JapaneseText>……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6676</PointerOffset>
      <JapaneseText>……ふつう、もうちょっと興味示さない？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
