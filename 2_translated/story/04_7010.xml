  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>580</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>812</PointerOffset>
      <JapaneseText>髪がだいぶ伸びたなあ。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>884</PointerOffset>
      <JapaneseText>リーネにいる時はいつもリリスが
切ってくれてたからなぁ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1148</PointerOffset>
      <JapaneseText>髪くらい、あたしが切ってあげるわよ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1548</PointerOffset>
      <JapaneseText>あ、ちょ、ちょ、ちょ、ちょっと待って。
切り始める前に、２、３注意点が……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1812</PointerOffset>
      <JapaneseText>へぇ。いっちょまえに注文ってこと？
何よ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2076</PointerOffset>
      <JapaneseText>前髪は眉より短くしないでくれる？	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2148</PointerOffset>
      <JapaneseText>横はうまくシャギーを入れて風になびかせる
感じ。後ろは、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2220</PointerOffset>
      <JapaneseText>そうだな……これは……
切りながら指示していくよ。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2564</PointerOffset>
      <JapaneseText>……フィリアー！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2876</PointerOffset>
      <JapaneseText>なんでしょう？				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3300</PointerOffset>
      <JapaneseText>選手交代！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4012</PointerOffset>
      <JapaneseText>……って感じに頼むよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4276</PointerOffset>
      <JapaneseText>ん？　散髪してるのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4588</PointerOffset>
      <JapaneseText>まだ切らせてもらえません。
リオンさん……あとお願いします！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5236</PointerOffset>
      <JapaneseText>……とまあ、気をつけて欲しいところは
これくらいなんだけど、うまく切れそう？	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5868</PointerOffset>
      <JapaneseText>うるさい！！
おまえなど丸刈りで十分だ！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6492</PointerOffset>
      <JapaneseText>うわあっ！　なんで！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7572</PointerOffset>
      <JapaneseText>ったく、変なトコに細かいんだから！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9260</PointerOffset>
      <JapaneseText>私、リリスさんを尊敬しますわ……。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
