  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>76</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>940</PointerOffset>
      <JapaneseText>……寒い……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1140</PointerOffset>
      <JapaneseText>んじゃ、またやろっか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1444</PointerOffset>
      <JapaneseText>ダジャレでポーン！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1740</PointerOffset>
      <JapaneseText>げっ！
もう勘弁してくれよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1956</PointerOffset>
      <JapaneseText>イルカはいるか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2284</PointerOffset>
      <JapaneseText>はい！　次リッド！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2604</PointerOffset>
      <JapaneseText>え〜……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2852</PointerOffset>
      <JapaneseText>ブタがぶった。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3100</PointerOffset>
      <JapaneseText>ほい、次キール。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3340</PointerOffset>
      <JapaneseText>えと、えーと……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3588</PointerOffset>
      <JapaneseText>クマはミンツでとうみんつ（冬眠中）ー！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3908</PointerOffset>
      <JapaneseText>だからさむいって……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4292</PointerOffset>
      <JapaneseText>つぅか、ホント寒いぞ。なんだ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4508</PointerOffset>
      <JapaneseText>セルシウスが怒ってるんじゃない？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4708</PointerOffset>
      <JapaneseText>ちっ、
キールがつまんねぇダジャレ言うからだ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4876</PointerOffset>
      <JapaneseText>どうすんだよ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5300</PointerOffset>
      <JapaneseText>……ぷぷぷ。面白い。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5300</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5596</PointerOffset>
      <JapaneseText>おい……喜んでんのか！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5916</PointerOffset>
      <JapaneseText>大晶霊の感覚ってわかんないね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6164</PointerOffset>
      <JapaneseText>僕のダジャレは高度すぎて、セルシウス
クラスじゃないと理解できないんだよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6532</PointerOffset>
      <JapaneseText>あはははははははは！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5300</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
