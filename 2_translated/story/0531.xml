      <Notes> </Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1705770</PointerOffset>
      <JapaneseText>よかった……！　ディムロス、わかる？</JapaneseText>
