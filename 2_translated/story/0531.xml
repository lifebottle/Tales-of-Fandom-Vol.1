      <Notes> </Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1705879</PointerOffset>
      <JapaneseText>心地よい、鋼の重み。</JapaneseText>
