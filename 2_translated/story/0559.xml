
<SceneText>
  <FriendlyName>Conversation_0559</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x1ac587</PointerOffset>
      <JapaneseText>名前？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac58e</PointerOffset>
      <JapaneseText>これだけディムロスにそっくりなんだから、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac5b7</PointerOffset>
      <JapaneseText>こいつにも名前があっていいと思うんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac5de</PointerOffset>
      <JapaneseText>リリスが決めてくれよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac5f5</PointerOffset>
      <JapaneseText>そ、そうね……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac606</PointerOffset>
      <JapaneseText>だったら、Ｓ．Ｄ．なんてどうかな？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac629</PointerOffset>
      <JapaneseText>えすでぃー？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac636</PointerOffset>
      <JapaneseText>変すぎる、かな？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac647</PointerOffset>
      <JapaneseText>『なんだそれは！　安易すぎるぞ！』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac66a</PointerOffset>
      <JapaneseText>『しっ。お兄ちゃんに聞こえるわよ？』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac68f</PointerOffset>
      <JapaneseText>ふーん。Ｓ．Ｄ．か。よくわかんないけど、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac6b8</PointerOffset>
      <JapaneseText>リリスがそういうならそれでいいや。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac6dc</PointerOffset>
      <JapaneseText>よーし、Ｓ．Ｄ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac6ed</PointerOffset>
      <JapaneseText>ディムロスの代わりに、見せてやるよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac712</PointerOffset>
      <JapaneseText>おれがどれだけ、剣がうまくなったかをさ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac73b</PointerOffset>
      <JapaneseText>どうだい、この速さ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac750</PointerOffset>
      <JapaneseText>前とはぜんぜん違うんだぜ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac76b</PointerOffset>
      <JapaneseText>きっとディムロスだったら、驚くはずだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac792</PointerOffset>
      <JapaneseText>な、リリス。お前もそう思うだろう？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac7b5</PointerOffset>
      <JapaneseText>そ、そうかもね。あはは。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac7ce</PointerOffset>
      <JapaneseText>技の研究だって、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac7df</PointerOffset>
      <JapaneseText>毎日やってるんだぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x1ac7f4</PointerOffset>
      <JapaneseText>魔神剣の切り</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
