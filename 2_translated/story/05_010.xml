  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>76</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>1012</PointerOffset>
      <JapaneseText>おう！　アレは？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1180</PointerOffset>
      <JapaneseText>はい。
もう準備できております。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>900</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1428</PointerOffset>
      <JapaneseText>アレはアレすんだぞ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1628</PointerOffset>
      <JapaneseText>えぇ。ぬかりはありません。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>900</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1796</PointerOffset>
      <JapaneseText>おぅ。
じゃ、いよいよアレだな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1964</PointerOffset>
      <JapaneseText>はい！　ミアキスを胸に！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>900</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2260</PointerOffset>
      <JapaneseText>ぐわははははは！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2588</PointerOffset>
      <JapaneseText>すげーなぁ！　何言ってんのか
ぜんっぜんわからねぇよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2756</PointerOffset>
      <JapaneseText>たしかに、天然の暗号だ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>500</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2956</PointerOffset>
      <JapaneseText>ふふ、みなさんも慣れればわかりますよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>900</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3156</PointerOffset>
      <JapaneseText>いつからシルエシカに？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>500</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3324</PointerOffset>
      <JapaneseText>もう……４年になります。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>900</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3524</PointerOffset>
      <JapaneseText>初めてフォッグを見たときは驚いたろ？
話も通じねぇし！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3692</PointerOffset>
      <JapaneseText>いえ……私、ボスとは以前にも一度
お会いしたことがありますので。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>900</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3892</PointerOffset>
      <JapaneseText>え、シルエシカに入る前とか！？
どこで？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4108</PointerOffset>
      <JapaneseText>……それは……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>900</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4420</PointerOffset>
      <JapaneseText>リッド、行くぞ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>500</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5004</PointerOffset>
      <JapaneseText>なんだよ、レイス！
オレはアイラに質問して……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5172</PointerOffset>
      <JapaneseText>男と女にはいろいろあるのさ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>500</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5292</PointerOffset>
      <JapaneseText>君にはまだわからないかな？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5540</PointerOffset>
      <JapaneseText>……悪かったな、ガキでよ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
