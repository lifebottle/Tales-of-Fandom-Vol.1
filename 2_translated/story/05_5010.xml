    </Entry>
    <Entry>
      <PointerOffset>932</PointerOffset>
      <JapaneseText>この剣を捨てたのはリッドか？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1196</PointerOffset>
      <JapaneseText>あぁ、そうだけど？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1460</PointerOffset>
      <JapaneseText>まだ使える！　ほら、仕舞っておけ！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1724</PointerOffset>
      <JapaneseText>だってコレもう刃がぼろぼろで……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2068</PointerOffset>
      <JapaneseText>研、げ、ば、つ、か、え、る！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2412</PointerOffset>
      <JapaneseText>……はい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2660</PointerOffset>
      <JapaneseText>それからこの野菜サラダを
ほとんど手つかずで捨てたのは……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2924</PointerOffset>
      <JapaneseText>はい、ボクです！　食べますよ！　今すぐ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3476</PointerOffset>
      <JapaneseText>まったく……。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3548</PointerOffset>
      <JapaneseText>よく捨てるなんて行為が出来るもんだよ。&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3764</PointerOffset>
      <JapaneseText>ぼくの物持ちの良さを少しは見習え！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3836</PointerOffset>
      <JapaneseText>今も愛用している「レオノア百科全書」は
７歳の時に買ってもらったものだし、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3908</PointerOffset>
      <JapaneseText>クレーメルケイジのサックもあちこち
修繕しながらもう４年ほど使っているし…。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4228</PointerOffset>
      <JapaneseText>メルディがあげたドエニスの花も捨てずに
押し花にしてくれてるしな♪		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4548</PointerOffset>
      <JapaneseText>ぐっ！					</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4956</PointerOffset>
      <JapaneseText>ほーぅ。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5220</PointerOffset>
      <JapaneseText>わざわざ押し花にしたんですか？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
