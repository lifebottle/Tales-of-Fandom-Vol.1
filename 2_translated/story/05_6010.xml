  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>620</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>660</PointerOffset>
      <JapaneseText>おーい！
とっときの極意書を持ってきてやったぞぅ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1148</PointerOffset>
      <JapaneseText>なに？
……「真の主役になる方法」？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1492</PointerOffset>
      <JapaneseText>そのとおり！
私ふくめて君達みんなカッコイイ！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1708</PointerOffset>
      <JapaneseText>恐ろしく鈍いヤツ！　寝起きの悪いヤツ！
食い意地の張ったヤツ！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1780</PointerOffset>
      <JapaneseText>そんな困ったヤツらに主人公を
まかせておくのは悔しいじゃないか！？	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2044</PointerOffset>
      <JapaneseText>た、たしかにそうだな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2308</PointerOffset>
      <JapaneseText>たまにはオレ達が主役になったっていいか……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2572</PointerOffset>
      <JapaneseText>ふん、その方法とやらを聞こうじゃないか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2940</PointerOffset>
      <JapaneseText>ではいくぞ。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3012</PointerOffset>
      <JapaneseText>方法その１。
主人公は歌って踊れる芸人であるべし！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3420</PointerOffset>
      <JapaneseText>げ、芸人？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3684</PointerOffset>
      <JapaneseText>方法その２。
主人公は衣装に命をかけるべし！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4044</PointerOffset>
      <JapaneseText>なんか偏ってねぇか？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4412</PointerOffset>
      <JapaneseText>おい！　この本の著者は誰だ？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4676</PointerOffset>
      <JapaneseText>えーっと……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4748</PointerOffset>
      <JapaneseText>ジョニー＝シデンと書いてあるな。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5060</PointerOffset>
      <JapaneseText>やっぱり……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
