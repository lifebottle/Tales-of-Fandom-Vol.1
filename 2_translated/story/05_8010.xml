  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>572</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>804</PointerOffset>
      <JapaneseText>すずさんが１１歳。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2700</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>876</PointerOffset>
      <JapaneseText>チャットさんが１２歳……ってことは〜	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2700</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>948</PointerOffset>
      <JapaneseText>わたしが一番お姉さんですぅ。ふふふん♪	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2700</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1212</PointerOffset>
      <JapaneseText>お言葉を返すようですが……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1284</PointerOffset>
      <JapaneseText>大人かどうかは、精神的な年齢によって
測られるべきだと、ボクは思いますよ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1580</PointerOffset>
      <JapaneseText>……チャ、チャットさんって
ひょっとして、すごぉく大人ですか？	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2700</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1924</PointerOffset>
      <JapaneseText>まぁ、それほどでもありませんが。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2140</PointerOffset>
      <JapaneseText>（じゃーん、こんにちは！！）</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>800</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2652</PointerOffset>
      <JapaneseText>うわ、出た！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2820</PointerOffset>
      <JapaneseText>わあああああん！　来るな〜！！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4004</PointerOffset>
      <JapaneseText>やっぱりまだまだ子供ですねぇ。ふふふん♪</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2700</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4220</PointerOffset>
      <JapaneseText>すずさんも何か怖いモノあるんですか？	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2700</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4484</PointerOffset>
      <JapaneseText>いえ、ありません。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4100</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4556</PointerOffset>
      <JapaneseText>強いて言えば……男女の愛憎でしょうか。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4100</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4820</PointerOffset>
      <JapaneseText>ア、ア、ア、アイゾー！？　って？？？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2700</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5084</PointerOffset>
      <JapaneseText>こんなことや……あんなことです。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4100</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5580</PointerOffset>
      <JapaneseText>……す、すずさん、大人ですぅ！
なんでそんなコト知ってるんですかぁ？	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2700</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5900</PointerOffset>
      <JapaneseText>忍者ですから。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4100</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6212</PointerOffset>
      <JapaneseText>（そりゃ、すごい！）</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>800</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
