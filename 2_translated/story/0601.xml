    </Entry>
    <Entry>
      <PointerOffset>1857750</PointerOffset>
      <JapaneseText>……なにやってるんだね、君は？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1857783</PointerOffset>
      <JapaneseText>はあ、はあ、はあ……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1857806</PointerOffset>
      <JapaneseText>か、か弱い乙女にはちょっと厳しいわね。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1857846</PointerOffset>
      <JapaneseText>おい、君。何の用だ？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1857870</PointerOffset>
      <JapaneseText>キールと話をしたいんですけど……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1857906</PointerOffset>
      <JapaneseText>ダメだダメだ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1857921</PointerOffset>
      <JapaneseText>実験室から一歩も出すなといわれている。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1857961</PointerOffset>
      <JapaneseText>じゃあ、私が中に入るということで。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1857997</PointerOffset>
      <JapaneseText>ダメダメ！　とにかく面会謝絶だ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
