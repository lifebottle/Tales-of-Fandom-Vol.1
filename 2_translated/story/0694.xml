      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2137159</PointerOffset>
      <JapaneseText>な、殴らないでっ！</JapaneseText>
