    <Entry>
      <PointerOffset>700</PointerOffset>
      <JapaneseText>男性陣がパーティーを
ひらいているそうです。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1020</PointerOffset>
      <JapaneseText>へぇ！　面白そう！！
みんなで行ってみよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1284</PointerOffset>
      <JapaneseText>わたしは遠慮します。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4100</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1580</PointerOffset>
      <JapaneseText>なんでぇ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1844</PointerOffset>
      <JapaneseText>……忍者のカンです。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4100</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2108</PointerOffset>
      <JapaneseText>？　変なの。
じゃ、フィリアさん行こう！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
