  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>580</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>988</PointerOffset>
      <JapaneseText>おぅ！　なぜおまえはアレなんだ！？	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1308</PointerOffset>
      <JapaneseText>はあ？　さっぱりわからんぞ。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1660</PointerOffset>
      <JapaneseText>あ、あぁ、えーっと気にしないでください。
フォッグには通訳がいないと……。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1948</PointerOffset>
      <JapaneseText>だ・か・ら！　惚れた女と一緒にいながら
結婚しねぇっていうのはアレだぞ、アレ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2164</PointerOffset>
      <JapaneseText>男のワガママよ。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2684</PointerOffset>
      <JapaneseText>それは、私とミラルドの問題だ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2756</PointerOffset>
      <JapaneseText>おまえには関係なかろう。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3020</PointerOffset>
      <JapaneseText>おーぅ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3284</PointerOffset>
      <JapaneseText>フォッグさん、人はさまざまな形態で
愛をまっとうしようとなさいます。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3356</PointerOffset>
      <JapaneseText>女性のほうでも結婚とは別の暮らし方を
望む方がいるかもしれません。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3620</PointerOffset>
      <JapaneseText>その通り！
結婚だけがすべてだと思うなよ。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3884</PointerOffset>
      <JapaneseText>お……ぅ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4284</PointerOffset>
      <JapaneseText>わっ、めずらしい！
フォッグが黙っちゃったよ。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4548</PointerOffset>
      <JapaneseText>たしかにそうかもな。
結婚して終わりってわけにはな……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4844</PointerOffset>
      <JapaneseText>お、おい！　これはこれで気味悪いぞ。
さっきまでの威勢はどうした？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5132</PointerOffset>
      <JapaneseText>フォッグの奥さん、行方不明中なんだ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5452</PointerOffset>
      <JapaneseText>本当ですか！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5572</PointerOffset>
      <JapaneseText>そうとは知らずに私、
差し出がましい意見を……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5836</PointerOffset>
      <JapaneseText>おまえさんのせいじゃないさ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6236</PointerOffset>
      <JapaneseText>……飲むか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6500</PointerOffset>
      <JapaneseText>おぅ？　……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6764</PointerOffset>
      <JapaneseText>おぅ！　飲み明かそうぜ。ぐわはははは！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7292</PointerOffset>
      <JapaneseText>あの……私達は……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7556</PointerOffset>
      <JapaneseText>男同士で盛り上がってるみたいだから
次のテーブルいこっか。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7820</PointerOffset>
      <JapaneseText>はい……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
