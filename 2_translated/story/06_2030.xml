      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>1220</PointerOffset>
      <JapaneseText>チャット！！
お鼻が良いなー！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1292</PointerOffset>
      <JapaneseText>ちょうど出来たトコよー。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1556</PointerOffset>
      <JapaneseText>何やってるんですか？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1876</PointerOffset>
      <JapaneseText>パンパカパーン！
アーチェとメルディの</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3400</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2140</PointerOffset>
      <JapaneseText>真夜中のお料理大会だな！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2404</PointerOffset>
      <JapaneseText>あんた、ツイてるじゃん。
あたし達の手料理を食べられるなんて……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3400</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2724</PointerOffset>
      <JapaneseText>チャット、喜んでるか？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3036</PointerOffset>
      <JapaneseText>いやボク……あまりお腹空いてない……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3300</PointerOffset>
      <JapaneseText>なによー。アーチェ様の作ったものが
食べられないっての？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3400</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3692</PointerOffset>
      <JapaneseText>いえ、あの……メルディさん！？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3956</PointerOffset>
      <JapaneseText>はいな♪　じゃまずはー</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4076</PointerOffset>
      <JapaneseText>メルディ特製やみなべからどーぞー。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3400</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4700</PointerOffset>
      <JapaneseText>……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4772</PointerOffset>
      <JapaneseText>……うぎゃ、ぐぇ、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5044</PointerOffset>
      <JapaneseText>おぇー。
この味何ですか？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5356</PointerOffset>
      <JapaneseText>ケーキ入れてみたよ♪　ダメか？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5668</PointerOffset>
      <JapaneseText>ダメー！！！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6028</PointerOffset>
      <JapaneseText>じゃ次、あたしのも食べなさーい！
チーズバーガーだよ。好きでしょ？	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3400</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6404</PointerOffset>
      <JapaneseText>こ、このどろどろした物体は？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6748</PointerOffset>
      <JapaneseText>こんぶ。
栄養あるらしいから挟んでみた！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3400</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6820</PointerOffset>
      <JapaneseText>さ、食べて食べて。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3400</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7420</PointerOffset>
      <JapaneseText>……うげ……アーチェさん的には
コレが美味しかったんですか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7684</PointerOffset>
      <JapaneseText>ううん、まだ食べてないよ。
毒味は怖いじゃん。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3400</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8076</PointerOffset>
      <JapaneseText>ボクだって怖いですよ！
失礼します！！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
