  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>676</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>1460</PointerOffset>
      <JapaneseText>あっちゃあ……この組み合わせですか！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3400</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1532</PointerOffset>
      <JapaneseText>なんかめんどくさそー。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3400</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1796</PointerOffset>
      <JapaneseText>だから違う！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1868</PointerOffset>
      <JapaneseText>ぼくの理論からいけば
ここは属性を変えるべきなんだ！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2212</PointerOffset>
      <JapaneseText>おいおい、無茶言うなよ？&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2284</PointerOffset>
      <JapaneseText>ここで攻撃しなくてどうする！？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2628</PointerOffset>
      <JapaneseText>そういうのを浅知恵の勇み足って言うんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2892</PointerOffset>
      <JapaneseText>ほぅ？　では、おまえさんみたいなのは
さしずめサル知恵の尻込みか？　</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3108</PointerOffset>
      <JapaneseText>ははははは！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3428</PointerOffset>
      <JapaneseText>う、うるさい、うるさーい！&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3644</PointerOffset>
      <JapaneseText>属性変えのカードを出すからな！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3908</PointerOffset>
      <JapaneseText>おいおい、自棄になるなよ。
それでも学者か？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4172</PointerOffset>
      <JapaneseText>なんだってぇ〜！？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4764</PointerOffset>
      <JapaneseText>あ〜、もみ合いになっております！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3400</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4932</PointerOffset>
      <JapaneseText>が！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3400</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5100</PointerOffset>
      <JapaneseText>やっぱりチカラじゃクラースの楽勝だねぇ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5596</PointerOffset>
      <JapaneseText>腕力にモノを言わせるなんて！　そっちこそ
学問に身をおく者の風上にもおけないぞ！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5908</PointerOffset>
      <JapaneseText>目には目を、歯には歯を、
暴力には暴力を、だろう？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6268</PointerOffset>
      <JapaneseText>くっそぅ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8684</PointerOffset>
      <JapaneseText>おおっと乱闘です。乱闘〜♪		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3400</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8900</PointerOffset>
      <JapaneseText>っていうか、タイムリミット。
クラース・キール組は１回やすみぃ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3400</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9260</PointerOffset>
      <JapaneseText>へ？					</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9524</PointerOffset>
      <JapaneseText>そんなぁ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
