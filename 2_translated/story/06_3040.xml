    <Entry>
      <PointerOffset>580</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>812</PointerOffset>
      <JapaneseText>どれ出そっか？				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1076</PointerOffset>
      <JapaneseText>ふん、勝手にしろ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1340</PointerOffset>
      <JapaneseText>あらら、ご機嫌ななめ？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1604</PointerOffset>
      <JapaneseText>人を子供扱いするな！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1868</PointerOffset>
      <JapaneseText>ごめん、ごめん。
	で、どうしよっか？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2132</PointerOffset>
      <JapaneseText>だから！　おまえが決めろ。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2396</PointerOffset>
      <JapaneseText>やだ！　せっかくふたりで組んでるんだし
相談しようよ。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2660</PointerOffset>
      <JapaneseText>ふん、単なる遊びだろ。くだらんな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2924</PointerOffset>
      <JapaneseText>遊びでも勝てたら嬉しいじゃない？
ね？　がんばろうよ。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3268</PointerOffset>
      <JapaneseText>……ふ、ふん……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3340</PointerOffset>
      <JapaneseText>プリズムのカードでも出せばいいだろ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3604</PointerOffset>
      <JapaneseText>わかった。じゃ、コレ出しまーす。&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3724</PointerOffset>
      <JapaneseText>イケる、イケる！　ね？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3940</PointerOffset>
      <JapaneseText>あ、あぁ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4356</PointerOffset>
      <JapaneseText>あらら？　意外とうまくいってんじゃん。
……ちぇっ、つまんないのぉ。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3400</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4572</PointerOffset>
      <JapaneseText>大体リオンって、
マリアンとかファラとか</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3400</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4644</PointerOffset>
      <JapaneseText>母性本能まるだしのタイプに弱すぎだね！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3400</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
