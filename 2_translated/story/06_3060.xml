      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>844</PointerOffset>
      <JapaneseText>え？　ビリはどこだって？
んなの、決まってんじゃん！</JapaneseText>
