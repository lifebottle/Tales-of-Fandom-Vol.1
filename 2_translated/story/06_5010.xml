    <Entry>
      <PointerOffset>764</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>1412</PointerOffset>
      <JapaneseText>はぁ〜、食った、食った！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1676</PointerOffset>
      <JapaneseText>美味しかったですね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1940</PointerOffset>
      <JapaneseText>それなりに値段の張るものばかりだからな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>500</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2204</PointerOffset>
      <JapaneseText>ちょっと失礼。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2852</PointerOffset>
      <JapaneseText>会計お願いしますね。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5800</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3148</PointerOffset>
      <JapaneseText>ふむ、どれどれ……？&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>500</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3604</PointerOffset>
      <JapaneseText>う。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>500</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4004</PointerOffset>
      <JapaneseText>どしたんだよ？				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4268</PointerOffset>
      <JapaneseText>……うわ、高ぇ！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4588</PointerOffset>
      <JapaneseText>４人で割るといくらですか？
えぇと、えぇと……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4932</PointerOffset>
      <JapaneseText>ひとりにつき４１２３．３３３３……
ガルドだ。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>500</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5196</PointerOffset>
      <JapaneseText>暗算早いですね！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5460</PointerOffset>
      <JapaneseText>根っからの商人だからな。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5724</PointerOffset>
      <JapaneseText>んじゃ、みんな４１２０ガルドずつな。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5988</PointerOffset>
      <JapaneseText>違うぞ、リッド。
４１２３．３３３３……ガルドだ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>500</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6252</PointerOffset>
      <JapaneseText>いいんだよ、端数は切り捨てで。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6516</PointerOffset>
      <JapaneseText>リッドさん、男らしいですね！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6780</PointerOffset>
      <JapaneseText>違うぞ、チャット。
私は何もケチで言ってるんじゃない。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>500</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6900</PointerOffset>
      <JapaneseText>１ガルドに笑う者は１ガルドに泣くという
古い商人のことわざがあってだな……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>500</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7164</PointerOffset>
      <JapaneseText>……へいへい、わかったよ。
んじゃ、４１２３ガルドずつな。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7804</PointerOffset>
      <JapaneseText>どした？　ふたりとも……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8092</PointerOffset>
      <JapaneseText>すみません。今ちょうど手持ちが……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8356</PointerOffset>
      <JapaneseText>まいった、まいった。
私も全然足らんぞ。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>500</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8700</PointerOffset>
      <JapaneseText>おい、マジかよ！？
仕方ねぇなぁ……先に外出ててくれ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9020</PointerOffset>
      <JapaneseText>申し訳ないです。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>25</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9284</PointerOffset>
      <JapaneseText>恩にきるよ。				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>500</SpeakerId>
      <Id>26</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>9956</PointerOffset>
      <JapaneseText>あ、ルーティ！　ちょうど良かった。&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>27</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10172</PointerOffset>
      <JapaneseText>みんなの支払いが……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>28</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10580</PointerOffset>
      <JapaneseText>あー！　ちょっとどいてどいてぇ！
アーチェが酔っぱらっちゃって大変なのぉ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>29</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>10844</PointerOffset>
      <JapaneseText>う〜ん、う〜ん……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3400</SpeakerId>
      <Id>30</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11108</PointerOffset>
      <JapaneseText>いやいや、それはそれで、あのお金……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>31</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11468</PointerOffset>
      <JapaneseText>アンタ、酔ってる友達を放っておける？
あたしには出来ない！　出来ないわ！！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>32</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11540</PointerOffset>
      <JapaneseText>お金より何より、まずは人命救助！
そう思わない！？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>33</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>11836</PointerOffset>
      <JapaneseText>え？　あ、あぁ。まぁ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>34</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12124</PointerOffset>
      <JapaneseText>だったらどいてちょーだい！！&lt;nl&gt;</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>35</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12580</PointerOffset>
      <JapaneseText>はーはいはい、道あけてねぇ。			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>36</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>12964</PointerOffset>
      <JapaneseText>え？　ちょっと？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>37</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13356</PointerOffset>
      <JapaneseText>あっ、ごめんごめん、忘れてた！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>38</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13620</PointerOffset>
      <JapaneseText>ルーティ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>39</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>13884</PointerOffset>
      <JapaneseText>はいコレ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>40</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14260</PointerOffset>
      <JapaneseText>アーチェの分の伝票。ついでに払っといて。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>41</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>14868</PointerOffset>
      <JapaneseText>なっ！　おい！　聞いてねぇぞー！！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>42</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>15228</PointerOffset>
      <JapaneseText>……ダマされたか、オレ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>43</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>16108</PointerOffset>
      <JapaneseText>おぅ、肩落ちてんぞ。どした？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>44</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>16372</PointerOffset>
      <JapaneseText>ど〜したもこ〜したも……、
オレ、金が……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>45</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>16636</PointerOffset>
      <JapaneseText>おぅ？　金がないのか？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>46</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>16852</PointerOffset>
      <JapaneseText>ぐわはははは！　任せとけぃ！
ちょうど俺さま達も会計するトコよ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>47</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>16924</PointerOffset>
      <JapaneseText>みんないっぺんに面倒みてやるぜ！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>48</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17188</PointerOffset>
      <JapaneseText>ホントか？　さすがリーダー！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>49</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17452</PointerOffset>
      <JapaneseText>おぅ！					</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>50</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17668</PointerOffset>
      <JapaneseText>…………おぅ？				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>51</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>17964</PointerOffset>
      <JapaneseText>お金ないのか？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>52</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18284</PointerOffset>
      <JapaneseText>おぅ？　そ、そんなハズは……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>700</SpeakerId>
      <Id>53</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18548</PointerOffset>
      <JapaneseText>あ！　フォッグさん、
さきほど、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>54</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18668</PointerOffset>
      <JapaneseText>私といっしょに通りすがりの老人に施しを……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>55</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>18932</PointerOffset>
      <JapaneseText>施しって……？				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>56</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>19196</PointerOffset>
      <JapaneseText>フォッグもフィリアも有り金ぜーんぶ
あげちゃったな♪			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>57</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>19660</PointerOffset>
      <JapaneseText>そんなあ！				</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>58</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>19732</PointerOffset>
      <JapaneseText>じゃあ、これ……この全員分、
オレとメルディで払うのか！？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>59</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>19996</PointerOffset>
      <JapaneseText>ウ ワエム ムイティ スプンエク！
（＊私、喋れません）</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>60</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>20116</PointerOffset>
      <JapaneseText>リッドが言葉ぜーんぜん！　わからんな。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>61</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>20636</PointerOffset>
      <JapaneseText>あ、ずりぃ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>62</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
