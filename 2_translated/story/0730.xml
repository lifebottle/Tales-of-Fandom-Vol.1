      <JapaneseText>あ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2207244</PointerOffset>
      <JapaneseText>あなたもキーファ様のゲームの参加者？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2207282</PointerOffset>
      <JapaneseText>シルフの君はここには</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2207303</PointerOffset>
      <JapaneseText>いらっしゃらないわよ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2207329</PointerOffset>
      <JapaneseText>ホラ、黒板にこんな紙が……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2207360</PointerOffset>
      <JapaneseText>『我はアンを愛し、ルナリアを愛する。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2207398</PointerOffset>
      <JapaneseText>さらにミルドレッドに恋し、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2207425</PointerOffset>
      <JapaneseText>グロッサに恋する。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2207447</PointerOffset>
      <JapaneseText>最後にウィリアムとグロッサを愛する……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2207488</PointerOffset>
      <JapaneseText>わが元に来れ、子猫たちよ！』</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
