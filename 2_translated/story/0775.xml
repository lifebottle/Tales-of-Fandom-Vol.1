    </Entry>
    <Entry>
      <PointerOffset>2320379</PointerOffset>
      <JapaneseText>その問題用紙があれば</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2320400</PointerOffset>
      <JapaneseText>当然そうなるだろうな。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2320426</PointerOffset>
      <JapaneseText>少し預かっても構わないかな？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2320457</PointerOffset>
      <JapaneseText>ハイ！　お願いします！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2320483</PointerOffset>
      <JapaneseText>――諸君、緊急事態だ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2320506</PointerOffset>
      <JapaneseText>休憩を終わりにして審議に戻るぞ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2320540</PointerOffset>
      <JapaneseText>……ふう。間一髪！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
