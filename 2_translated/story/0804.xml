      <JapaneseText>ほ、本気なのかい、プリムラ？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2396015</PointerOffset>
      <JapaneseText>あなたが弱気になってどうするの！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2396049</PointerOffset>
      <JapaneseText>乙女の命を預けるんですから、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2396078</PointerOffset>
      <JapaneseText>設計者がちゃんと責任持ちなさいよ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2396114</PointerOffset>
      <JapaneseText>とはいっても、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2396129</PointerOffset>
      <JapaneseText>結局一回もテストしてないし。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2396160</PointerOffset>
      <JapaneseText>ま、最後は運試しとなればですね、</JapaneseText>
      <EnglishText> </EnglishText>
