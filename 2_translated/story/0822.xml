    </Entry>
    <Entry>
      <PointerOffset>2403877</PointerOffset>
      <JapaneseText>昔から言うじゃないか。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2403900</PointerOffset>
      <JapaneseText>色男、金と力はナントヤラ、ってさ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2403936</PointerOffset>
      <JapaneseText>くすん……もうだめだわ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2403963</PointerOffset>
      <JapaneseText>せっかく頑張ってきたのに、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2403992</PointerOffset>
      <JapaneseText>こんなところで誰にも知られず</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2404021</PointerOffset>
      <JapaneseText>殺されちゃうなんて……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2404048</PointerOffset>
      <JapaneseText>しくしく……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2404067</PointerOffset>
      <JapaneseText>ひっひっひ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2404084</PointerOffset>
      <JapaneseText>女のクセに探偵なんか気取ってるから</JapaneseText>
      <EnglishText> </EnglishText>
