      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2520694</PointerOffset>
      <JapaneseText>終わった、のかな？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2520716</PointerOffset>
      <JapaneseText>のようだな。</JapaneseText>
