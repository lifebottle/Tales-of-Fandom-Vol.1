    <Entry>
      <PointerOffset>628</PointerOffset>
      <JapaneseText>こっちに来てはだめ！　危ないわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4200</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>892</PointerOffset>
      <JapaneseText>生徒がいたずらで落とし穴作っちゃってね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4200</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1156</PointerOffset>
      <JapaneseText>急いでるんです！　通らせてください。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1468</PointerOffset>
      <JapaneseText>聞き分けのないこと言わないで。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4200</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1732</PointerOffset>
      <JapaneseText>急がなくちゃいけないんです！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2044</PointerOffset>
      <JapaneseText>ダーメ！　危ないって言ってるでしょ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4200</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
