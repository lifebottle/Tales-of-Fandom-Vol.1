    </Entry>
    <Entry>
      <PointerOffset>732</PointerOffset>
      <JapaneseText>あ、チェスターさん。あの……、
クレスさんを村祭りに誘われました？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>996</PointerOffset>
      <JapaneseText>いや？今から誘いに行こうかと……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1260</PointerOffset>
      <JapaneseText>あ！　そ、そうですか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1524</PointerOffset>
      <JapaneseText>それでは私はここで！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3300</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1884</PointerOffset>
      <JapaneseText>おい、ちょっとミント？
どこ行くんだよ！？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2260</PointerOffset>
      <JapaneseText>あ、逃げた。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4100</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2524</PointerOffset>
      <JapaneseText>逃がすか！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
