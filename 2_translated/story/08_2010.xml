    </Entry>
    <Entry>
      <PointerOffset/>
      <JapaneseText>Thomas Aileron</JapaneseText>
      <EnglishText>Thomas Aileron</EnglishText>
      <Notes>Reference only</Notes>
      <Id>5500</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>340</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>604</PointerOffset>
      <JapaneseText>さーてと……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>948</PointerOffset>
      <JapaneseText>みつけたあっ！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1572</PointerOffset>
      <JapaneseText>……って、なにこれ？
単なるビンのフタじゃない！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1860</PointerOffset>
      <JapaneseText>ああもう、まぎらわしい！
こんなものは……！	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2124</PointerOffset>
      <JapaneseText>お待ちなさい、お嬢さん。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5500</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2484</PointerOffset>
      <JapaneseText>ふえ？			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2748</PointerOffset>
      <JapaneseText>むやみに物を捨ててはいけません。
もったいないですぞ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5500</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3012</PointerOffset>
      <JapaneseText>だって、ただのゴミじゃない。
持ってたって１ガルドにもなりゃしないわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3276</PointerOffset>
      <JapaneseText>ふむ……。ならばそのフタと、
わたしのアップルグミを交換しませんかな？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5500</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3572</PointerOffset>
      <JapaneseText>いいけど……本気？
おじいさんが損しちゃうわよ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3860</PointerOffset>
      <JapaneseText>ほっほっほ。
これも何かの縁ですから。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5500</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4284</PointerOffset>
      <JapaneseText>たしかに取り替えましたぞ。
では、わたしはこれで。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5500</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4676</PointerOffset>
      <JapaneseText>……１５ガルドも得しちゃった！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4940</PointerOffset>
      <JapaneseText>そういえばこんな話、
前に聞いたことがあるわ。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5204</PointerOffset>
      <JapaneseText>たしか……次々に人と物を交換していって
最後は大金持ちになれんのよね……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5500</PointerOffset>
      <JapaneseText>ふっ！			</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
