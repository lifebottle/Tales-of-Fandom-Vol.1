      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1348</PointerOffset>
      <JapaneseText>……だんな様秘蔵の
デリスエンブレムをかけて戦います。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2800</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1612</PointerOffset>
      <JapaneseText>貴重品じゃない！　</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1988</PointerOffset>
      <JapaneseText>よーし、いくわよ！</JapaneseText>
