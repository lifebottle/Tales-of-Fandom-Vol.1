<SceneText>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <PointerOffset/>
      <JapaneseText>トーマス・エルロン</JapaneseText>
      <EnglishText>Thomas Aileron</EnglishText>
      <Notes>Reference only</Notes>
      <Id>5500</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset/>
      <JapaneseText>ルーティ・カトレット</JapaneseText>
      <EnglishText>Rutee Katrea</EnglishText>
      <Notes>Reference only</Notes>
      <Id>2300</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>316</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>436</PointerOffset>
      <JapaneseText>おーほっほっほ！
渡る世間はカモばかり、とはこのコトね〜♪</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1276</PointerOffset>
      <JapaneseText>おぉ、あなたはいつぞやの……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5500</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1540</PointerOffset>
      <JapaneseText>あら、あのときの。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1804</PointerOffset>
      <JapaneseText>その節はアップルグミをどーも♪	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2068</PointerOffset>
      <JapaneseText>いやいや、とんでもない。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5500</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2332</PointerOffset>
      <JapaneseText>あなたには感謝しておりますぞ。
あのような貴重な品をわけていただいて。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5500</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3028</PointerOffset>
      <JapaneseText>へ……
あの、ビンのフタ？		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3292</PointerOffset>
      <JapaneseText>ふむ。かつてセインガルド王家御用達の
名酒と言われた『シャトー・ルエイン』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5500</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3556</PointerOffset>
      <JapaneseText>その象徴とも言える黄金の王冠ですからな。
その価値５００万ガルドはくだりますまい。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5500</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3948</PointerOffset>
      <JapaneseText>う……そ……。
だってそんなことなんにも……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4212</PointerOffset>
      <JapaneseText>ほっほっほ。
渡る世間はカモばかりですな。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5500</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4476</PointerOffset>
      <JapaneseText>それでは、ごきげんよう。		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>5500</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4820</PointerOffset>
      <JapaneseText>……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5220</PointerOffset>
      <JapaneseText>く、く、悔しい〜〜〜！		</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5484</PointerOffset>
      <JapaneseText>何か交換するもの……するものは……と。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6068</PointerOffset>
      <JapaneseText>ちょ、ちょっと、おじいさん待ってーー！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
