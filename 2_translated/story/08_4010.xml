  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>308</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>652</PointerOffset>
      <JapaneseText>チェスター、山登りか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>988</PointerOffset>
      <JapaneseText>……あ、あぁ……ちょっとな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1276</PointerOffset>
      <JapaneseText>いいなぁ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1540</PointerOffset>
      <JapaneseText>よし、僕も付き合うよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1852</PointerOffset>
      <JapaneseText>あ！　クレス！
ちょっと待ってくれ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2196</PointerOffset>
      <JapaneseText>どうした？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2484</PointerOffset>
      <JapaneseText>……悪いけどオレ、
誰にも見られたくないんだよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2748</PointerOffset>
      <JapaneseText>女共はもちろん、他ならぬおまえにもな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3012</PointerOffset>
      <JapaneseText>山で何かやるのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3276</PointerOffset>
      <JapaneseText>ふっ、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3540</PointerOffset>
      <JapaneseText>水面下でもがく足は見せたくない</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3804</PointerOffset>
      <JapaneseText>……そういう気持ち、男ならわかるだろ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4068</PointerOffset>
      <JapaneseText>弓の訓練か！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4332</PointerOffset>
      <JapaneseText>そうかぁ……わかった！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4596</PointerOffset>
      <JapaneseText>ひとりで思うぞんぶん特訓してこいよ。
山には誰も入らせないようにしとくからさ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4860</PointerOffset>
      <JapaneseText>ありがたい！
じゃあな！　幸運を祈っといてくれ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3600</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5220</PointerOffset>
      <JapaneseText>がんばれよー。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
