      <SpeakerId>3600</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2964</PointerOffset>
      <JapaneseText>ここから湯気にまぎれてこっそりと……。</JapaneseText>
