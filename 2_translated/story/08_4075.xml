      <SpeakerId>3600</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2436</PointerOffset>
      <JapaneseText>本当はなにしてたんだよ？　いったい！？</JapaneseText>
      <EnglishText/>
