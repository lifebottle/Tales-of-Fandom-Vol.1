      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1908</PointerOffset>
      <JapaneseText>弓の稽古じゃなかったのか？	</JapaneseText>
      <EnglishText/>
