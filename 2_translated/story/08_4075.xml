      <SpeakerId>3200</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2172</PointerOffset>
      <JapaneseText>だますつもりはなかったんだけど
クレスが勝手に勘違いするからよぅ……。</JapaneseText>
      <EnglishText/>
