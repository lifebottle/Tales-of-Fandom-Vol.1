  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>524</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>788</PointerOffset>
      <JapaneseText>ごごご……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1004</PointerOffset>
      <JapaneseText>はぁああ……、
だめか。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1268</PointerOffset>
      <JapaneseText>諦めましょう、ルーティさん。
無理なんです、スタンさんを起こすなんて。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1532</PointerOffset>
      <JapaneseText>きっと、神の御力をもってしても
無理なんですわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1796</PointerOffset>
      <JapaneseText>そ、そうね。
やれるだけのことはやったわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2060</PointerOffset>
      <JapaneseText>でも、相手が悪かった。
諦めるしか……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2420</PointerOffset>
      <JapaneseText>お兄ちゃん、起きて。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2684</PointerOffset>
      <JapaneseText>ごごごご……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2900</PointerOffset>
      <JapaneseText>無理、無理。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3164</PointerOffset>
      <JapaneseText>何言ったって起きやしないわよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3380</PointerOffset>
      <JapaneseText>あたし達がどんだけ苦労したことか……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3596</PointerOffset>
      <JapaneseText>……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3812</PointerOffset>
      <JapaneseText>お兄ぃちゃん、朝ご飯できたわよー！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2600</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4076</PointerOffset>
      <JapaneseText>んほっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4508</PointerOffset>
      <JapaneseText>め、めし？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2200</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5276</PointerOffset>
      <JapaneseText>あたしの色気は食い気に負けるわけね。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5540</PointerOffset>
      <JapaneseText>くっくっくっく……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5852</PointerOffset>
      <JapaneseText>ル、ルーティさん？　ルーティさん！
しっかりしてください！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2500</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6132</PointerOffset>
      <JapaneseText>スタンのアホーーーー！！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2300</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
