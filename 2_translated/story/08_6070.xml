    </Entry>
    <Entry>
      <PointerOffset/>
      <JapaneseText>Marian Fustel</JapaneseText>
      <EnglishText>Marian Fustel</EnglishText>
      <Notes>Reference only</Notes>
      <Id>2800</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>316</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>628</PointerOffset>
      <JapaneseText>ただいま！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>924</PointerOffset>
      <JapaneseText>おかえりなさい、エミリオ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2800</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1188</PointerOffset>
      <JapaneseText>これ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1564</PointerOffset>
      <JapaneseText>この包み紙は……、
いちご味のアイスクリームね！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2800</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1828</PointerOffset>
      <JapaneseText>たまたま、売ってたからな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2092</PointerOffset>
      <JapaneseText>ありがとう！
私、いちご味が大好きなのよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2800</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2356</PointerOffset>
      <JapaneseText>たまたま、選んだんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2620</PointerOffset>
      <JapaneseText>うふふ、そうね。幸運だったわ。
さっそくいただこうかしら？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2800</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2884</PointerOffset>
      <JapaneseText>あぁ、そうしてくれ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3148</PointerOffset>
      <JapaneseText>楽しみだわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2800</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3444</PointerOffset>
      <JapaneseText>……あ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2800</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3820</PointerOffset>
      <JapaneseText>ドライアイスは多めに入れろと頼んだのに！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4084</PointerOffset>
      <JapaneseText>ちくしょう！　あのアイス屋め！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4444</PointerOffset>
      <JapaneseText>今日は暑かったからしかたないわ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2800</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4708</PointerOffset>
      <JapaneseText>それに私、溶けかかったアイスも好きよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2800</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4972</PointerOffset>
      <JapaneseText>マリアン、手が汚れるぞ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5268</PointerOffset>
      <JapaneseText>お行儀の悪さには目をつぶってちょうだい。
いただきます……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2800</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5532</PointerOffset>
      <JapaneseText>ん、美味しい！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2800</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5796</PointerOffset>
      <JapaneseText>そうか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>6092</PointerOffset>
      <JapaneseText>……よかった。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>2400</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
