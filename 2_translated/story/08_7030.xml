      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1940</PointerOffset>
      <JapaneseText>どうしても行きたいのか？
だったらおれを倒していけ〜！</JapaneseText>
