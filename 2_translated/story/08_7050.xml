    <Entry>
      <PointerOffset>620</PointerOffset>
      <JapaneseText>クラースさん、ドラゴンは？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>884</PointerOffset>
      <JapaneseText>一足遅かったな。わたしが片づけたよ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1148</PointerOffset>
      <JapaneseText>すごい！　どうやって倒したんですか？
ぜひ教えてください！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1444</PointerOffset>
      <JapaneseText>後でな。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1708</PointerOffset>
      <JapaneseText>今はちょっと……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1972</PointerOffset>
      <JapaneseText>あとといわず、今教えてください！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3200</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2604</PointerOffset>
      <JapaneseText>お願いします、クラースさん！</JapaneseText>
      <EnglishText/>
      <Notes/>
