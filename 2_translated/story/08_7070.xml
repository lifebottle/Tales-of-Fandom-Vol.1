<SceneText>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <PointerOffset/>
      <JapaneseText>クラース・Ｆ・レスター</JapaneseText>
      <EnglishText>Claus F. Lester</EnglishText>
      <Notes>Reference only</Notes>
      <Id>3500</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset/>
      <JapaneseText>藤林 すず</JapaneseText>
      <EnglishText>Suzu Fujibayashi</EnglishText>
      <Notes>Reference only</Notes>
      <Id>4100</Id>
      <Status>Done</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main Text</Section>
    <Entry>
      <PointerOffset>308</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>572</PointerOffset>
      <JapaneseText>これが『古代ドワーフ語研究序説』。
間違いない、本物だ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>836</PointerOffset>
      <JapaneseText>……悪いな、すずちゃん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1100</PointerOffset>
      <JapaneseText>いえ、よく見たらその本は、
おじいさまのほしいのとは別物でした。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4100</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1364</PointerOffset>
      <JapaneseText>そ、そうか。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1660</PointerOffset>
      <JapaneseText>おや、本から何か落ちましたよ。
しおり……？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4100</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1948</PointerOffset>
      <JapaneseText>おっと……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2404</PointerOffset>
      <JapaneseText>すずちゃん、帰ろう。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2692</PointerOffset>
      <JapaneseText>本は買わないのですか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>4100</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2956</PointerOffset>
      <JapaneseText>ああ。必要なくなった。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3220</PointerOffset>
      <JapaneseText>もういい。もういいんだ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>3500</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
