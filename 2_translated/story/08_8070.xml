    <Entry>
      <PointerOffset>420</PointerOffset>
      <JapaneseText>　</JapaneseText>
      <EnglishText>　</EnglishText>
      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>684</PointerOffset>
      <JapaneseText>……助かった。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>948</PointerOffset>
      <JapaneseText>スキあり！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1388</PointerOffset>
      <JapaneseText>見ちゃうもんね！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1652</PointerOffset>
      <JapaneseText>あああぁぁぁぁぁ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2140</PointerOffset>
      <JapaneseText>食べたいものリスト……ハンバーガー、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2404</PointerOffset>
      <JapaneseText>ステーキ、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2668</PointerOffset>
      <JapaneseText>肉うどん……何コレ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2932</PointerOffset>
      <JapaneseText>あ、あれ？　そっちの便せんか……、
よかった。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3308</PointerOffset>
      <JapaneseText>どうかしましたか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3572</PointerOffset>
      <JapaneseText>こんなモノを、リッドが必死になって
奪おうとするんだもん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3836</PointerOffset>
      <JapaneseText>こんなモノって言うなよ！
日々食欲があるってのはいいコトなんだぜ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4140</PointerOffset>
      <JapaneseText>はいはい。なんか疲れちゃった。	</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4548</PointerOffset>
      <JapaneseText>オレはたくさん肉を食って</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4892</PointerOffset>
      <JapaneseText>大きくなってそしてファラをお嫁さんに。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5180</PointerOffset>
      <JapaneseText>だあああああああ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7316</PointerOffset>
      <JapaneseText>チャット、インフェリアの文字読めんのか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7580</PointerOffset>
      <JapaneseText>キールさんにもらった辞書を頼りに。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>7876</PointerOffset>
      <JapaneseText>こ、この手紙はだな、すっげえ子供の頃
書いたから……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8196</PointerOffset>
      <JapaneseText>いいモノ読ませていただきました。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>600</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8588</PointerOffset>
      <JapaneseText>あ、キャプテン？　キャプテ〜ン！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>8852</PointerOffset>
      <JapaneseText>オレ、何でもしますよー。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
</SceneText>
