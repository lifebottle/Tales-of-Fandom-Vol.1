
<SceneText>
  <FriendlyName>Conversation_0902</FriendlyName>
  <Strings>
    <Section>Speaker</Section>
  </Strings>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <PointerOffset>0x26e59e</PointerOffset>
      <JapaneseText>部長！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e5a5</PointerOffset>
      <JapaneseText>事件報告書の「経費」のところに</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e5c6</PointerOffset>
      <JapaneseText>張り込みのときのコーヒー代も</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e5e3</PointerOffset>
      <JapaneseText>入れていいんですか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e5fb</PointerOffset>
      <JapaneseText>プリムラ部長〜！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e60c</PointerOffset>
      <JapaneseText>容疑者の尾行に失敗しましたぁ〜！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e62e</PointerOffset>
      <JapaneseText>ごめんなさい〜！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e642</PointerOffset>
      <JapaneseText>――噂を聞きつけてきた新入部員たちで</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e667</PointerOffset>
      <JapaneseText>我が探偵部は大騒ぎ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e67c</PointerOffset>
      <JapaneseText>部長も楽じゃありません。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e69a</PointerOffset>
      <JapaneseText>やあ、忙しそうだね、子猫ちゃん。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e6bb</PointerOffset>
      <JapaneseText>あ、ダーリン！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e6ca</PointerOffset>
      <JapaneseText>もうちょっとで仕事終わるから待っててね！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e6f3</PointerOffset>
      <JapaneseText>待ちきれないよ、子猫ちゃん！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e710</PointerOffset>
      <JapaneseText>ああ、君が隣にいない時間の孤独さよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e736</PointerOffset>
      <JapaneseText>心臓は鼓動をとめ、太陽さえも輝きを</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e759</PointerOffset>
      <JapaneseText>失い色あせる……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e76f</PointerOffset>
      <JapaneseText>やれやれ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e77e</PointerOffset>
      <JapaneseText>プリムラさん、事件です！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e799</PointerOffset>
      <JapaneseText>あー、ゴメン。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e7a8</PointerOffset>
      <JapaneseText>私このあとキーファとデートだから。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e7cc</PointerOffset>
      <JapaneseText>キール、かわりにやっといて。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>0x26e7eb</PointerOffset>
      <JapaneseText>なんで僕が……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
