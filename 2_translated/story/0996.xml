    <Entry>
      <PointerOffset>2834507</PointerOffset>
      <JapaneseText>さてさて、気になる勝敗の結果は？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2834541</PointerOffset>
      <JapaneseText>なんと、フォッグ・すず組の圧勝でした！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2834581</PointerOffset>
      <JapaneseText>え？　ビリはどこだって？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2834606</PointerOffset>
      <JapaneseText>んなの、決まってんじゃん！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2834633</PointerOffset>
      <JapaneseText>おまえのせいだぞ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2834655</PointerOffset>
      <JapaneseText>はいはい。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2834670</PointerOffset>
      <JapaneseText>ぼくの理論通りならぜったい勝ってた。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2834708</PointerOffset>
      <JapaneseText>そうだな。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2834723</PointerOffset>
      <JapaneseText>おまえ、ぼくをバカにしてるだろ！？</JapaneseText>
      <EnglishText> </EnglishText>
