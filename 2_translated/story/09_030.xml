    <Entry>
      <PointerOffset>764</PointerOffset>
      <JapaneseText>ワイール！　あのな、リッドなっ、
ファラのことなっ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1020</PointerOffset>
      <JapaneseText>なっ、何を言い出すんだ、
突然っ……！　ぼくは、そんなっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1364</PointerOffset>
      <JapaneseText>ん？　どうしたの？　リッド？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1580</PointerOffset>
      <JapaneseText>ったく……、
何言ってんだよ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1796</PointerOffset>
      <JapaneseText>あのなっ、あのなっ……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2012</PointerOffset>
      <JapaneseText>もー……リッドったら、
ちょっと落ちつかなきゃダメだよ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>300</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2228</PointerOffset>
      <JapaneseText>そっ、そうだぞっ……、
ぼくもまだ心の準備が……っ</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2444</PointerOffset>
      <JapaneseText>はぁ……、
オマエも落ちつけって……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2660</PointerOffset>
      <JapaneseText>あのなっ、ん〜となっ☆</JapaneseText>
