      <SpeakerId>200</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>980</PointerOffset>
      <JapaneseText>メルディいっちば〜ん！！</JapaneseText>
