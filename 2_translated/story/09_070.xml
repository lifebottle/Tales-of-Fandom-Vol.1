      <Notes>Single JP space line</Notes>
      <Id>0</Id>
      <Status>Done</Status>
    </Entry>
    <Entry>
      <PointerOffset>652</PointerOffset>
      <JapaneseText>ファラー、
「週刊エターニア」買ってきたよ〜。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>868</PointerOffset>
      <JapaneseText>読もう読もう！
えっと、今週の特集は……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1084</PointerOffset>
      <JapaneseText>「必勝！　告白テク！」</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1300</PointerOffset>
      <JapaneseText>なになに？　まず相手に、</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1372</PointerOffset>
      <JapaneseText>「英語の単語で、どうしても
わからないのがあるの。教えてくれる？」</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1588</PointerOffset>
      <JapaneseText>「スペルはね、
Ｌ・Ｏ・Ｖ・Ｅ！」………………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>1804</PointerOffset>
      <JapaneseText>うわー！　はずかしー！
こんなのムリだよねえ。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2020</PointerOffset>
      <JapaneseText>レッツトラ〜イ！
おーいリッド〜！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>8</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2420</PointerOffset>
      <JapaneseText>ちょっとメルディ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>9</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2636</PointerOffset>
      <JapaneseText>メルディ、クサバの陰からみまもってるな！
がんばるよ〜、ファラ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>10</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2996</PointerOffset>
      <JapaneseText>おっ、呼んだか？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>11</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3164</PointerOffset>
      <JapaneseText>『こうなりゃヤケよ！
うん、イケる！』</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>12</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3380</PointerOffset>
      <JapaneseText>リッド！　どうしても
解らない単語があるの！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>13</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3596</PointerOffset>
      <JapaneseText>スペルはね、
エ、エル……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>14</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3812</PointerOffset>
      <JapaneseText>オ、オー……。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>15</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3980</PointerOffset>
      <JapaneseText>………………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>16</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4292</PointerOffset>
      <JapaneseText>がんばるよ、ファラ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>17</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4556</PointerOffset>
      <JapaneseText>…………、
ブ、ブイ、イー！！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>18</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>4820</PointerOffset>
      <JapaneseText>やたっ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>400</SpeakerId>
      <Id>19</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5084</PointerOffset>
      <JapaneseText>はあ、はあ、はあ
……い、言ったわよ！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>20</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5252</PointerOffset>
      <JapaneseText>………………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>21</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5372</PointerOffset>
      <JapaneseText>………………。</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>22</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5540</PointerOffset>
      <JapaneseText>…………ロベ？</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>100</SpeakerId>
      <Id>23</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>5756</PointerOffset>
      <JapaneseText>ちっがーう！</JapaneseText>
      <EnglishText/>
      <Notes/>
      <SpeakerId>200</SpeakerId>
      <Id>24</Id>
      <Status>To Do</Status>
    </Entry>
  </Strings>
