    <Entry>
      <PointerOffset>2945006</PointerOffset>
      <JapaneseText>村祭り、いっしょに行かない？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2945035</PointerOffset>
      <JapaneseText>……あ……は、はい！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2945056</PointerOffset>
      <JapaneseText>はぁーん、そういうわけか。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2945083</PointerOffset>
      <JapaneseText>ミントが自分からねぇ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2945106</PointerOffset>
      <JapaneseText>クレス、驚いただろ？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2945127</PointerOffset>
      <JapaneseText>うん、びっくりしたよ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2945150</PointerOffset>
      <JapaneseText>まさかミントが</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2945165</PointerOffset>
      <JapaneseText>……自分から修行を始めるなんてさ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2945200</PointerOffset>
      <JapaneseText>おつかれさまでした。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
