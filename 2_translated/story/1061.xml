      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>2999644</PointerOffset>
      <JapaneseText>無理言わないで！</JapaneseText>
