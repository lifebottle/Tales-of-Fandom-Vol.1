    </Entry>
    <Entry>
      <PointerOffset>3003598</PointerOffset>
      <JapaneseText>劇の役者が不足しているの。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3003625</PointerOffset>
      <JapaneseText>手伝ってくれない？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3003644</PointerOffset>
