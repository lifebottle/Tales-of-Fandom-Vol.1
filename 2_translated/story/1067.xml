      <Notes> </Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3003688</PointerOffset>
      <JapaneseText>おぅ？　アレだぞ、アレ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3003713</PointerOffset>
      <JapaneseText>主役じゃなきゃやらんぞぅ。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3003740</PointerOffset>
      <JapaneseText>無理言わないで！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>7</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3003757</PointerOffset>
      <JapaneseText>おぅ！　なぜ無理なんだぁ！</JapaneseText>
