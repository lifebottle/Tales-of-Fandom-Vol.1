      <Notes> </Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3011806</PointerOffset>
      <JapaneseText>そんな言い方ってないじゃない！</JapaneseText>
