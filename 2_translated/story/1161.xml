      <JapaneseText>すずちゃん、その本は？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>0</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3156147</PointerOffset>
      <JapaneseText>おじいさまに、</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>1</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3156162</PointerOffset>
      <JapaneseText>買ってくるように言われたのです。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3156195</PointerOffset>
      <JapaneseText>頼む、わたしにそれを譲ってくれ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3156228</PointerOffset>
      <JapaneseText>それはできかねます。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3156249</PointerOffset>
      <JapaneseText>いいつけにそむくことになりますから。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3156286</PointerOffset>
      <JapaneseText>わたしにはその本が必要なんだ！</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>6</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3156317</PointerOffset>
      <JapaneseText>なるほど。ならば勝負ですね。</JapaneseText>
      <EnglishText> </EnglishText>
