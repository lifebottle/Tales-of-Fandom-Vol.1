      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3300613</PointerOffset>
      <JapaneseText>どうしたんだメルディ？</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>2</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3300636</PointerOffset>
      <JapaneseText>メルディ、この頃いっぱいご飯食べてたら</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>3</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3300675</PointerOffset>
      <JapaneseText>体重増えちゃったよ……。</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>4</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3300700</PointerOffset>
      <JapaneseText>ダイエットしたほうが</JapaneseText>
      <EnglishText> </EnglishText>
      <Notes> </Notes>
      <Id>5</Id>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <PointerOffset>3300721</PointerOffset>
      <JapaneseText>良いと思うか？</JapaneseText>
